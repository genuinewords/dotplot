            <div class="dataset-box"><strong>Data (${ctx.unit}):</strong> ${data.join(", ")}</div>
            ${workAreaSVG}
            <div class="answer-prompts-grid">${answerPrompts}</div>
          </div>
        `;

        // Build answer key item
        let keySolutionSVG = "";
        if (topic === "dot-plot") keySolutionSVG = generateDotPlotSVG(data, true);
        else if (topic === "histogram") keySolutionSVG = generateHistogramSVG(data, true);
        else if (topic === "box-plot") keySolutionSVG = generateBoxPlotSVG(stats, true);
        else if (topic === "stem-and-leaf") keySolutionSVG = generateStemAndLeafHTML(data, true);

        answersHTML += `
          <div class="key-item">
            <div class="key-item-title">Question ${i} Solution (${ctx.title})</div>
            <div style="font-size: 0.85rem; color: #4b5563; margin-bottom: 0.5rem;">
              <strong>Sorted Data:</strong> ${stats.sorted.join(", ")}
            </div>
            <div style="margin: 0.75rem 0; padding: 0.5rem; background: #f9fafb; border: 1px solid #e5e7eb; border-radius: 6px;">
              ${keySolutionSVG}
            </div>
            <div class="key-stats-list">
              <div>Mean: <span class="key-stat-val">${stats.mean}</span></div>
              <div>Median: <span class="key-stat-val">${stats.median}</span></div>
              <div>Mode: <span class="key-stat-val">${stats.mode}</span></div>
              <div>Range: <span class="key-stat-val">${stats.range}</span> (Min: ${stats.min}, Max: ${stats.max})</div>
              <div>Q1: <span class="key-stat-val">${stats.q1}</span> | Q3: <span class="key-stat-val">${stats.q3}</span></div>
              <div>IQR: <span class="key-stat-val">${stats.iqr}</span></div>
              <div>Fences: <span class="key-stat-val">[${stats.lowerFence}, ${stats.upperFence}]</span></div>
              <div>Outlier(s): <span class="key-stat-val">${stats.outliers}</span></div>
              <div>Distribution Shape: <span class="key-stat-val">${stats.shape}</span></div>
            </div>
          </div>
        `;
      }

      questionsContainer.innerHTML = questionsHTML;
      answersContainer.innerHTML = answersHTML;
    }

    // Event listeners
    generateBtn.addEventListener("click", generateWorksheet);
    gradeSelect.addEventListener("change", generateWorksheet);
    countSelect.addEventListener("change", generateWorksheet);

    randomSeedBtn.addEventListener("click", () => {
      seedInput.value = Math.floor(100000 + Math.random() * 900000).toString();
      generateWorksheet();
    });

    seedInput.addEventListener("change", generateWorksheet);

    // Print button
    printWorksheetBtn.addEventListener("click", () => {
      window.print();
    });

    // Answer Key toggle logic with Email Gate
    function toggleKeyVisibility() {
      const isVisible = answerKeyPaper.style.display !== "none";
      if (isVisible) {
        answerKeyPaper.style.display = "none";
        keyBtnText.textContent = "Reveal Answer Key";
      } else {
        answerKeyPaper.style.display = "block";
        keyBtnText.textContent = "Hide Answer Key";
        // Scroll to answer key
        answerKeyPaper.scrollIntoView({ behavior: "smooth" });
      }
    }

    toggleAnswerKeyBtn.addEventListener("click", () => {
      if (getUnlocked()) {
        toggleKeyVisibility();
      } else {
        emailModal.style.display = "flex";
        emailInput.focus();
      }
    });

    modalCloseBtn.addEventListener("click", () => {
      emailModal.style.display = "none";
    });

    emailModal.addEventListener("click", (e) => {
      if (e.target === emailModal) {
        emailModal.style.display = "none";
      }
    });

    emailForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();
      if (email && email.includes("@")) {
        setUnlocked(true);
        emailModal.style.display = "none";
        toggleKeyVisibility();
      }
    });

    // Initial generation
    generateWorksheet();
  });
</script>
