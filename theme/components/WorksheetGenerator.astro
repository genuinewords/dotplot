---
interface Props {
  topic: 'dot-plot' | 'histogram' | 'box-plot' | 'stem-and-leaf';
  title: string;
  toolUrl: string;
  toolName: string;
}

const { topic, title, toolUrl, toolName } = Astro.props;
---

<div class="worksheet-generator-container" data-topic={topic} data-tool-url={toolUrl} data-tool-name={toolName}>
  <!-- Controls Panel (Hidden in Print) -->
  <div class="generator-controls glass-card">
    <div class="controls-header">
      <span class="badge">Interactive Generator</span>
      <h2 class="controls-title">{title}</h2>
      <p class="controls-desc">Customize grade level and question count, or enter a saved seed to regenerate an identical classroom assignment.</p>
    </div>

    <div class="controls-grid">
      <!-- Difficulty Select -->
      <div class="control-group">
        <label for="grade-select" class="control-label">Grade Level / Difficulty</label>
        <select id="grade-select" class="control-select">
          <option value="grade6" selected>Grade 6 (Basics & Measures of Center)</option>
          <option value="grade78">Grade 7–8 (Spread & Comparisons)</option>
          <option value="apstats">AP Statistics (SOCS, 1.5×IQR & Outliers)</option>
        </select>
      </div>

      <!-- Question Count -->
      <div class="control-group">
        <label for="count-select" class="control-label">Number of Questions</label>
        <select id="count-select" class="control-select">
          <option value="5" selected>5 Questions (Standard Worksheet)</option>
          <option value="10">10 Questions (Double Sided)</option>
          <option value="15">15 Questions (Unit Review Test)</option>
        </select>
      </div>

      <!-- Seed Input -->
      <div class="control-group">
        <label for="seed-input" class="control-label">Worksheet Seed #</label>
        <div class="seed-input-wrapper">
          <input type="number" id="seed-input" class="control-input" placeholder="Random seed" min="100000" max="999999" />
          <button type="button" id="random-seed-btn" class="btn-icon" title="Generate New Seed">🎲</button>
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="controls-actions">
      <div class="primary-actions">
        <button type="button" id="generate-btn" class="btn-primary">
          <span>⚡ Generate Worksheet</span>
        </button>
        <button type="button" id="print-worksheet-btn" class="btn-secondary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
          <span>Print / Save as PDF</span>
        </button>
      </div>
      <div class="secondary-actions">
        <button type="button" id="toggle-answer-key-btn" class="btn-outline-key">
          <span class="key-icon">🔑</span>
          <span id="key-btn-text">Reveal Answer Key</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Printable Worksheet Container -->
  <div class="worksheet-paper-wrapper" id="worksheet-paper-wrapper">
    <div class="worksheet-paper" id="worksheet-paper">
      <!-- Printable Page Header -->
      <div class="paper-header">
        <div class="header-student-fields">
          <div class="student-field"><span>Name:</span> <span class="field-line"></span></div>
          <div class="student-field"><span>Date:</span> <span class="field-line short"></span></div>
          <div class="student-field"><span>Period:</span> <span class="field-line short"></span></div>
        </div>
        <div class="header-title-row">
          <h1 class="paper-title" id="paper-title">Dot Plot Practice Worksheet</h1>
          <div class="paper-meta">
            <span id="paper-grade-badge">Grade 6</span>
            <span id="paper-seed-badge">Seed: #123456</span>
            <span class="paper-brand">DotPlotMaker.com</span>
          </div>
        </div>
        <p class="paper-instructions" id="paper-instructions">
          Directions: Read each real-world context carefully. Graph the dataset on the grid provided, then show all mathematical calculations to answer the questions in the space provided.
        </p>
      </div>

      <!-- Questions List (Generated by JS) -->
      <div class="questions-container" id="questions-container">
        <!-- Rendered by client JS -->
      </div>

      <!-- Printable Footer -->
      <div class="paper-footer">
        <span>Free educational worksheet generated at <strong style="color: #000;">DotPlotMaker.com</strong> — Check your graphs interactively online.</span>
      </div>
    </div>

    <!-- Separate Answer Key Section (Toggleable & Printable) -->
    <div class="answer-key-paper" id="answer-key-paper" style="display: none;">
      <div class="paper-header answer-key-header">
        <div class="header-title-row">
          <h2 class="paper-title" style="color: #0d1117;" id="answer-key-title">Teacher Answer Key & Full Solutions</h2>
          <div class="paper-meta">
            <span class="badge" style="background: #ef444422; color: #b91c1c; border-color: #ef444455;">OFFICIAL ANSWER KEY</span>
            <span id="key-seed-badge">Seed: #123456</span>
            <span class="paper-brand">DotPlotMaker.com</span>
          </div>
        </div>
        <p class="paper-instructions">
          All solutions computed live from the current seeded dataset. Includes exact numerical statistics and verified visual chart solutions.
        </p>
      </div>

      <div class="answers-container" id="answers-container">
        <!-- Answer keys rendered here -->
      </div>
    </div>
  </div>

  <!-- Email Gate Modal for Answer Key -->
  <div class="email-modal-backdrop" id="email-modal-backdrop" style="display: none;">
    <div class="email-modal glass-card">
      <button type="button" class="modal-close-btn" id="modal-close-btn" aria-label="Close dialog">&times;</button>
      <div class="modal-badge-wrapper">
        <span class="modal-badge">Teacher & Student Resource</span>
      </div>
      <h3 class="modal-title">Unlock Complete Answer Keys</h3>
      <p class="modal-desc">
        Enter your email address to instantly reveal live-computed answer keys, step-by-step numerical solutions, and correct graph diagrams for all 4 statistics worksheet topics for this session.
      </p>

      <form id="email-unlock-form" class="modal-form">
        <div class="modal-input-group">
          <input type="email" id="unlock-email-input" class="modal-input" placeholder="teacher@school.edu" required />
        </div>
        <label class="modal-checkbox-label">
          <input type="checkbox" id="newsletter-opt-in" checked />
          <span>Send free printable classroom statistics worksheets and lesson plans (optional)</span>
        </label>
        <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; margin-top: 1rem;">
          <span>Unlock Answer Keys Now →</span>
        </button>
      </form>
      <p class="modal-footer-note">
        🔒 Student worksheets remain 100% free to print anytime without entering an email. We respect your privacy.
      </p>
    </div>
  </div>
</div>

<style>
  /* ════════════════════════════════════════════════════════════════
     GENERATOR SCREEN STYLES
     ════════════════════════════════════════════════════════════════ */
  .worksheet-generator-container {
    margin: 2rem 0 3.5rem;
  }

  .generator-controls {
    padding: 2rem;
    border-radius: 16px;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    margin-bottom: 2.5rem;
  }

  .controls-header {
    margin-bottom: 1.5rem;
  }

  .controls-title {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0.5rem 0 0.25rem;
    color: var(--color-text-primary);
  }

  .controls-desc {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .controls-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .control-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .control-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .control-select, .control-input {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    padding: 0.75rem 1rem;
    border-radius: 10px;
    font-size: 0.95rem;
    font-family: var(--font-sans);
    outline: none;
    transition: all 0.2s ease;
  }

  .control-select:focus, .control-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(0, 212, 170, 0.2);
  }

  .control-select option {
    background: #12122a;
    color: #f0f0f5;
  }

  .seed-input-wrapper {
    display: flex;
    gap: 0.5rem;
  }

  .seed-input-wrapper input {
    flex: 1;
  }

  .btn-icon {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    font-size: 1.2rem;
    padding: 0 1rem;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-icon:hover {
    background: rgba(0, 212, 170, 0.15);
    border-color: var(--color-primary);
  }

  .controls-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .primary-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-outline-key {
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.4);
    color: #fbbf24;
    padding: 0.75rem 1.25rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.92rem;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.2s ease;
  }

  .btn-outline-key:hover {
    background: rgba(245, 158, 11, 0.2);
    border-color: #f59e0b;
    transform: translateY(-2px);
  }

  /* ════════════════════════════════════════════════════════════════
     PAPER PREVIEW (ON SCREEN)
     ════════════════════════════════════════════════════════════════ */
  .worksheet-paper-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .worksheet-paper, .answer-key-paper {
    background: #ffffff;
    color: #111827;
    border-radius: 12px;
    padding: 2.5rem 3rem;
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    max-width: 900px;
    margin: 0 auto;
    width: 100%;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }

  .answer-key-paper {
    background: #fafafa;
    border: 2px dashed #f59e0b;
  }

  .paper-header {
    border-bottom: 2px solid #111827;
    padding-bottom: 1.25rem;
    margin-bottom: 2rem;
  }

  .header-student-fields {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.25rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: #374151;
  }

  .student-field {
    display: flex;
    align-items: flex-end;
    gap: 0.4rem;
    flex: 1;
  }

  .field-line {
    border-bottom: 1px solid #4b5563;
    flex: 1;
    height: 18px;
    display: inline-block;
  }

  .field-line.short {
    max-width: 130px;
  }

  .header-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .paper-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: #111827;
    margin: 0;
  }

  .paper-meta {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .paper-meta span {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-weight: 600;
    background: #e5e7eb;
    color: #374151;
  }

  .paper-meta .paper-brand {
    background: #111827;
    color: #ffffff;
  }

  .paper-instructions {
    font-size: 0.9rem;
    color: #4b5563;
    line-height: 1.4;
    margin: 0.5rem 0 0;
    font-style: italic;
  }

  /* Question Card */
  .question-item {
    padding: 1.75rem 0;
    border-bottom: 1px dashed #d1d5db;
    page-break-inside: avoid;
    break-inside: avoid;
  }

  .question-item:last-child {
    border-bottom: none;
  }

  .question-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.6rem;
  }

  .question-number {
    font-size: 1.15rem;
    font-weight: 700;
    color: #111827;
  }

  .question-context {
    font-size: 0.9rem;
    font-weight: 600;
    color: #4b5563;
  }

  .question-prompt {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #1f2937;
    margin-bottom: 0.75rem;
  }

  .dataset-box {
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 6px;
    padding: 0.6rem 1rem;
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.92rem;
    color: #111827;
    margin-bottom: 1.25rem;
    letter-spacing: 0.03em;
  }

  .graph-work-area {
    margin: 1.25rem 0;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    padding: 1rem;
    background: #ffffff;
    min-height: 160px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .answer-prompts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .answer-prompt-line {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: #374151;
  }

  .answer-prompt-line span {
    font-weight: 600;
  }

  .answer-blank {
    border-bottom: 1px solid #4b5563;
    flex: 1;
    height: 18px;
    display: inline-block;
  }

  .paper-footer {
    border-top: 1px solid #e5e7eb;
    margin-top: 2rem;
    padding-top: 1rem;
    text-align: center;
    font-size: 0.8rem;
    color: #6b7280;
  }

  /* Answer Key Solution Cards */
  .key-item {
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    page-break-inside: avoid;
    break-inside: avoid;
  }

  .key-item-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.5rem;
  }

  .key-stats-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.5rem 1rem;
    margin-top: 0.75rem;
    font-size: 0.88rem;
    color: #374151;
  }

  .key-stat-val {
    font-weight: 700;
    color: #059669;
  }

  /* ════════════════════════════════════════════════════════════════
     EMAIL GATE MODAL
     ════════════════════════════════════════════════════════════════ */
  .email-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 999;
    background: rgba(10, 10, 26, 0.75);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .email-modal {
    background: #12122a;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    max-width: 480px;
    width: 100%;
    padding: 2.25rem;
    position: relative;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    animation: modalIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalIn {
    from { opacity: 0; transform: scale(0.95) translateY(10px); }
    to { opacity: 1; transform: scale(1) translateY(0); }
  }

  .modal-close-btn {
    position: absolute;
    top: 1rem;
    right: 1.25rem;
    background: none;
    border: none;
    font-size: 1.75rem;
    color: var(--color-text-muted);
    cursor: pointer;
    line-height: 1;
  }

  .modal-close-btn:hover {
    color: var(--color-text-primary);
  }

  .modal-badge {
    background: rgba(0, 212, 170, 0.1);
    color: var(--color-primary);
    border: 1px solid rgba(0, 212, 170, 0.3);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 0.75rem;
  }

  .modal-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-text-primary);
    margin: 0 0 0.5rem;
  }

  .modal-desc {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0 0 1.5rem;
  }

  .modal-input {
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    padding: 0.85rem 1rem;
    border-radius: 12px;
    font-size: 1rem;
    outline: none;
  }

  .modal-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(0, 212, 170, 0.2);
  }

  .modal-checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 1rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .modal-footer-note {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin: 1.25rem 0 0;
    text-align: center;
    line-height: 1.4;
  }

  /* ════════════════════════════════════════════════════════════════
     CLEAN PRINT CSS (US Letter + A4)
     ════════════════════════════════════════════════════════════════ */
  @media print {
    @page {
      margin: 0.45in 0.5in;
      size: letter portrait;
    }

    body {
      background: #ffffff !important;
      color: #000000 !important;
      font-size: 10pt;
    }

    /* Hide EVERYTHING non-printable */
    .site-header,
    .site-footer,
    .generator-controls,
    .email-modal-backdrop,
    .static-seo-content,
    .ad-unit,
    .dot-bg,
    .glow,
    .post-back,
    #site-header {
      display: none !important;
    }

    .worksheet-generator-container {
      margin: 0 !important;
    }

    .worksheet-paper-wrapper {
      display: block !important;
    }

    .worksheet-paper, .answer-key-paper {
      background: #ffffff !important;
      color: #000000 !important;
      box-shadow: none !important;
      border: none !important;
      padding: 0 !important;
      margin: 0 !important;
      max-width: 100% !important;
    }

    .paper-header {
      border-bottom: 2pt solid #000000 !important;
    }

    .header-student-fields span {
      color: #000000 !important;
    }

    .field-line {
      border-bottom: 1pt solid #000000 !important;
    }

    .paper-title {
      color: #000000 !important;
      font-size: 16pt !important;
    }

    .paper-meta span {
      background: #eeeeee !important;
      color: #000000 !important;
      border: 0.5pt solid #cccccc !important;
    }

    .paper-meta .paper-brand {
      background: #000000 !important;
      color: #ffffff !important;
    }

    .dataset-box {
      background: #f7f7f7 !important;
      border: 1pt solid #cccccc !important;
      color: #000000 !important;
    }

    .graph-work-area {
      border: 1pt solid #888888 !important;
      background: #ffffff !important;
    }

    .question-item, .key-item {
      page-break-inside: avoid !important;
      break-inside: avoid !important;
      border-bottom: 1pt dashed #888888 !important;
      padding: 12pt 0 !important;
    }

    .answer-blank {
      border-bottom: 1pt solid #000000 !important;
    }

    .paper-footer {
      border-top: 1pt solid #cccccc !important;
      color: #555555 !important;
    }

    /* Print SVG optimization */
    svg {
      max-width: 100% !important;
    }
  }

  @media (max-width: 768px) {
    .worksheet-paper, .answer-key-paper {
      padding: 1.5rem 1rem;
    }
    .header-student-fields {
      flex-direction: column;
      gap: 0.75rem;
    }
    .controls-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .primary-actions {
      flex-direction: column;
    }
  }
</style>

<script>
  // ════════════════════════════════════════════════════════════════
  // SEEDED RANDOM GENERATOR (mulberry32)
  // ════════════════════════════════════════════════════════════════
  function mulberry32(a: number) {
    return function() {
      let t = a += 0x6D2B79F5;
      t = Math.imul(t ^ (t >>> 15), t | 1);
      t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }

  function getRandomInt(rng: () => number, min: number, max: number) {
    return Math.floor(rng() * (max - min + 1)) + min;
  }

  // Real world contexts
  const CONTEXTS = [
    { title: "Daily High Temperatures (°F)", unit: "°F", minG6: 62, maxG6: 78, minAP: 50, maxAP: 95 },
    { title: "Number of Books Read This Year", unit: "books", minG6: 1, maxG6: 14, minAP: 0, maxAP: 35 },
    { title: "Math Quiz Scores (out of 20)", unit: "pts", minG6: 11, maxG6: 20, minAP: 5, maxAP: 20 },
    { title: "Weekly Screen Time (Hours)", unit: "hours", minG6: 8, maxG6: 24, minAP: 4, maxAP: 45 },
    { title: "Soccer Goals Scored in Season", unit: "goals", minG6: 0, maxG6: 8, minAP: 0, maxAP: 15 },
    { title: "Commute Times to School (Minutes)", unit: "mins", minG6: 5, maxG6: 35, minAP: 5, maxAP: 60 },
    { title: "Number of Pets per Household", unit: "pets", minG6: 0, maxG6: 5, minAP: 0, maxAP: 9 },
    { title: "Typing Speed (Words per Minute)", unit: "wpm", minG6: 25, maxG6: 65, minAP: 20, maxAP: 95 },
    { title: "Push-ups Completed in 1 Minute", unit: "reps", minG6: 10, maxG6: 35, minAP: 5, maxAP: 55 },
    { title: "Shoe Sizes (US Men's/Women's)", unit: "size", minG6: 6, maxG6: 12, minAP: 5, maxAP: 14 },
    { title: "Cell Phone Battery Life (Hours)", unit: "hrs", minG6: 8, maxG6: 18, minAP: 4, maxAP: 26 },
    { title: "Hours Slept Last Night", unit: "hrs", minG6: 5, maxG6: 10, minAP: 4, maxAP: 11 },
    { title: "Reaction Times (Milliseconds/10)", unit: "cs", minG6: 20, maxG6: 45, minAP: 15, maxAP: 60 },
    { title: "Concert Ticket Prices ($)", unit: "$", minG6: 30, maxG6: 80, minAP: 25, maxAP: 150 },
    { title: "Distance Traveled on Weekend (Miles)", unit: "miles", minG6: 2, maxG6: 25, minAP: 0, maxAP: 75 },
  ];

  // Mathematical statistical calculations
  function calculateStats(data: number[]) {
    const sorted = [...data].sort((a, b) => a - b);
    const n = sorted.length;
    const sum = sorted.reduce((acc, v) => acc + v, 0);
    const mean = Math.round((sum / n) * 10) / 10;
    
    // Median
    const mid = Math.floor(n / 2);
    const median = n % 2 === 0 ? Math.round(((sorted[mid - 1] + sorted[mid]) / 2) * 10) / 10 : sorted[mid];

    // Mode
    const freq: Record<number, number> = {};
    let maxFreq = 0;
    sorted.forEach(v => {
      freq[v] = (freq[v] || 0) + 1;
      if (freq[v] > maxFreq) maxFreq = freq[v];
    });
    const modes = Object.keys(freq).filter(k => freq[Number(k)] === maxFreq && maxFreq > 1).map(Number);
    const modeStr = modes.length === 0 ? "None" : modes.join(", ");

    // Range
    const min = sorted[0];
    const max = sorted[n - 1];
    const range = max - min;

    // Quartiles (Tukey/halves standard)
    const lowerHalf = n % 2 === 0 ? sorted.slice(0, mid) : sorted.slice(0, mid);
    const upperHalf = n % 2 === 0 ? sorted.slice(mid) : sorted.slice(mid + 1);

    const calcMed = (arr: number[]) => {
      const len = arr.length;
      if (len === 0) return 0;
      const m = Math.floor(len / 2);
      return len % 2 === 0 ? Math.round(((arr[m - 1] + arr[m]) / 2) * 10) / 10 : arr[m];
    };

    const q1 = calcMed(lowerHalf);
    const q3 = calcMed(upperHalf);
    const iqr = Math.round((q3 - q1) * 10) / 10;
    const lowerFence = Math.round((q1 - 1.5 * iqr) * 10) / 10;
    const upperFence = Math.round((q3 + 1.5 * iqr) * 10) / 10;
    const outliers = sorted.filter(x => x < lowerFence || x > upperFence);

    // Shape description
    let shape = "Approximately Symmetric";
    if (mean > median + 0.8) shape = "Skewed Right (Mean > Median)";
    else if (mean < median - 0.8) shape = "Skewed Left (Mean < Median)";

    return {
      sorted,
      n,
      mean,
      median,
      mode: modeStr,
      min,
      max,
      range,
      q1,
      q3,
      iqr,
      lowerFence,
      upperFence,
      outliers: outliers.length > 0 ? outliers.join(", ") : "None",
      shape
    };
  }

  // ════════════════════════════════════════════════════════════════
  // SVG GRAPH GENERATORS FOR STUDENT & ANSWER KEY
  // ════════════════════════════════════════════════════════════════
  function generateDotPlotSVG(data: number[], isAnswerKey = false) {
    const minVal = Math.min(...data);
    const maxVal = Math.max(...data);
    const startX = Math.max(0, minVal - 1);
    const endX = maxVal + 1;
    const range = Math.max(1, endX - startX);

    const width = 560;
    const height = 110;
    const padL = 40;
    const padR = 40;
    const plotW = width - padL - padR;
    const axisY = 85;

    let svg = `<svg viewBox="0 0 ${width} ${height}" style="width: 100%; max-width: 560px; height: auto;" xmlns="http://www.w3.org/2000/svg">`;
    // Axis line
    svg += `<line x1="${padL - 10}" y1="${axisY}" x2="${width - padR + 10}" y2="${axisY}" stroke="#111827" stroke-width="2" />`;
    // Arrows
    svg += `<polygon points="${padL - 15},${axisY} ${padL - 9},${axisY - 4} ${padL - 9},${axisY + 4}" fill="#111827" />`;
    svg += `<polygon points="${width - padR + 15},${axisY} ${width - padR + 9},${axisY - 4} ${width - padR + 9},${axisY + 4}" fill="#111827" />`;

    // Ticks & Labels
    const step = range > 20 ? Math.ceil(range / 15) : 1;
    for (let v = startX; v <= endX; v += step) {
      const x = padL + ((v - startX) / range) * plotW;
      svg += `<line x1="${x}" y1="${axisY - 4}" x2="${x}" y2="${axisY + 4}" stroke="#111827" stroke-width="1.5" />`;
      svg += `<text x="${x}" y="${axisY + 18}" font-family="sans-serif" font-size="10" font-weight="600" text-anchor="middle" fill="#374151">${v}</text>`;
    }

    // If answer key, draw stacked dots
    if (isAnswerKey) {
      const counts: Record<number, number> = {};
      data.forEach(v => {
        counts[v] = (counts[v] || 0) + 1;
        const stackIndex = counts[v];
        const x = padL + ((v - startX) / range) * plotW;
        const y = axisY - (stackIndex * 12) + 2;
        svg += `<circle cx="${x}" cy="${y}" r="4.5" fill="#00d4aa" stroke="#065f46" stroke-width="1.5" />`;
      });
    }

    svg += `</svg>`;
    return svg;
  }

  function generateHistogramSVG(data: number[], isAnswerKey = false) {
    const minVal = Math.min(...data);
    const maxVal = Math.max(...data);
    const numBins = 5;
    const rawWidth = (maxVal - minVal) / numBins;
    const binWidth = Math.max(1, Math.ceil(rawWidth));
    const startX = Math.floor(minVal / binWidth) * binWidth;

    const bins: number[] = new Array(numBins).fill(0);
    data.forEach(v => {
      let b = Math.floor((v - startX) / binWidth);
      if (b >= numBins) b = numBins - 1;
      if (b < 0) b = 0;
      bins[b]++;
    });

    const maxCount = Math.max(4, ...bins);
    const width = 560;
    const height = 150;
    const padL = 45;
    const padR = 25;
    const padT = 15;
    const padB = 35;
    const plotW = width - padL - padR;
    const plotH = height - padT - padB;
    const barW = plotW / numBins;

    let svg = `<svg viewBox="0 0 ${width} ${height}" style="width: 100%; max-width: 560px; height: auto;" xmlns="http://www.w3.org/2000/svg">`;
    // Grid lines & Y axis
    for (let f = 0; f <= maxCount; f += Math.ceil(maxCount / 4)) {
      const y = height - padB - (f / maxCount) * plotH;
      svg += `<line x1="${padL}" y1="${y}" x2="${width - padR}" y2="${y}" stroke="#e5e7eb" stroke-width="1" />`;
      svg += `<text x="${padL - 8}" y="${y + 3}" font-family="sans-serif" font-size="9" text-anchor="end" fill="#4b5563">${f}</text>`;
    }

    // Axes
    svg += `<line x1="${padL}" y1="${height - padB}" x2="${width - padR}" y2="${height - padB}" stroke="#111827" stroke-width="2" />`;
    svg += `<line x1="${padL}" y1="${padT}" x2="${padL}" y2="${height - padB}" stroke="#111827" stroke-width="2" />`;

    // Bin labels & bars
    for (let i = 0; i < numBins; i++) {
      const bStart = startX + i * binWidth;
      const bEnd = bStart + binWidth;
      const x = padL + i * barW;

      // X tick mark & label
      svg += `<line x1="${x}" y1="${height - padB}" x2="${x}" y2="${height - padB + 4}" stroke="#111827" stroke-width="1" />`;
      svg += `<text x="${x}" y="${height - padB + 16}" font-family="sans-serif" font-size="9" text-anchor="middle" fill="#374151">${bStart}</text>`;

      if (i === numBins - 1) {
        svg += `<text x="${x + barW}" y="${height - padB + 16}" font-family="sans-serif" font-size="9" text-anchor="middle" fill="#374151">${bEnd}</text>`;
      }

      if (isAnswerKey) {
        const count = bins[i];
        const barH = (count / maxCount) * plotH;
        const barY = height - padB - barH;
        svg += `<rect x="${x}" y="${barY}" width="${barW - 1}" height="${barH}" fill="#3b82f6" stroke="#1d4ed8" stroke-width="1.5" opacity="0.85" />`;
        if (count > 0) {
          svg += `<text x="${x + barW / 2}" y="${barY - 4}" font-family="sans-serif" font-size="9" font-weight="700" text-anchor="middle" fill="#1e3a8a">${count}</text>`;
        }
      }
    }

    svg += `<text x="${padL - 25}" y="${padT + plotH / 2}" font-family="sans-serif" font-size="9" font-weight="700" fill="#374151" transform="rotate(-90 ${padL - 25} ${padT + plotH / 2})" text-anchor="middle">Freq</text>`;
    svg += `</svg>`;
    return svg;
  }

  function generateBoxPlotSVG(stats: ReturnType<typeof calculateStats>, isAnswerKey = false) {
    const minVal = Math.max(0, stats.min - 2);
    const maxVal = stats.max + 2;
    const range = Math.max(1, maxVal - minVal);

    const width = 560;
    const height = 110;
    const padL = 40;
    const padR = 40;
    const plotW = width - padL - padR;
    const axisY = 85;
    const boxY = 25;
    const boxH = 40;

    let svg = `<svg viewBox="0 0 ${width} ${height}" style="width: 100%; max-width: 560px; height: auto;" xmlns="http://www.w3.org/2000/svg">`;
    // Number line
    svg += `<line x1="${padL - 10}" y1="${axisY}" x2="${width - padR + 10}" y2="${axisY}" stroke="#111827" stroke-width="2" />`;
    const step = range > 20 ? Math.ceil(range / 15) : 1;
    for (let v = minVal; v <= maxVal; v += step) {
      const x = padL + ((v - minVal) / range) * plotW;
      svg += `<line x1="${x}" y1="${axisY - 4}" x2="${x}" y2="${axisY + 4}" stroke="#111827" stroke-width="1.5" />`;
      svg += `<text x="${x}" y="${axisY + 18}" font-family="sans-serif" font-size="10" font-weight="600" text-anchor="middle" fill="#374151">${v}</text>`;
    }

    if (isAnswerKey) {
      const getX = (val: number) => padL + ((val - minVal) / range) * plotW;
      const xQ1 = getX(stats.q1);
      const xMed = getX(stats.median);
      const xQ3 = getX(stats.q3);
      const xMin = getX(stats.min);
      const xMax = getX(stats.max);

      // Whisker lines
      svg += `<line x1="${xMin}" y1="${boxY + boxH / 2}" x2="${xQ1}" y2="${boxY + boxH / 2}" stroke="#111827" stroke-width="2" />`;
      svg += `<line x1="${xQ3}" y1="${boxY + boxH / 2}" x2="${xMax}" y2="${boxY + boxH / 2}" stroke="#111827" stroke-width="2" />`;
      // Whisker ends
      svg += `<line x1="${xMin}" y1="${boxY + 8}" x2="${xMin}" y2="${boxY + boxH - 8}" stroke="#111827" stroke-width="2" />`;
      svg += `<line x1="${xMax}" y1="${boxY + 8}" x2="${xMax}" y2="${boxY + boxH - 8}" stroke="#111827" stroke-width="2" />`;
      // Box
      svg += `<rect x="${xQ1}" y="${boxY}" width="${Math.max(1, xQ3 - xQ1)}" height="${boxH}" fill="#8b5cf6" stroke="#5b21b6" stroke-width="2" opacity="0.4" />`;
      // Median line
      svg += `<line x1="${xMed}" y1="${boxY}" x2="${xMed}" y2="${boxY + boxH}" stroke="#5b21b6" stroke-width="3" />`;
    }

    svg += `</svg>`;
    return svg;
  }

  function generateStemAndLeafHTML(data: number[], isAnswerKey = false) {
    const sorted = [...data].sort((a, b) => a - b);
    const stems: Record<number, number[]> = {};

    sorted.forEach(v => {
      const stem = Math.floor(v / 10);
      const leaf = v % 10;
      if (!stems[stem]) stems[stem] = [];
      stems[stem].push(leaf);
    });

    const stemKeys = Object.keys(stems).map(Number).sort((a, b) => a - b);
    const minStem = stemKeys.length > 0 ? stemKeys[0] : 0;
    const maxStem = stemKeys.length > 0 ? stemKeys[stemKeys.length - 1] : 5;

    let html = `<div style="max-width: 320px; margin: 0 auto; font-family: monospace; font-size: 0.95rem;">`;
    html += `<table style="width: 100%; border-collapse: collapse; text-align: left;">`;
    html += `<tr style="border-bottom: 2px solid #111827;"><th style="width: 70px; padding: 4px 10px; border-right: 2px solid #111827;">Stem</th><th style="padding: 4px 10px;">Leaf</th></tr>`;

    for (let s = minStem; s <= maxStem; s++) {
      const leaves = isAnswerKey && stems[s] ? stems[s].join("  ") : "&nbsp;";
      html += `<tr><td style="padding: 4px 10px; font-weight: bold; border-right: 2px solid #111827; text-align: right;">${s}</td><td style="padding: 4px 10px; letter-spacing: 2px;">${leaves}</td></tr>`;
    }

    html += `</table>`;
    if (sorted.length > 0) {
      const sample = sorted[0];
      html += `<div style="margin-top: 8px; font-size: 0.85rem; font-style: italic; color: #4b5563;">Key: ${Math.floor(sample / 10)} | ${sample % 10} = ${sample}</div>`;
    }
    html += `</div>`;
    return html;
  }

