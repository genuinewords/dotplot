    background: rgba(255, 107, 107, 0.18);
    border-color: #ff6b6b;
    color: #ffffff;
  }
  .calc-input-section {
    margin-bottom: 1.5rem;
  }
  .calc-input-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }
  .input-label {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text-primary, #f0f0f5);
  }
  .input-hint {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--color-text-muted, #6b6b8a);
  }
  .count-tag {
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    color: var(--color-primary, #00d4aa);
