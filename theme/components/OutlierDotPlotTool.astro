---
---

<div id="outlier-calculator-widget" class="outlier-calc-container">
  <div class="calc-card">
    <!-- Header -->
    <div class="calc-header">
      <div class="calc-title-group">
        <span class="calc-badge">Free Interactive Tool</span>
        <h2 class="calc-title">Interactive Outlier Calculator</h2>
        <p class="calc-subtitle">
          Detect outliers in seconds using Tukey’s 1.5×IQR rule, extreme 3×IQR rule, or standard Z-scores. 100% client-side with instant formula breakdown.
        </p>
      </div>
      <div class="calc-presets">
        <span class="preset-label">Quick Presets:</span>
        <button type="button" class="preset-btn" data-preset="exam">Exam Scores</button>
        <button type="button" class="preset-btn" data-preset="housing">House Prices ($K)</button>
        <button type="button" class="preset-btn" data-preset="lab">Lab Sensor (mg/L)</button>
        <button type="button" class="preset-btn preset-clear" id="calc-clear-btn">Clear</button>
      </div>
    </div>

    <!-- Input Section -->
    <div class="calc-input-section">
      <div class="calc-input-header">
        <label for="outlier-raw-input" class="input-label">
          Paste Raw Numbers <span class="input-hint">(comma, space, or newline separated)</span>
        </label>
        <span id="calc-count-tag" class="count-tag">0 numbers</span>
      </div>
      <textarea
        id="outlier-raw-input"
        class="calc-textarea"
        rows="4"
        placeholder="e.g. 45, 68, 72, 74, 76, 78, 80, 82, 84, 85, 88, 91, 93, 98, 12, 100"
        aria-label="Enter numbers separated by commas, spaces, or lines"
      ></textarea>
    </div>

    <!-- Method Selection Controls -->
    <div class="calc-controls">
      <div class="method-selector-group">
        <span class="control-label">Detection Method:</span>
        <div class="method-toggles" role="radiogroup" aria-label="Outlier detection method">
          <button type="button" class="method-btn active" data-method="iqr15" role="radio" aria-checked="true">
            <strong>1.5×IQR (Tukey Standard)</strong>
            <span>Inner fences (Q1 − 1.5·IQR, Q3 + 1.5·IQR)</span>
          </button>
          <button type="button" class="method-btn" data-method="iqr30" role="radio" aria-checked="false">
            <strong>3.0×IQR (Extreme Only)</strong>
            <span>Outer fences (Q1 − 3.0·IQR, Q3 + 3.0·IQR)</span>
          </button>
          <button type="button" class="method-btn" data-method="zscore" role="radio" aria-checked="false">
            <strong>Z-Score (|z| &gt; 3)</strong>
            <span>Standardized normal deviations (|z| &gt; 2 suspicious)</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Alert / Validation Msg -->
    <div id="calc-alert" class="calc-alert" style="display: none;"></div>

    <!-- Results Section (Visible when valid data is present) -->
    <div id="calc-results" class="calc-results" style="display: none;">
      <!-- Key Metric Tiles -->
      <div class="metrics-grid">
        <div class="metric-card">
          <span class="metric-label">Sample Size (n)</span>
          <span class="metric-val" id="metric-n">-</span>
          <span class="metric-sub" id="metric-mean-std">Mean: - | SD: -</span>
        </div>
        <div class="metric-card">
          <span class="metric-label">Quartiles (Type 7)</span>
          <span class="metric-val" id="metric-q-summary">-</span>
          <span class="metric-sub" id="metric-median">Median: -</span>
        </div>
        <div class="metric-card">
          <span class="metric-label">Interquartile Range (IQR)</span>
          <span class="metric-val accent" id="metric-iqr">-</span>
          <span class="metric-sub" id="metric-iqr-calc">Q3 − Q1</span>
        </div>
        <div class="metric-card">
          <span class="metric-label">Detection Thresholds</span>
          <span class="metric-val" id="metric-fences-summary">-</span>
          <span class="metric-sub" id="metric-fences-detail">-</span>
        </div>
      </div>

      <!-- Outlier Summary Banner -->
      <div id="outlier-summary-banner" class="summary-banner">
        <div class="banner-icon-col">
          <span id="banner-status-badge" class="badge">Results</span>
        </div>
        <div class="banner-text-col">
          <h3 id="banner-status-headline" class="banner-headline">0 Outliers Detected</h3>
          <p id="banner-status-desc" class="banner-desc">Analyzing distribution boundaries...</p>
        </div>
        <div class="banner-actions">
          <button type="button" class="btn-action-sm" id="btn-copy-outliers">Copy Outliers</button>
          <button type="button" class="btn-action-sm" id="btn-copy-summary">Copy Summary</button>
        </div>
      </div>

      <!-- Visual Strip / Distribution Plot -->
      <div class="visual-panel">
        <div class="visual-header">
          <span class="visual-title">Visual Distribution &amp; Boundary Map</span>
          <div class="visual-legend">
            <span class="legend-item"><span class="dot dot-normal"></span> Normal</span>
            <span class="legend-item"><span class="dot dot-mild"></span> Mild Outlier</span>
            <span class="legend-item"><span class="dot dot-extreme"></span> Extreme Outlier</span>
            <span class="legend-item"><span class="fence-line-sample"></span> Fence Boundary</span>
          </div>
        </div>
        <div class="visual-chart-container" id="visual-chart-container">
          <svg id="visual-chart-svg" viewBox="0 0 860 170" xmlns="http://www.w3.org/2000/svg" aria-label="Visual distribution strip chart"></svg>
        </div>
      </div>

      <!-- Detailed Values Table -->
      <div class="table-panel">
        <div class="table-header">
          <div class="table-title-group">
            <span class="table-title">Observation Classification Table</span>
            <span class="table-subtitle">Individual data points evaluated against active criteria</span>
          </div>
          <div class="table-filter-group">
            <button type="button" class="filter-chip active" data-filter="all">All (<span id="count-all">0</span>)</button>
            <button type="button" class="filter-chip" data-filter="outliers">Outliers (<span id="count-outliers">0</span>)</button>
            <button type="button" class="filter-chip" data-filter="normal">Normal (<span id="count-normal">0</span>)</button>
          </div>
        </div>
        <div class="table-responsive">
          <table class="data-table" id="outlier-data-table">
            <thead>
              <tr>
                <th style="width: 70px;">Rank</th>
                <th style="width: 140px;">Value (x)</th>
                <th style="width: 130px;">Z-Score</th>
                <th style="width: 160px;">Distance from Median</th>
                <th>Classification</th>
              </tr>
            </thead>
            <tbody id="outlier-table-body">
              <!-- Dynamically populated rows -->
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:inline>
  .outlier-calc-container {
    max-width: 1040px;
    margin: 1.5rem auto 3rem;
    font-family: var(--font-sans, "Inter", system-ui, sans-serif);
    text-align: left;
  }
  .outlier-calc-container * {
    box-sizing: border-box;
  }
  .calc-card {
    background: #0d131a;
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 12px 40px -10px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(0, 212, 170, 0.1);
  }
  .calc-header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
  }
  .calc-badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgba(0, 212, 170, 0.12);
    border: 1px solid rgba(0, 212, 170, 0.25);
    color: var(--color-primary, #00d4aa);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  .calc-title {
    font-size: 1.75rem;
    font-weight: 800;
    margin: 0 0 0.5rem;
    color: var(--color-text-primary, #f0f0f5);
    background: linear-gradient(135deg, #ffffff, var(--color-primary, #00d4aa));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .calc-subtitle {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-secondary, #a0a0b8);
    line-height: 1.6;
    max-width: 780px;
  }
  .calc-presets {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .preset-label {
    font-size: 0.82rem;
    color: var(--color-text-muted, #6b6b8a);
    font-weight: 600;
    margin-right: 0.25rem;
  }
  .preset-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-text-secondary, #a0a0b8);
    padding: 0.35rem 0.75rem;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .preset-btn:hover {
    background: rgba(0, 212, 170, 0.1);
    border-color: var(--color-primary, #00d4aa);
    color: var(--color-primary, #00d4aa);
