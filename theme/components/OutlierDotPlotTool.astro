    color: var(--color-primary, #00d4aa);
  }
  .calc-alert {
    padding: 1rem 1.25rem;
    border-radius: 10px;
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.25);
    color: #ff8080;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }
  .calc-results {
    margin-top: 1.5rem;
    animation: fadeIn 0.3s ease;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }
  .metric-card {
    background: #111922;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1rem 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .metric-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted, #6b6b8a);
    font-weight: 700;
  }
  .metric-val {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--color-text-primary, #f0f0f5);
    font-family: var(--font-mono, monospace);
  }
  .metric-val.accent {
    color: var(--color-primary, #00d4aa);
  }
  .metric-sub {
    font-size: 0.78rem;
    color: var(--color-text-secondary, #a0a0b8);
    line-height: 1.4;
  }
  .summary-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    background: #141d27;
    border: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .summary-banner.has-outliers {
    border-color: rgba(255, 107, 107, 0.3);
    background: rgba(255, 107, 107, 0.05);
  }
  .summary-banner.clean {
    border-color: rgba(16, 185, 129, 0.3);
    background: rgba(16, 185, 129, 0.05);
  }
  .banner-icon-col .badge {
    font-size: 0.78rem;
    font-weight: 700;
  }
  .banner-text-col {
    flex: 1;
    min-width: 240px;
  }
  .banner-headline {
    font-size: 1.2rem;
    font-weight: 800;
    margin: 0 0 0.25rem;
    color: var(--color-text-primary, #f0f0f5);
  }
  .banner-desc {
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-text-secondary, #a0a0b8);
  }
  .banner-actions {
    display: flex;
    gap: 0.5rem;
  }
  .btn-action-sm {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--color-text-primary, #f0f0f5);
    padding: 0.45rem 0.85rem;
    border-radius: 8px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
