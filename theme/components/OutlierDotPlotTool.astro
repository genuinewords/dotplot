    border-color: var(--color-primary, #00d4aa);
    color: var(--color-primary, #00d4aa);
  }
  .visual-panel {
    background: #111922;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .visual-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .visual-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-primary, #f0f0f5);
  }
  .visual-legend {
    display: flex;
    gap: 0.85rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .legend-item {
    font-size: 0.78rem;
    color: var(--color-text-secondary, #a0a0b8);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
  }
  .dot-normal { background: #00d4aa; }
  .dot-mild { background: #f59e0b; }
  .dot-extreme { background: #ff6b6b; }
  .fence-line-sample {
    width: 14px;
    height: 0;
    border-top: 2px dashed #a78bfa;
    display: inline-block;
  }
  .visual-chart-container {
    width: 100%;
    overflow-x: auto;
  }
  .visual-chart-container svg {
    width: 100%;
    min-width: 600px;
    display: block;
  }
  .table-panel {
    background: #111922;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
  }
  .table-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .table-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-primary, #f0f0f5);
    display: block;
  }
  .table-subtitle {
    font-size: 0.8rem;
    color: var(--color-text-muted, #6b6b8a);
  }
  .table-filter-group {
    display: flex;
    gap: 0.4rem;
  }
  .filter-chip {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--color-text-secondary, #a0a0b8);
    padding: 0.3rem 0.65rem;
    border-radius: 6px;
    font-size: 0.78rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .filter-chip.active {
    background: rgba(0, 212, 170, 0.15);
    border-color: var(--color-primary, #00d4aa);
    color: var(--color-primary, #00d4aa);
    font-weight: 600;
  }
  .table-responsive {
    overflow-x: auto;
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
    text-align: left;
  }
  .data-table th {
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-text-muted, #6b6b8a);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.75rem 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .data-table td {
    padding: 0.7rem 0.85rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--color-text-secondary, #a0a0b8);
  }
  .data-table tr:hover td {
    background: rgba(255, 255, 255, 0.02);
  }
  .badge-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .badge-status.normal {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.25);
  }
  .badge-status.mild {
    background: rgba(245, 158, 11, 0.12);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.25);
  }
  .badge-status.extreme {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.3);
  }
  @media (max-width: 768px) {
    .calc-card { padding: 1.25rem; }
    .calc-title { font-size: 1.4rem; }
    .method-toggles { grid-template-columns: 1fr; }
    .metrics-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>

<script>
  // Presets
  const PRESETS: Record<string, number[]> = {
    exam: [45, 68, 72, 74, 76, 78, 80, 82, 84, 85, 88, 91, 93, 98, 12, 100],
    housing: [180, 195, 210, 220, 225, 230, 240, 250, 260, 270, 275, 280, 290, 300, 310, 320, 330, 350, 375, 420, 850],
    lab: [91.2, 92.4, 93.1, 93.5, 94.0, 94.2, 94.5, 94.8, 95.0, 95.2, 95.4, 95.8, 96.1, 98.9, 78.5]
  };

  let activeMethod = 'iqr15'; // 'iqr15' | 'iqr30' | 'zscore'
  let activeFilter = 'all';  // 'all' | 'outliers' | 'normal'
  let cachedRecords: any[] = [];
  let cachedStats: any = null;

  function initOutlierCalculator() {
    const textarea = document.getElementById('outlier-raw-input') as HTMLTextAreaElement | null;
    const countTag = document.getElementById('calc-count-tag');
    const alertEl = document.getElementById('calc-alert');
    const resultsContainer = document.getElementById('calc-results');
    const clearBtn = document.getElementById('calc-clear-btn');
    const presetBtns = document.querySelectorAll('.preset-btn[data-preset]');
    const methodBtns = document.querySelectorAll('.method-btn');
    const filterChips = document.querySelectorAll('.filter-chip');
    const copyOutliersBtn = document.getElementById('btn-copy-outliers');
    const copySummaryBtn = document.getElementById('btn-copy-summary');

    if (!textarea) return;

    // Load default preset on startup
    if (!textarea.value.trim()) {
      textarea.value = PRESETS.exam.join(', ');
      recompute();
    }

    // Input event listener
    textarea.addEventListener('input', () => {
      recompute();
    });

    // Clear event
    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        textarea.value = '';
        recompute();
      });
    }

    // Presets
    presetBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const pKey = target.dataset.preset;
        if (pKey && PRESETS[pKey]) {
          textarea.value = PRESETS[pKey].join(', ');
          recompute();
        }
      });
    });

    // Method Toggles
    methodBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const method = target.dataset.method;
        if (!method) return;
        activeMethod = method;
        methodBtns.forEach(b => {
          b.classList.remove('active');
          b.setAttribute('aria-checked', 'false');
        });
        target.classList.add('active');
        target.setAttribute('aria-checked', 'true');
        recompute();
      });
    });

    // Filter Chips
    filterChips.forEach(chip => {
      chip.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        const filter = target.dataset.filter;
        if (!filter) return;
        activeFilter = filter;
        filterChips.forEach(c => c.classList.remove('active'));
        target.classList.add('active');
        renderTableRows();
      });
    });

    // Copy Outliers
    if (copyOutliersBtn) {
      copyOutliersBtn.addEventListener('click', () => {
        const outliers = cachedRecords.filter(r => r.status !== 'normal').map(r => r.val);
        const text = outliers.length ? outliers.join(', ') : 'None';
        navigator.clipboard.writeText(text).then(() => {
          const original = copyOutliersBtn.textContent;
          copyOutliersBtn.textContent = 'Copied!';
          setTimeout(() => { copyOutliersBtn.textContent = original; }, 1600);
        });
      });
    }

    // Copy Summary
    if (copySummaryBtn) {
      copySummaryBtn.addEventListener('click', () => {
        if (!cachedStats) return;
        const s = cachedStats;
        const text = `Outlier Analysis (${s.methodLabel}):\n` +
          `- Sample size: ${s.n}\n` +
          `- Mean: ${s.mean.toFixed(2)}, Std Dev: ${s.std.toFixed(2)}\n` +
          `- Q1: ${s.q1.toFixed(2)}, Median: ${s.median.toFixed(2)}, Q3: ${s.q3.toFixed(2)}\n` +
          `- IQR: ${s.iqr.toFixed(2)}\n` +
          `- Lower Threshold: ${s.lowerCutoff.toFixed(2)}, Upper Threshold: ${s.upperCutoff.toFixed(2)}\n` +
          `- Outliers Found: ${s.outlierCount} (${s.outlierValues.join(', ') || 'None'})`;
        navigator.clipboard.writeText(text).then(() => {
          const original = copySummaryBtn.textContent;
          copySummaryBtn.textContent = 'Copied!';
          setTimeout(() => { copySummaryBtn.textContent = original; }, 1600);
        });
      });
    }

    function parseNumbers(raw: string): number[] {
      return raw
        .split(/[\s,\t\n\r]+/)
        .map(s => s.trim())
        .filter(s => s !== '' && !isNaN(Number(s)))
        .map(Number);
    }

    // Type 7 linear interpolation (Excel QUARTILE.INC / R default)
    function calcPercentile(sorted: number[], p: number): number {
      const n = sorted.length;
      if (n === 0) return 0;
      const index = (n - 1) * p;
      const i = Math.floor(index);
      const f = index - i;
      if (i + 1 < n) {
        return (1 - f) * sorted[i] + f * sorted[i + 1];
      }
      return sorted[i];
    }

    function recompute() {
      const nums = parseNumbers(textarea.value);
      if (countTag) countTag.textContent = `${nums.length} numbers`;

      if (nums.length < 4) {
        if (alertEl) {
          alertEl.textContent = 'Please enter at least 4 numbers to reliably compute quartiles and boundaries.';
          alertEl.style.display = 'block';
        }
        if (resultsContainer) resultsContainer.style.display = 'none';
        return;
      }

      if (alertEl) alertEl.style.display = 'none';
      if (resultsContainer) resultsContainer.style.display = 'block';

      const n = nums.length;
      const sorted = [...nums].sort((a, b) => a - b);
      const sum = sorted.reduce((acc, v) => acc + v, 0);
      const mean = sum / n;
      const variance = sorted.reduce((acc, v) => acc + Math.pow(v - mean, 2), 0) / (n - 1);
      const std = Math.sqrt(variance);

      const q1 = calcPercentile(sorted, 0.25);
      const median = calcPercentile(sorted, 0.5);
      const q3 = calcPercentile(sorted, 0.75);
      const iqr = q3 - q1;

      const innerLower = q1 - 1.5 * iqr;
      const innerUpper = q3 + 1.5 * iqr;
      const outerLower = q1 - 3.0 * iqr;
      const outerUpper = q3 + 3.0 * iqr;

      const zLower = mean - 3.0 * std;
      const zUpper = mean + 3.0 * std;
      const zSuspiciousLower = mean - 2.0 * std;
      const zSuspiciousUpper = mean + 2.0 * std;

      let lowerCutoff = innerLower;
      let upperCutoff = innerUpper;
      let methodLabel = '1.5×IQR Rule';

      if (activeMethod === 'iqr30') {
        lowerCutoff = outerLower;
        upperCutoff = outerUpper;
        methodLabel = '3.0×IQR Rule';
      } else if (activeMethod === 'zscore') {
        lowerCutoff = zLower;
        upperCutoff = zUpper;
        methodLabel = 'Z-Score Rule (|z| > 3)';
      }

      // Classify each observation
      const records = sorted.map((val, idx) => {
        const z = std > 0 ? (val - mean) / std : 0;
        const distFromMedian = val - median;
        let status: 'normal' | 'mild' | 'extreme' = 'normal';
        let statusText = 'Normal';

        if (activeMethod === 'iqr15') {
          if (val < outerLower || val > outerUpper) {
            status = 'extreme';
            statusText = 'Extreme Outlier';
          } else if (val < innerLower || val > innerUpper) {
            status = 'mild';
            statusText = 'Mild Outlier';
          } else {
            status = 'normal';
            statusText = 'Normal';
          }
        } else if (activeMethod === 'iqr30') {
          if (val < outerLower || val > outerUpper) {
            status = 'extreme';
            statusText = 'Extreme Outlier';
          } else if (val < innerLower || val > innerUpper) {
            status = 'mild';
            statusText = 'Mild (Within 3×IQR)';
          } else {
            status = 'normal';
            statusText = 'Normal';
          }
        } else {
          // Z-score method
          if (Math.abs(z) > 3) {
            status = 'extreme';
            statusText = 'Extreme Outlier (|z| > 3)';
          } else if (Math.abs(z) > 2) {
            status = 'mild';
            statusText = 'Suspicious (|z| > 2)';
          } else {
            status = 'normal';
            statusText = 'Normal (|z| ≤ 2)';
          }
        }

        return {
          rank: idx + 1,
          val,
          z,
          distFromMedian,
          status,
          statusText
        };
      });

      cachedRecords = records;
      const outlierRecords = records.filter(r => r.status !== 'normal');
      const mildCount = records.filter(r => r.status === 'mild').length;
      const extremeCount = records.filter(r => r.status === 'extreme').length;

      cachedStats = {
        n,
        mean,
        std,
        q1,
        median,
        q3,
        iqr,
        lowerCutoff,
        upperCutoff,
        innerLower,
        innerUpper,
        outerLower,
        outerUpper,
        methodLabel,
        outlierCount: outlierRecords.length,
        outlierValues: outlierRecords.map(r => r.val)
      };

      // Update Tiles
      const metricN = document.getElementById('metric-n');
      const metricMeanStd = document.getElementById('metric-mean-std');
      const metricQSummary = document.getElementById('metric-q-summary');
      const metricMedian = document.getElementById('metric-median');
      const metricIqr = document.getElementById('metric-iqr');
      const metricIqrCalc = document.getElementById('metric-iqr-calc');
      const metricFencesSummary = document.getElementById('metric-fences-summary');
      const metricFencesDetail = document.getElementById('metric-fences-detail');

      if (metricN) metricN.textContent = `${n}`;
      if (metricMeanStd) metricMeanStd.textContent = `Mean: ${mean.toFixed(2)} | SD: ${std.toFixed(2)}`;
      if (metricQSummary) metricQSummary.textContent = `Q1: ${q1.toFixed(2)} | Q3: ${q3.toFixed(2)}`;
      if (metricMedian) metricMedian.textContent = `Median (Q2): ${median.toFixed(2)}`;
      if (metricIqr) metricIqr.textContent = `${iqr.toFixed(2)}`;
      if (metricIqrCalc) metricIqrCalc.textContent = `${q3.toFixed(2)} − ${q1.toFixed(2)}`;

      if (metricFencesSummary) {
        metricFencesSummary.textContent = `[${lowerCutoff.toFixed(1)}, ${upperCutoff.toFixed(1)}]`;
      }
      if (metricFencesDetail) {
        if (activeMethod === 'iqr15') {
          metricFencesDetail.textContent = `Inner: ${innerLower.toFixed(1)} to ${innerUpper.toFixed(1)} | Outer: ${outerLower.toFixed(1)} to ${outerUpper.toFixed(1)}`;
        } else if (activeMethod === 'iqr30') {
          metricFencesDetail.textContent = `Outer fences: ${outerLower.toFixed(1)} to ${outerUpper.toFixed(1)}`;
        } else {
          metricFencesDetail.textContent = `±3 SD: ${zLower.toFixed(1)} to ${zUpper.toFixed(1)} (±2 SD: ${zSuspiciousLower.toFixed(1)} to ${zSuspiciousUpper.toFixed(1)})`;
        }
      }

      // Update Banner
      const banner = document.getElementById('outlier-summary-banner');
      const bannerBadge = document.getElementById('banner-status-badge');
      const bannerHeadline = document.getElementById('banner-status-headline');
      const bannerDesc = document.getElementById('banner-status-desc');

      if (banner && bannerBadge && bannerHeadline && bannerDesc) {
        banner.classList.remove('has-outliers', 'clean');
        if (outlierRecords.length > 0) {
          banner.classList.add('has-outliers');
          bannerBadge.textContent = 'Outliers Found';
          bannerBadge.style.color = '#ff6b6b';
          bannerBadge.style.borderColor = 'rgba(255,107,107,0.3)';
          bannerHeadline.textContent = `${outlierRecords.length} Outlier${outlierRecords.length === 1 ? '' : 's'} Identified (${extremeCount} Extreme, ${mildCount} Mild)`;
          bannerDesc.textContent = `Values outside active thresholds: ${outlierRecords.map(r => r.val).join(', ')}`;
        } else {
          banner.classList.add('clean');
          bannerBadge.textContent = 'Clean Dataset';
          bannerBadge.style.color = '#10b981';
          bannerBadge.style.borderColor = 'rgba(16,185,129,0.3)';
          bannerHeadline.textContent = '0 Outliers Detected';
          bannerDesc.textContent = `All ${n} observations fall safely within normal boundary thresholds.`;
        }
      }

      // Update Filter counts
      const countAll = document.getElementById('count-all');
      const countOutliers = document.getElementById('count-outliers');
      const countNormal = document.getElementById('count-normal');
      if (countAll) countAll.textContent = `${n}`;
      if (countOutliers) countOutliers.textContent = `${outlierRecords.length}`;
      if (countNormal) countNormal.textContent = `${n - outlierRecords.length}`;

      renderVisualChart(sorted, records, lowerCutoff, upperCutoff, innerLower, innerUpper);
      renderTableRows();
    }

    function renderVisualChart(sorted: number[], records: any[], lowerCutoff: number, upperCutoff: number, innerLower: number, innerUpper: number) {
      const svg = document.getElementById('visual-chart-svg');
      if (!svg) return;

      const minVal = Math.min(sorted[0], lowerCutoff);
      const maxVal = Math.max(sorted[sorted.length - 1], upperCutoff);
      const dataSpan = (maxVal - minVal) || 1;
      const padMargin = dataSpan * 0.08;
      const plotMin = minVal - padMargin;
      const plotMax = maxVal + padMargin;
      const plotSpan = plotMax - plotMin;

      const W = 860;
      const H = 170;
      const pad = { left: 45, right: 45, top: 25, bottom: 45 };
      const cw = W - pad.left - pad.right;
      const axisY = H - pad.bottom;

      const scaleX = (val: number) => pad.left + ((val - plotMin) / plotSpan) * cw;

      let html = '';

      // Shaded normal zone
      const normX1 = Math.max(pad.left, scaleX(lowerCutoff));
      const normX2 = Math.min(W - pad.right, scaleX(upperCutoff));
      const normWidth = Math.max(0, normX2 - normX1);

      html += `<rect x="${normX1}" y="${pad.top}" width="${normWidth}" height="${axisY - pad.top}" fill="rgba(0, 212, 170, 0.05)" rx="4"/>`;

      // Axis line
      html += `<line x1="${pad.left}" y1="${axisY}" x2="${W - pad.right}" y2="${axisY}" stroke="#243040" stroke-width="2"/>`;

      // Axis ticks (6 ticks)
      for (let i = 0; i <= 6; i++) {
        const tickVal = plotMin + (plotSpan * i) / 6;
        const tx = scaleX(tickVal);
        html += `<line x1="${tx}" y1="${axisY}" x2="${tx}" y2="${axisY + 6}" stroke="#3b4d61" stroke-width="1.5"/>`;
        html += `<text x="${tx}" y="${axisY + 20}" fill="#6b7d8f" font-size="10" font-family="Inter, sans-serif" text-anchor="middle">${Math.round(tickVal * 10) / 10}</text>`;
      }

      // Lower fence line
      if (lowerCutoff >= plotMin && lowerCutoff <= plotMax) {
        const lx = scaleX(lowerCutoff);
        html += `<line x1="${lx}" y1="${pad.top}" x2="${lx}" y2="${axisY}" stroke="#a78bfa" stroke-width="1.8" stroke-dasharray="4,4"/>`;
        html += `<text x="${lx}" y="${pad.top - 6}" fill="#a78bfa" font-size="9" font-weight="600" font-family="Inter, sans-serif" text-anchor="middle">Lower Fence (${lowerCutoff.toFixed(1)})</text>`;
      }

      // Upper fence line
      if (upperCutoff >= plotMin && upperCutoff <= plotMax) {
        const ux = scaleX(upperCutoff);
        html += `<line x1="${ux}" y1="${pad.top}" x2="${ux}" y2="${axisY}" stroke="#a78bfa" stroke-width="1.8" stroke-dasharray="4,4"/>`;
        html += `<text x="${ux}" y="${pad.top - 6}" fill="#a78bfa" font-size="9" font-weight="600" font-family="Inter, sans-serif" text-anchor="middle">Upper Fence (${upperCutoff.toFixed(1)})</text>`;
      }

      // Plot data points with stacking to prevent excessive overlap
      const bins: Record<number, number> = {};
      const bucketSize = plotSpan / 65;

      records.forEach(rec => {
        const b = Math.round(rec.val / bucketSize);
        bins[b] = (bins[b] || 0) + 1;
        const stackIndex = bins[b];
        const cx = scaleX(rec.val);
        const cy = axisY - 10 - (stackIndex - 1) * 12;

        let dotFill = '#00d4aa';
        let strokeColor = '#008f72';
        if (rec.status === 'mild') {
          dotFill = '#f59e0b';
          strokeColor = '#b45309';
        } else if (rec.status === 'extreme') {
          dotFill = '#ff6b6b';
          strokeColor = '#dc2626';
        }

        html += `<circle cx="${cx}" cy="${cy}" r="5.5" fill="${dotFill}" stroke="${strokeColor}" stroke-width="1.5">
          <title>Value: ${rec.val} (${rec.statusText})</title>
        </circle>`;
      });

      svg.innerHTML = html;
    }

    function renderTableRows() {
      const tbody = document.getElementById('outlier-table-body');
      if (!tbody) return;

      let filtered = cachedRecords;
      if (activeFilter === 'outliers') {
        filtered = cachedRecords.filter(r => r.status !== 'normal');
      } else if (activeFilter === 'normal') {
        filtered = cachedRecords.filter(r => r.status === 'normal');
      }

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" style="text-align: center; padding: 2rem; color: #6b7d8f;">No observations match the selected filter.</td></tr>`;
        return;
      }

      tbody.innerHTML = filtered.map(r => {
        let badgeClass = 'normal';
        if (r.status === 'mild') badgeClass = 'mild';
        if (r.status === 'extreme') badgeClass = 'extreme';

        return `
          <tr>
            <td style="font-family: var(--font-mono, monospace); color: #6b7d8f;">#${r.rank}</td>
            <td style="font-family: var(--font-mono, monospace); font-weight: 700; color: #f0f0f5;">${r.val}</td>
            <td style="font-family: var(--font-mono, monospace); color: ${Math.abs(r.z) > 2 ? '#f59e0b' : '#a0a0b8'};">${r.z > 0 ? '+' : ''}${r.z.toFixed(2)}</td>
            <td style="font-family: var(--font-mono, monospace); color: #a0a0b8;">${r.distFromMedian > 0 ? '+' : ''}${r.distFromMedian.toFixed(2)}</td>
            <td><span class="badge-status ${badgeClass}">${r.statusText}</span></td>
          </tr>
        `;
      }).join('');
    }
  }

  // Initialize on load and Astro page transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initOutlierCalculator);
  } else {
    initOutlierCalculator();
  }
  document.addEventListener('astro:page-load', initOutlierCalculator);
</script>
