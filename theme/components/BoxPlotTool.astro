---
import { type Locale, defaultLocale } from "@src/i18n/config";
import "@fontsource-variable/space-grotesk";
import ibmPlexMono400Url from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import ibmPlexMono500Url from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
---

<section id="box-plot-tool" class="dotplot-wrapper boxplot-wrapper">
  <span id="ibm-plex-mono-urls-box" data-w400={ibmPlexMono400Url} data-w500={ibmPlexMono500Url} style="display:none" aria-hidden="true"></span>
  
  <style is:inline>
    .boxplot-wrapper {
      --bg: #0a0f14;
      --bg-elevated: #111920;
      --fg: #e8eef4;
      --muted: #6b7d8f;
      --accent: #00d4aa;
      --accent-dim: rgba(0, 212, 170, 0.15);
      --card: #151d26;
      --border: #243040;
      --danger: #ff6b6b;
      --purple: #8b5cf6;
      --amber: #f59e0b;
      
      font-family: 'Space Grotesk', sans-serif;
      background: var(--bg);
      color: var(--fg);
      position: relative;
      overflow: hidden;
      border-radius: 16px;
      margin: 0 auto;
      max-width: 1200px;
      padding: 2.5rem;
      box-shadow: 0 30px 60px -12px rgba(0, 212, 170, 0.15), 0 0 0 1px rgba(255,255,255,0.1);
    }

    .boxplot-wrapper * {
      box-sizing: border-box;
    }

    .boxplot-wrapper .font-mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Background atmosphere */
    .boxplot-wrapper .bg-atmosphere {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background: 
        radial-gradient(ellipse 80% 50% at 20% 10%, rgba(0, 212, 170, 0.08) 0%, transparent 50%),
        radial-gradient(ellipse 60% 40% at 80% 90%, rgba(139, 92, 246, 0.06) 0%, transparent 50%),
        linear-gradient(180deg, var(--bg) 0%, #0d1318 100%);
    }

    .boxplot-wrapper .grid-pattern {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      opacity: 0.03;
      background-image: 
        linear-gradient(var(--muted) 1px, transparent 1px),
        linear-gradient(90deg, var(--muted) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    /* Custom scrollbar */
    .boxplot-wrapper ::-webkit-scrollbar { width: 8px; height: 8px; }
    .boxplot-wrapper ::-webkit-scrollbar-track { background: var(--bg-elevated); }
    .boxplot-wrapper ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
    .boxplot-wrapper ::-webkit-scrollbar-thumb:hover { background: var(--muted); }

    /* Focus states */
    .boxplot-wrapper *:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    /* Inputs */
    .boxplot-wrapper .input-field {
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--fg);
      padding: 0.75rem 1rem;
      border-radius: 8px;
      transition: all 0.2s ease;
      width: 100%;
    }
    .boxplot-wrapper .input-field:hover { border-color: var(--muted); }
    .boxplot-wrapper .input-field:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-dim);
    }

    /* Buttons */
    .boxplot-wrapper .btn-primary {
      background: var(--accent);
      color: var(--bg);
      font-weight: 600;
      padding: 0.7rem 1.25rem;
      border-radius: 8px;
      transition: all 0.2s ease;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-size: 0.9rem;
    }
    .boxplot-wrapper .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 212, 170, 0.3);
    }
    .boxplot-wrapper .btn-primary:active { transform: translateY(0); }

    .boxplot-wrapper .btn-secondary {
      background: transparent;
      color: var(--fg);
      font-weight: 500;
      padding: 0.7rem 1.25rem;
      border-radius: 8px;
      transition: all 0.2s ease;
      border: 1px solid var(--border);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-size: 0.9rem;
    }
    .boxplot-wrapper .btn-secondary:hover {
      border-color: var(--muted);
      background: var(--card);
    }

    .boxplot-wrapper .btn-sm {
      padding: 0.4rem 0.75rem;
      font-size: 0.8rem;
      border-radius: 6px;
    }

    /* Card styles */
    .boxplot-wrapper .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
    }

    /* Canvas container */
    .boxplot-wrapper .canvas-container {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      position: relative;
    }

    /* Color picker wrapper */
    .boxplot-wrapper .color-picker-wrapper {
      position: relative;
      width: 40px;
      height: 40px;
      border-radius: 8px;
      overflow: hidden;
      border: 2px solid var(--border);
      cursor: pointer;
      transition: border-color 0.2s ease;
      flex-shrink: 0;
    }
    .boxplot-wrapper .color-picker-wrapper:hover { border-color: var(--muted); }
    .boxplot-wrapper .color-picker-wrapper input {
      position: absolute;
      inset: -4px;
      width: calc(100% + 8px);
      height: calc(100% + 8px);
      cursor: pointer;
      border: none;
      background: none;
    }

    /* Tabs */
    .boxplot-wrapper .tab-btn {
      padding: 0.5rem 0.9rem;
      border-radius: 6px;
      font-weight: 500;
      color: var(--muted);
      background: transparent;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
      font-size: 0.85rem;
    }
    .boxplot-wrapper .tab-btn:hover { color: var(--fg); }
    .boxplot-wrapper .tab-btn.active { background: var(--accent-dim); color: var(--accent); }

    /* Segmented pill control */
    .boxplot-wrapper .segmented-control {
      display: flex;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 2px;
      gap: 2px;
    }
    .boxplot-wrapper .segmented-btn {
      flex: 1;
      padding: 0.45rem 0.6rem;
      border-radius: 6px;
      border: none;
      background: transparent;
      color: var(--muted);
      font-size: 0.8rem;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
      text-align: center;
    }
    .boxplot-wrapper .segmented-btn.active {
      background: var(--accent);
      color: var(--bg);
      font-weight: 600;
      box-shadow: 0 2px 8px rgba(0, 212, 170, 0.25);
    }

    /* Toggle switch */
    .boxplot-wrapper .toggle-btn {
      width: 44px;
      height: 24px;
      border-radius: 9999px;
      transition: background-color 0.2s ease;
      background: var(--border);
      border: none;
      cursor: pointer;
      position: relative;
      padding: 2px;
      flex-shrink: 0;
    }
    .boxplot-wrapper .toggle-btn.active {
      background: var(--accent);
    }
    .boxplot-wrapper .toggle-knob {
      width: 20px;
      height: 20px;
      border-radius: 9999px;
      background: #ffffff;
      transition: transform 0.2s ease;
      transform: translateX(0);
    }
    .boxplot-wrapper .toggle-btn.active .toggle-knob {
      transform: translateX(20px);
    }

    /* Tooltip */
    .boxplot-wrapper .tooltip {
      position: absolute;
      background: #19232e;
      border: 1px solid var(--border);
      padding: 0.65rem 0.9rem;
      border-radius: 8px;
      font-size: 0.8rem;
      pointer-events: none;
      opacity: 0;
      transform: translateY(5px);
      transition: opacity 0.15s ease, transform 0.15s ease;
      white-space: nowrap;
      z-index: 100;
      box-shadow: 0 10px 25px rgba(0,0,0,0.4);
    }
    .boxplot-wrapper .tooltip.visible { opacity: 1; transform: translateY(0); }

    /* Drop area */
    .boxplot-wrapper .file-dropzone {
      border: 2px dashed var(--border);
      border-radius: 10px;
      padding: 1.5rem 1rem;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s ease;
      background: rgba(255,255,255,0.01);
    }
    .boxplot-wrapper .file-dropzone:hover,
    .boxplot-wrapper .file-dropzone.dragover {
      border-color: var(--accent);
      background: var(--accent-dim);
    }

    /* Toast notification */
    .boxplot-toast {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: #111920;
      border: 1px solid var(--accent);
      color: var(--accent);
      padding: 0.75rem 1.25rem;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 500;
      box-shadow: 0 10px 30px rgba(0, 212, 170, 0.2);
      z-index: 9999;
      opacity: 0;
      transform: translateY(10px);
      transition: all 0.25s ease;
      pointer-events: none;
    }
    .boxplot-toast.show {
      opacity: 1;
      transform: translateY(0);
    }

    @media (max-width: 768px) {
      .boxplot-wrapper {
        padding: 1.25rem;
      }
    }
  </style>

  <div class="bg-atmosphere"></div>
  <div class="grid-pattern"></div>

  <div class="relative z-10 w-full max-w-7xl mx-auto">
    <!-- Component top bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b" style="border-color: var(--border);">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2.5 h-2.5 rounded-full" style="background: var(--accent);"></span>
        <span class="text-xs font-semibold tracking-wider uppercase font-mono" style="color: var(--accent);">Interactive Box Plot Engine</span>
        <span class="text-xs px-2 py-0.5 rounded font-mono" style="background: rgba(255,255,255,0.05); color: var(--muted);">Type 7 Linear Interpolation</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-xs" style="color: var(--muted);">Presets:</span>
        <button type="button" class="btn-secondary btn-sm" onclick="boxLoadPreset('exams')">Exam Scores (2 Classes)</button>
        <button type="button" class="btn-secondary btn-sm" onclick="boxLoadPreset('response')">Response Times</button>
        <button type="button" class="btn-secondary btn-sm" onclick="boxLoadPreset('heights')">Adult Heights</button>
      </div>
    </div>

    <!-- Main Grid: Left Controls (1 col) + Right Chart & Data (2 cols) -->
    <div class="grid lg:grid-cols-3 gap-6">
      
      <!-- Left Panel: Data & Style Controls -->
      <div class="lg:col-span-1 space-y-6">
        
        <!-- Data Input Card -->
        <div class="card text-left">
          <div class="flex items-center justify-between mb-4">
            <h2 class="font-semibold text-base" style="color: var(--fg);">Data Input</h2>
            <div class="flex gap-1">
              <button type="button" class="tab-btn active" data-tab="paste" onclick="switchBoxTab('paste')">Paste</button>
              <button type="button" class="tab-btn" data-tab="manual" onclick="switchBoxTab('manual')">Multi-Group</button>
              <button type="button" class="tab-btn" data-tab="upload" onclick="switchBoxTab('upload')">CSV / Excel</button>
            </div>
          </div>

          <!-- Paste Tab -->
          <div id="box-tab-paste">
            <div class="flex items-center justify-between mb-2">
              <label for="box-paste-input" class="text-xs" style="color: var(--muted);">
                Paste data (comma / newline, or two-column <code>group, value</code> from Excel):
              </label>
            </div>
            <textarea 
              id="box-paste-input"
              class="input-field font-mono text-xs resize-none"
              rows="6"
              placeholder="Class A, 78&#10;Class A, 85&#10;Class B, 92&#10;Class B, 65&#10;-- OR --&#10;12, 15, 18, 22, 25, 30..."
            ></textarea>
            <div class="flex gap-2 mt-3">
              <button type="button" onclick="boxParseDataFromPaste()" class="btn-primary w-full">
                Render Box Plot
              </button>
              <button type="button" onclick="boxClearData()" class="btn-secondary" title="Clear data">
                Clear
              </button>
            </div>
          </div>

          <!-- Multi-Group Manual Tab -->
          <div id="box-tab-manual" class="hidden">
            <p class="text-xs mb-3" style="color: var(--muted);">
              Add individual groups or series to compare side-by-side:
            </p>
            <div class="space-y-3 mb-3">
              <div>
                <label for="box-group-name-input" class="block text-xs mb-1" style="color: var(--muted);">Group Name</label>
                <input type="text" id="box-group-name-input" class="input-field text-xs py-1.5" placeholder="e.g. Experiment A" value="New Group" />
              </div>
              <div>
                <label for="box-group-values-input" class="block text-xs mb-1" style="color: var(--muted);">Values (comma separated)</label>
                <input type="text" id="box-group-values-input" class="input-field font-mono text-xs py-1.5" placeholder="10, 15, 20, 25, 30" />
              </div>
              <button type="button" onclick="boxAddManualGroup()" class="btn-primary w-full btn-sm">
                + Add / Update Group
              </button>
            </div>

            <!-- Active Groups List -->
            <div class="text-xs font-semibold mb-2" style="color: var(--fg);">Active Groups:</div>
            <div id="box-groups-list" class="space-y-1.5 max-h-40 overflow-y-auto">
              <!-- Rendered Group Chips -->
            </div>
          </div>

          <!-- File Upload Tab -->
          <div id="box-tab-upload" class="hidden">
            <div 
              id="box-dropzone" 
              class="file-dropzone"
              onclick="document.getElementById('box-file-input').click()"
            >
              <svg class="mx-auto mb-2" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="color: var(--accent);">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              <p class="text-xs font-medium mb-1" style="color: var(--fg);">Click to upload or drag & drop</p>
              <p class="text-xs" style="color: var(--muted);">CSV, TSV, or spreadsheet export</p>
            </div>
            <input 
              type="file" 
              id="box-file-input" 
              accept=".csv,.txt,.tsv,.tab" 
              class="hidden" 
              onchange="boxHandleFileUpload(event)"
            />
            <div id="box-upload-status" class="text-xs mt-2 text-center" style="color: var(--accent);"></div>
          </div>
        </div>

        <!-- Outlier Controls Card -->
        <div class="card text-left">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-semibold text-base" style="color: var(--fg);">Outlier Detection</h2>
            <span class="text-xs font-mono px-2 py-0.5 rounded" style="background: var(--accent-dim); color: var(--accent);">Tukey Fences</span>
          </div>
          <p class="text-xs mb-3" style="color: var(--muted);">
            Choose the whisker threshold rule for identifying outliers:
          </p>
          <div class="segmented-control">
            <button 
              type="button" 
              id="outlier-btn-standard" 
              class="segmented-btn active" 
              onclick="boxSetOutlierRule('standard')"
            >
              Standard (1.5×IQR)
            </button>
            <button 
              type="button" 
              id="outlier-btn-extreme" 
              class="segmented-btn" 
              onclick="boxSetOutlierRule('extreme')"
            >
              Extreme (3×IQR)
            </button>
            <button 
              type="button" 
              id="outlier-btn-off" 
              class="segmented-btn" 
              onclick="boxSetOutlierRule('off')"
            >
              Off (Min/Max)
            </button>
          </div>
          <div id="box-outlier-rule-desc" class="text-xs mt-2.5 font-mono" style="color: var(--muted); line-height: 1.5;">
            Whiskers extend to points within Q1 - 1.5×IQR and Q3 + 1.5×IQR. Points outside are highlighted.
          </div>
        </div>

        <!-- Customization Card -->
        <div class="card text-left">
          <h2 class="font-semibold text-base mb-4" style="color: var(--fg);">Chart Customization</h2>
          
          <div class="space-y-4">
            <!-- Colors -->
            <div class="grid grid-cols-3 gap-2">
              <div>
                <label for="box-fill-color" class="block text-xs mb-1" style="color: var(--muted);">Box Fill</label>
                <div class="flex items-center gap-1.5">
                  <div class="color-picker-wrapper">
                    <input type="color" id="box-fill-color" value="#00d4aa" onchange="boxUpdatePlot()">
                  </div>
                </div>
              </div>
              <div>
                <label for="box-median-color" class="block text-xs mb-1" style="color: var(--muted);">Median Line</label>
                <div class="flex items-center gap-1.5">
                  <div class="color-picker-wrapper">
                    <input type="color" id="box-median-color" value="#ffffff" onchange="boxUpdatePlot()">
                  </div>
                </div>
              </div>
              <div>
                <label for="box-outlier-color" class="block text-xs mb-1" style="color: var(--muted);">Outlier Dot</label>
                <div class="flex items-center gap-1.5">
                  <div class="color-picker-wrapper">
                    <input type="color" id="box-outlier-color" value="#ff6b6b" onchange="boxUpdatePlot()">
                  </div>
                </div>
              </div>
            </div>

            <!-- Orientation -->
            <div class="flex items-center justify-between pt-1">
              <span class="text-xs" style="color: var(--muted);">Orientation</span>
              <div class="flex gap-1 p-0.5 rounded" style="background: var(--bg); border: 1px solid var(--border);">
                <button 
                  type="button" 
                  id="box-orient-vert" 
                  class="tab-btn active text-xs px-2.5 py-1" 
                  onclick="boxSetOrientation('vertical')"
                >Vertical</button>
                <button 
                  type="button" 
                  id="box-orient-horiz" 
                  class="tab-btn text-xs px-2.5 py-1" 
                  onclick="boxSetOrientation('horizontal')"
                >Horizontal</button>
              </div>
            </div>

            <!-- Titles & Labels -->
            <div class="space-y-2 pt-1 border-t" style="border-color: var(--border);">
              <div>
                <label for="box-chart-title" class="block text-xs mb-1" style="color: var(--muted);">Chart Title</label>
                <input type="text" id="box-chart-title" class="input-field text-xs py-1.5" value="Box & Whisker Distribution Plot" oninput="boxUpdatePlot()">
              </div>
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label for="box-x-label" class="block text-xs mb-1" style="color: var(--muted);">Category / Group Axis</label>
                  <input type="text" id="box-x-label" class="input-field text-xs py-1.5" value="Groups" oninput="boxUpdatePlot()">
                </div>
                <div>
                  <label for="box-y-label" class="block text-xs mb-1" style="color: var(--muted);">Measurement Axis</label>
                  <input type="text" id="box-y-label" class="input-field text-xs py-1.5" value="Values" oninput="boxUpdatePlot()">
                </div>
              </div>
            </div>

            <!-- Toggles -->
            <div class="space-y-2.5 pt-2 border-t" style="border-color: var(--border);">
              <div class="flex items-center justify-between">
                <span class="text-xs" style="color: var(--muted);">Mean Marker (Diamond ◆)</span>
                <button type="button" id="box-toggle-mean" class="toggle-btn active" onclick="boxToggleFeature('mean')" aria-label="Toggle Mean Marker">
                  <div class="toggle-knob"></div>
                </button>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs" style="color: var(--muted);">Notches (95% Median Confidence)</span>
                <button type="button" id="box-toggle-notches" class="toggle-btn" onclick="boxToggleFeature('notches')" aria-label="Toggle Notches">
                  <div class="toggle-knob"></div>
                </button>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs" style="color: var(--muted);">Jittered Raw Data Points</span>
                <button type="button" id="box-toggle-jitter" class="toggle-btn" onclick="boxToggleFeature('jitter')" aria-label="Toggle Jittered Data Points">
                  <div class="toggle-knob"></div>
                </button>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs" style="color: var(--muted);">Gridlines</span>
                <button type="button" id="box-toggle-grid" class="toggle-btn active" onclick="boxToggleFeature('grid')" aria-label="Toggle Gridlines">
                  <div class="toggle-knob"></div>
                </button>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Panel: Chart Visualizer & Five-Number Summary -->
      <div class="lg:col-span-2 space-y-4">
        
        <!-- Header Toolbar Above Canvas -->
        <div class="flex items-center justify-between flex-wrap gap-2.5">
          <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full" style="background: var(--accent);"></span>
            <span class="text-xs font-semibold uppercase tracking-wider font-mono" style="color: var(--muted);">Live Box Plot Preview</span>
          </div>
          <div class="flex items-center gap-2 flex-wrap">
            <button type="button" onclick="boxCopyStatsTable()" class="btn-secondary btn-sm" title="Copy Five-Number Summary as Text">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
              </svg>
              <span>Copy Stats Table</span>
            </button>
            <button type="button" onclick="boxCopyImageToClipboard()" class="btn-secondary btn-sm" title="Copy high-res image to clipboard">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span>Copy</span>
            </button>
            <button type="button" onclick="boxExportPNG()" class="btn-primary btn-sm" title="Download High-Resolution PNG">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
              <span>PNG</span>
            </button>
            <button type="button" onclick="boxExportSVG()" class="btn-secondary btn-sm" title="Download Scalable Vector SVG">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
