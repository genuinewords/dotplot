        <!-- Comprehensive Multi-Group Statistics Table -->
        <div class="card text-left">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-semibold text-base" style="color: var(--fg);">Comparative Statistical Matrix</h2>
            <span class="text-xs font-mono" style="color: var(--muted);" id="box-table-group-count">2 groups</span>
          </div>
