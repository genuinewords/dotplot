  <!-- Toast Element -->
  <div id="box-toast" class="boxplot-toast" aria-live="polite">Copied to clipboard!</div>

  <script is:inline>
    (function() {
      // Font loader
      var fontUrls = document.getElementById('ibm-plex-mono-urls-box');
      if (fontUrls) {
        var w400 = fontUrls.dataset.w400;
        var w500 = fontUrls.dataset.w500;
        if (w400 && document.fonts) new FontFace('IBM Plex Mono', 'url(' + w400 + ')', { weight: '400', display: 'swap' }).load().then(function(f) { document.fonts.add(f); }).catch(function(){});
        if (w500 && document.fonts) new FontFace('IBM Plex Mono', 'url(' + w500 + ')', { weight: '500', display: 'swap' }).load().then(function(f) { document.fonts.add(f); }).catch(function(){});
      }
    })();

    // Presets definition
    const BOX_PRESETS = {
      exams: [
        {
          name: "Class A",
          data: [58, 64, 68, 71, 74, 75, 77, 78, 80, 82, 82, 84, 85, 87, 88, 90, 92, 95, 98]
        },
        {
          name: "Class B",
          data: [45, 52, 60, 62, 65, 68, 70, 70, 72, 74, 75, 76, 78, 80, 81, 83, 85, 88, 100]
        }
      ],
      response: [
        {
          name: "API v1",
          data: [120, 135, 140, 142, 148, 150, 155, 160, 165, 170, 175, 180, 195, 210, 240, 280, 420]
        },
        {
          name: "API v2",
          data: [85, 90, 92, 95, 98, 100, 102, 105, 108, 110, 112, 115, 118, 122, 128, 135, 150]
        }
      ],
      heights: [
        {
          name: "Adult Males (cm)",
          data: [165, 168, 170, 172, 173, 174, 175, 176, 177, 178, 179, 180, 181, 182, 185, 188, 195]
        },
        {
          name: "Adult Females (cm)",
          data: [152, 155, 158, 160, 162, 163, 164, 165, 166, 167, 168, 170, 172, 174, 178]
        }
      ]
    };

    const BOX_COLORS = [
      '#00d4aa', '#8b5cf6', '#f59e0b', '#4d96ff', '#ec4899', '#10b981', '#6366f1'
    ];

    // State
    const boxState = {
      groups: JSON.parse(JSON.stringify(BOX_PRESETS.exams)),
      outlierRule: 'standard', // 'standard' | 'extreme' | 'off'
      orientation: 'vertical', // 'vertical' | 'horizontal'
      boxColor: '#00d4aa',
      medianColor: '#ffffff',
      outlierColor: '#ff6b6b',
      showMean: true,
      showNotches: false,
      showJitter: false,
      showGrid: true,
      title: 'Box & Whisker Distribution Plot',
      xLabel: 'Groups',
      yLabel: 'Values',
      calculatedStats: [],
      renderedShapes: []
    };

    const canvas = document.getElementById('box-canvas');
    const ctx = canvas ? canvas.getContext('2d') : null;
    const tooltip = document.getElementById('box-tooltip');

    // Tab switching
    window.switchBoxTab = function(tab) {
      document.querySelectorAll('#box-plot-tool .tab-btn').forEach(btn => {
        if (btn.dataset.tab) btn.classList.toggle('active', btn.dataset.tab === tab);
      });
      document.getElementById('box-tab-paste').classList.toggle('hidden', tab !== 'paste');
      document.getElementById('box-tab-manual').classList.toggle('hidden', tab !== 'manual');
      document.getElementById('box-tab-upload').classList.toggle('hidden', tab !== 'upload');
    };

    // Preset loading
    window.boxLoadPreset = function(name) {
      const presetData = BOX_PRESETS[name];
      if (!presetData) return;
      boxState.groups = JSON.parse(JSON.stringify(presetData));
      boxSyncInputsFromState();
      if (name === 'exams') {
        document.getElementById('box-chart-title').value = 'Exam Scores by Class';
        document.getElementById('box-x-label').value = 'Class Section';
        document.getElementById('box-y-label').value = 'Grade (%)';
      } else if (name === 'response') {
        document.getElementById('box-chart-title').value = 'API Response Latency Comparison';
        document.getElementById('box-x-label').value = 'Service Version';
        document.getElementById('box-y-label').value = 'Response Time (ms)';
      } else if (name === 'heights') {
        document.getElementById('box-chart-title').value = 'Adult Heights Distribution';
        document.getElementById('box-x-label').value = 'Demographic';
        document.getElementById('box-y-label').value = 'Height (cm)';
      }
      boxRecalculateAll();
      boxUpdatePlot();
      boxShowToast('Loaded ' + name + ' preset');
    };

    function boxSyncInputsFromState() {
      // Sync paste textarea with formatted group, value pairs
      const lines = [];
      boxState.groups.forEach(g => {
        g.data.forEach(v => {
          lines.push(`${g.name}, ${v}`);
        });
      });
      document.getElementById('box-paste-input').value = lines.join('\n');
      boxUpdateGroupsListDOM();
    }

    // Parsing
    function boxParseInputText(text) {
      if (!text || !text.trim()) return [];
      const lines = text.trim().split(/\r?\n/).map(l => l.trim()).filter(Boolean);
      
      // Check for two-column group, value format
      let validTwoColCount = 0;
      for (let line of lines) {
        const parts = line.split(/[,\t;]/).map(p => p.trim());
        if (parts.length >= 2) {
          const val = Number(parts[parts.length - 1]);
          if (!isNaN(val) && isFinite(val)) {
            validTwoColCount++;
          }
        }
      }

      if (validTwoColCount >= 2 && validTwoColCount >= lines.length * 0.4) {
        const groupedMap = {};
        lines.forEach(line => {
          const parts = line.split(/[,\t;]/).map(p => p.trim());
          if (parts.length >= 2) {
            const val = Number(parts[parts.length - 1]);
            if (!isNaN(val) && isFinite(val)) {
              const grpName = parts.slice(0, parts.length - 1).join(' ') || 'Group 1';
              if (!groupedMap[grpName]) groupedMap[grpName] = [];
              groupedMap[grpName].push(val);
            }
          }
        });
        return Object.entries(groupedMap).map(([name, data]) => ({ name, data }));
      }

      // Check for Group: val, val, val
      const keyValGroups = [];
      for (let line of lines) {
        if (line.includes(':') || line.includes('=')) {
          const splitChar = line.includes(':') ? ':' : '=';
          const [name, rest] = line.split(splitChar);
          const nums = rest.split(/[\s,;]+/).map(Number).filter(v => !isNaN(v) && isFinite(v));
          if (nums.length > 0) {
            keyValGroups.push({ name: name.trim() || `Group ${keyValGroups.length + 1}`, data: nums });
          }
        }
      }
      if (keyValGroups.length > 0) return keyValGroups;

      // Check if each line is a separate series of numbers
      if (lines.length > 1 && lines.every(l => l.split(/[\s,;]+/).map(Number).filter(v => !isNaN(v)).length >= 2)) {
        return lines.map((l, idx) => ({
          name: `Series ${idx + 1}`,
          data: l.split(/[\s,;]+/).map(Number).filter(v => !isNaN(v) && isFinite(v))
        }));
      }

      // Single group fallback
      const flat = text.split(/[\s,;\r\n\t]+/).map(Number).filter(v => !isNaN(v) && isFinite(v));
      if (flat.length > 0) {
        return [{ name: 'Sample Dataset', data: flat }];
      }

      return [];
    }

    window.boxParseDataFromPaste = function() {
      const text = document.getElementById('box-paste-input').value;
      const parsed = boxParseInputText(text);
      if (parsed.length === 0 || parsed.every(g => g.data.length < 2)) {
        alert('Please enter at least 2 numeric values per group.');
        return;
      }
      boxState.groups = parsed;
      boxUpdateGroupsListDOM();
      boxRecalculateAll();
      boxUpdatePlot();
      boxShowToast(`Rendered ${parsed.length} group(s)`);
    };

    window.boxClearData = function() {
      boxState.groups = [];
      document.getElementById('box-paste-input').value = '';
      boxUpdateGroupsListDOM();
      boxRecalculateAll();
      boxUpdatePlot();
    };

    window.boxAddManualGroup = function() {
      const name = document.getElementById('box-group-name-input').value.trim() || 'New Group';
      const valStr = document.getElementById('box-group-values-input').value;
      const nums = valStr.split(/[\s,;]+/).map(Number).filter(v => !isNaN(v) && isFinite(v));
      if (nums.length < 2) {
        alert('Please enter at least 2 numbers for this group.');
        return;
      }
      const existing = boxState.groups.find(g => g.name.toLowerCase() === name.toLowerCase());
      if (existing) {
        existing.data = nums;
      } else {
        boxState.groups.push({ name, data: nums });
      }
      boxSyncInputsFromState();
      boxRecalculateAll();
      boxUpdatePlot();
      boxShowToast('Updated ' + name);
    };

    window.boxRemoveGroup = function(idx) {
      boxState.groups.splice(idx, 1);
      boxSyncInputsFromState();
      boxRecalculateAll();
      boxUpdatePlot();
    };

    function boxUpdateGroupsListDOM() {
      const container = document.getElementById('box-groups-list');
      if (!container) return;
      if (boxState.groups.length === 0) {
        container.innerHTML = '<span class="text-xs" style="color: var(--muted);">No active groups</span>';
        return;
      }
      container.innerHTML = boxState.groups.map((g, idx) => `
        <div class="flex items-center justify-between p-2 rounded text-xs font-mono" style="background: var(--bg); border: 1px solid var(--border);">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full" style="background: ${BOX_COLORS[idx % BOX_COLORS.length]};"></span>
            <span class="font-semibold" style="color: var(--fg);">${g.name}</span>
            <span style="color: var(--muted);">(${g.data.length} pts)</span>
          </div>
          <button type="button" onclick="boxRemoveGroup(${idx})" style="color: var(--danger); font-size: 14px; cursor: pointer;">&times;</button>
        </div>
      `).join('');
    }

    // File upload
    window.boxHandleFileUpload = function(e) {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(evt) {
        const content = evt.target.result;
        const parsed = boxParseInputText(content);
        if (parsed.length > 0) {
          boxState.groups = parsed;
          boxSyncInputsFromState();
          document.getElementById('box-upload-status').textContent = '✓ Successfully loaded ' + file.name + ' (' + parsed.length + ' group(s))';
          boxRecalculateAll();
          boxUpdatePlot();
          boxShowToast('Loaded ' + file.name);
        } else {
          document.getElementById('box-upload-status').textContent = 'Could not parse numbers from file.';
        }
      };
      reader.readAsText(file);
    };

    // Drag and drop for dropzone
    const boxDropzone = document.getElementById('box-dropzone');
    if (boxDropzone) {
      ['dragenter', 'dragover'].forEach(name => {
        boxDropzone.addEventListener(name, (e) => { e.preventDefault(); boxDropzone.classList.add('dragover'); });
      });
      ['dragleave', 'drop'].forEach(name => {
        boxDropzone.addEventListener(name, (e) => { e.preventDefault(); boxDropzone.classList.remove('dragover'); });
      });
      boxDropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        if (dt && dt.files && dt.files.length) {
          boxHandleFileUpload({ target: { files: dt.files } });
        }
      });
    }

    // Outlier Rule Setter
    window.boxSetOutlierRule = function(rule) {
      boxState.outlierRule = rule;
      document.getElementById('outlier-btn-standard').classList.toggle('active', rule === 'standard');
      document.getElementById('outlier-btn-extreme').classList.toggle('active', rule === 'extreme');
      document.getElementById('outlier-btn-off').classList.toggle('active', rule === 'off');

      const descEl = document.getElementById('box-outlier-rule-desc');
      if (descEl) {
        if (rule === 'standard') {
          descEl.textContent = "Whiskers extend to points within Q1 - 1.5×IQR and Q3 + 1.5×IQR. Points outside are highlighted.";
        } else if (rule === 'extreme') {
          descEl.textContent = "Whiskers extend to points within Q1 - 3.0×IQR and Q3 + 3.0×IQR. Only extreme outliers are isolated.";
        } else {
          descEl.textContent = "Whiskers extend to absolute Min and Max. Outlier identification is turned off.";
        }
      }

      boxRecalculateAll();
      boxUpdatePlot();
    };

    // Orientation Setter
    window.boxSetOrientation = function(orient) {
      boxState.orientation = orient;
      document.getElementById('box-orient-vert').classList.toggle('active', orient === 'vertical');
      document.getElementById('box-orient-horiz').classList.toggle('active', orient === 'horizontal');
      boxUpdatePlot();
    };

    // Toggle Customizations
    window.boxToggleFeature = function(feature) {
      if (feature === 'mean') {
        boxState.showMean = !boxState.showMean;
        document.getElementById('box-toggle-mean').classList.toggle('active', boxState.showMean);
      } else if (feature === 'notches') {
        boxState.showNotches = !boxState.showNotches;
        document.getElementById('box-toggle-notches').classList.toggle('active', boxState.showNotches);
      } else if (feature === 'jitter') {
        boxState.showJitter = !boxState.showJitter;
        document.getElementById('box-toggle-jitter').classList.toggle('active', boxState.showJitter);
      } else if (feature === 'grid') {
        boxState.showGrid = !boxState.showGrid;
        document.getElementById('box-toggle-grid').classList.toggle('active', boxState.showGrid);
      }
      boxUpdatePlot();
    };

    // Math: Five-Number Summary & Type 7 Linear Interpolation
    function boxComputeGroupStats(group, outlierRule) {
      const data = group.data;
      const n = data.length;
      if (n < 2) return null;

      const sorted = [...data].sort((a, b) => a - b);
      const min = sorted[0];
      const max = sorted[n - 1];
      const sum = sorted.reduce((a, b) => a + b, 0);
      const mean = sum / n;

      // Sample standard deviation
      const variance = sorted.reduce((acc, v) => acc + Math.pow(v - mean, 2), 0) / (n - 1);
      const std = Math.sqrt(variance);

      // Type 7 linear interpolation (Excel QUARTILE.INC / R default)
      function calcPercentile(p) {
        const index = (n - 1) * p;
        const i = Math.floor(index);
        const f = index - i;
        if (i + 1 < n) {
          return (1 - f) * sorted[i] + f * sorted[i + 1];
        }
        return sorted[i];
      }

      const q1 = calcPercentile(0.25);
      const median = calcPercentile(0.5);
      const q3 = calcPercentile(0.75);
      const iqr = q3 - q1;

      // Fences & Outliers
      let lowerFence, upperFence;
      let lowerWhisker, upperWhisker;
      let outliers = [];

      if (outlierRule === 'off') {
        lowerWhisker = min;
        upperWhisker = max;
        lowerFence = min;
        upperFence = max;
        outliers = [];
      } else {
        const multiplier = outlierRule === 'extreme' ? 3.0 : 1.5;
        lowerFence = q1 - multiplier * iqr;
        upperFence = q3 + multiplier * iqr;

        // Whiskers extend to most extreme points within fences
        const insidePoints = sorted.filter(v => v >= lowerFence && v <= upperFence);
        lowerWhisker = insidePoints.length > 0 ? insidePoints[0] : q1;
        upperWhisker = insidePoints.length > 0 ? insidePoints[insidePoints.length - 1] : q3;

        outliers = sorted.filter(v => v < lowerFence || v > upperFence);
      }

      // 95% Confidence notch: median +/- 1.58 * IQR / sqrt(n)
      const notchOffset = (iqr > 0 && n > 0) ? (1.58 * iqr / Math.sqrt(n)) : 0;
      const notchLower = Math.max(lowerWhisker, median - notchOffset);
      const notchUpper = Math.min(upperWhisker, median + notchOffset);

      return {
        name: group.name,
        n,
        min,
        q1,
        median,
        q3,
        max,
        iqr,
        mean,
        std,
        lowerWhisker,
        upperWhisker,
        lowerFence,
        upperFence,
        outliers,
        notchLower,
        notchUpper,
        rawSorted: sorted
      };
    }

    function boxRecalculateAll() {
      const stats = [];
      boxState.groups.forEach(g => {
        const s = boxComputeGroupStats(g, boxState.outlierRule);
        if (s) stats.push(s);
      });
      boxState.calculatedStats = stats;
      boxUpdateStatsDOM();
      boxUpdateMatrixTableDOM();
      boxUpdateCaption();
    }

    function boxUpdateCaption() {
      const captionEl = document.getElementById('box-chart-caption');
      if (!captionEl) return;
      const numGroups = boxState.calculatedStats.length;
      let ruleStr = "Standard 1.5×IQR Outlier Rule";
      if (boxState.outlierRule === 'extreme') ruleStr = "Extreme 3.0×IQR Outlier Rule";
      else if (boxState.outlierRule === 'off') ruleStr = "Min/Max Whiskers (Outliers Off)";

      captionEl.textContent = `${numGroups} group(s) · ${ruleStr} · Linear Interpolation (Type 7)`;
    }

    function boxUpdateStatsDOM() {
      const stats = boxState.calculatedStats;
      if (stats.length === 0) {
        ['min', 'q1', 'median', 'q3', 'max'].forEach(k => {
          document.getElementById('box-stat-' + k).textContent = '-';
        });
        return;
      }
      // Display first or primary group in summary cards
      const primary = stats[0];
      document.getElementById('box-stat-min').textContent = primary.min.toFixed(2);
      document.getElementById('box-stat-q1').textContent = primary.q1.toFixed(2);
      document.getElementById('box-stat-median').textContent = primary.median.toFixed(2);
      document.getElementById('box-stat-q3').textContent = primary.q3.toFixed(2);
      document.getElementById('box-stat-max').textContent = primary.max.toFixed(2);
    }

    function boxUpdateMatrixTableDOM() {
      const tbody = document.getElementById('box-matrix-body');
      const countEl = document.getElementById('box-table-group-count');
      if (!tbody) return;
      const stats = boxState.calculatedStats;
      if (countEl) countEl.textContent = `${stats.length} group(s)`;

      if (stats.length === 0) {
        tbody.innerHTML = '<tr><td colspan="10" class="py-3 px-3 text-center" style="color: var(--muted);">No valid group data</td></tr>';
        return;
      }

      tbody.innerHTML = stats.map((s, idx) => `
        <tr style="border-bottom: 1px solid rgba(255,255,255,0.04);">
          <td class="py-2 px-3 font-semibold" style="color: ${BOX_COLORS[idx % BOX_COLORS.length]};">${s.name}</td>
          <td class="py-2 px-3 font-mono">${s.n}</td>
          <td class="py-2 px-3 font-mono">${s.min.toFixed(2)}</td>
          <td class="py-2 px-3 font-mono">${s.q1.toFixed(2)}</td>
          <td class="py-2 px-3 font-mono font-bold" style="color: #ffd93d;">${s.median.toFixed(2)}</td>
          <td class="py-2 px-3 font-mono">${s.q3.toFixed(2)}</td>
          <td class="py-2 px-3 font-mono">${s.max.toFixed(2)}</td>
          <td class="py-2 px-3 font-mono" style="color: var(--accent);">${s.iqr.toFixed(2)}</td>
          <td class="py-2 px-3 font-mono">${s.mean.toFixed(2)}</td>
          <td class="py-2 px-3 font-mono" style="color: ${s.outliers.length > 0 ? 'var(--danger)' : 'var(--muted)'};">
            ${s.outliers.length > 0 ? s.outliers.map(v => v.toFixed(1)).join(', ') : 'None'}
          </td>
        </tr>
      `).join('');
    }

    window.boxCopyStatsTable = function() {
      const stats = boxState.calculatedStats;
      if (stats.length === 0) return;
      let text = "Five-Number Summary & Statistics\n";
      text += "=================================\n";
      stats.forEach(s => {
        text += `Group: ${s.name}\n`;
        text += `  - Sample Size (N): ${s.n}\n`;
        text += `  - Minimum: ${s.min.toFixed(2)}\n`;
        text += `  - Q1 (25th percentile): ${s.q1.toFixed(2)}\n`;
        text += `  - Median (50th percentile): ${s.median.toFixed(2)}\n`;
        text += `  - Q3 (75th percentile): ${s.q3.toFixed(2)}\n`;
        text += `  - Maximum: ${s.max.toFixed(2)}\n`;
        text += `  - IQR: ${s.iqr.toFixed(2)}\n`;
        text += `  - Mean: ${s.mean.toFixed(2)}\n`;
        text += `  - Std Dev: ${s.std.toFixed(2)}\n`;
        text += `  - Outliers (${boxState.outlierRule === 'extreme' ? '3x IQR' : '1.5x IQR'}): ${s.outliers.length > 0 ? s.outliers.join(', ') : 'None'}\n\n`;
      });
      text += "* Quartiles calculated using Type 7 linear interpolation (Excel QUARTILE.INC / R default).";

      navigator.clipboard.writeText(text).then(() => {
        boxShowToast('Statistics table copied to clipboard!');
      }).catch(() => {
        boxShowToast('Could not access clipboard');
      });
    };

    // Render Canvas Box Plot
    window.boxUpdatePlot = function() {
      if (!canvas || !ctx) return;
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      const w = rect.width;
      const h = Math.max(480, rect.height || 500);

      if (canvas.width !== w * dpr || canvas.height !== h * dpr) {
        canvas.width = w * dpr;
        canvas.height = h * dpr;
      }
      ctx.resetTransform ? ctx.resetTransform() : ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.scale(dpr, dpr);

      // Background
      ctx.fillStyle = '#111920';
      ctx.fillRect(0, 0, w, h);

      const stats = boxState.calculatedStats;
      if (!stats || stats.length === 0) {
        ctx.fillStyle = '#6b7d8f';
        ctx.font = '14px "Space Grotesk", sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('Please enter numeric data to render box plot', w / 2, h / 2);
        return;
      }

      // Title & labels read from DOM
      boxState.title = document.getElementById('box-chart-title').value || 'Box Plot';
      boxState.xLabel = document.getElementById('box-x-label').value || 'Groups';
      boxState.yLabel = document.getElementById('box-y-label').value || 'Values';
      boxState.boxColor = document.getElementById('box-fill-color').value || '#00d4aa';
      boxState.medianColor = document.getElementById('box-median-color').value || '#ffffff';
      boxState.outlierColor = document.getElementById('box-outlier-color').value || '#ff6b6b';

      const padding = { top: 60, right: 40, bottom: 65, left: 70 };
      const plotWidth = w - padding.left - padding.right;
      const plotHeight = h - padding.top - padding.bottom;

      // Find global min and max across all groups (including outliers)
      let globalMin = Math.min(...stats.map(s => s.min));
      let globalMax = Math.max(...stats.map(s => s.max));
      if (globalMin === globalMax) {
        globalMin -= 1;
        globalMax += 1;
      }
      const dataSpan = globalMax - globalMin;
      // Add a 5% margin to axis scale
      const axisMin = globalMin - dataSpan * 0.05;
      const axisMax = globalMax + dataSpan * 0.05;
      const axisRange = axisMax - axisMin;

      boxState.renderedShapes = [];
      const isVertical = boxState.orientation === 'vertical';

      // Draw Gridlines
      if (boxState.showGrid) {
        ctx.strokeStyle = 'rgba(255, 255, 255, 0.05)';
        ctx.lineWidth = 1;
        const gridSteps = 5;
        for (let i = 0; i <= gridSteps; i++) {
          if (isVertical) {
            const y = padding.top + plotHeight - (i / gridSteps) * plotHeight;
            ctx.beginPath();
            ctx.moveTo(padding.left, y);
            ctx.lineTo(padding.left + plotWidth, y);
            ctx.stroke();
          } else {
            const x = padding.left + (i / gridSteps) * plotWidth;
            ctx.beginPath();
            ctx.moveTo(x, padding.top);
            ctx.lineTo(x, padding.top + plotHeight);
            ctx.stroke();
          }
        }
      }

      // Draw Axes
      ctx.strokeStyle = 'rgba(107, 125, 143, 0.4)';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(padding.left, padding.top);
      ctx.lineTo(padding.left, padding.top + plotHeight);
      ctx.lineTo(padding.left + plotWidth, padding.top + plotHeight);
      ctx.stroke();

      // Axis Ticks & Numbers
      ctx.font = '11px "IBM Plex Mono", monospace';
      ctx.fillStyle = '#6b7d8f';

      if (isVertical) {
        // Value axis is Y
        ctx.textAlign = 'right';
        ctx.textBaseline = 'middle';
        const ySteps = 5;
        for (let i = 0; i <= ySteps; i++) {
          const val = axisMin + (i / ySteps) * axisRange;
          const y = padding.top + plotHeight - (i / ySteps) * plotHeight;
          ctx.fillText(val.toFixed(1), padding.left - 10, y);
        }
      } else {
        // Value axis is X
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        const xSteps = 5;
        for (let i = 0; i <= xSteps; i++) {
          const val = axisMin + (i / xSteps) * axisRange;
          const x = padding.left + (i / xSteps) * plotWidth;
          ctx.fillText(val.toFixed(1), x, padding.top + plotHeight + 10);
        }
      }

      function valToCoord(val) {
        if (isVertical) {
          return padding.top + plotHeight - ((val - axisMin) / axisRange) * plotHeight;
        } else {
          return padding.left + ((val - axisMin) / axisRange) * plotWidth;
        }
      }

      // Render Boxes for Each Group
      const numGroups = stats.length;
      const groupSlotSize = (isVertical ? plotWidth : plotHeight) / numGroups;
      const boxThickness = Math.min(65, groupSlotSize * 0.55);

      stats.forEach((s, idx) => {
        const slotCenter = (isVertical ? padding.left : padding.top) + (idx + 0.5) * groupSlotSize;
        const color = numGroups === 1 ? boxState.boxColor : BOX_COLORS[idx % BOX_COLORS.length];

        // Group category label on axis
        ctx.font = '12px "Space Grotesk", sans-serif';
        ctx.fillStyle = color;
        if (isVertical) {
          ctx.textAlign = 'center';
          ctx.textBaseline = 'top';
          ctx.fillText(s.name, slotCenter, padding.top + plotHeight + 12);
        } else {
          ctx.textAlign = 'right';
          ctx.textBaseline = 'middle';
          ctx.fillText(s.name, padding.left - 10, slotCenter);
        }

        // Whiskers Coordinates
        const lowWhiskerCoord = valToCoord(s.lowerWhisker);
        const upWhiskerCoord = valToCoord(s.upperWhisker);
        const q1Coord = valToCoord(s.q1);
        const q3Coord = valToCoord(s.q3);
        const medCoord = valToCoord(s.median);
        const whiskerCapSize = boxThickness * 0.45;

        // Draw Whisker Center Line
        ctx.strokeStyle = color;
        ctx.lineWidth = 1.5;
        ctx.beginPath();
        if (isVertical) {
          // Bottom whisker
          ctx.moveTo(slotCenter, q1Coord);
          ctx.lineTo(slotCenter, lowWhiskerCoord);
          // Top whisker
          ctx.moveTo(slotCenter, q3Coord);
          ctx.lineTo(slotCenter, upWhiskerCoord);
          // Whisker End Caps
          ctx.moveTo(slotCenter - whiskerCapSize / 2, lowWhiskerCoord);
          ctx.lineTo(slotCenter + whiskerCapSize / 2, lowWhiskerCoord);
          ctx.moveTo(slotCenter - whiskerCapSize / 2, upWhiskerCoord);
          ctx.lineTo(slotCenter + whiskerCapSize / 2, upWhiskerCoord);
        } else {
          // Left whisker
          ctx.moveTo(q1Coord, slotCenter);
          ctx.lineTo(lowWhiskerCoord, slotCenter);
          // Right whisker
          ctx.moveTo(q3Coord, slotCenter);
          ctx.lineTo(upWhiskerCoord, slotCenter);
          // Whisker End Caps
          ctx.moveTo(lowWhiskerCoord, slotCenter - whiskerCapSize / 2);
          ctx.lineTo(lowWhiskerCoord, slotCenter + whiskerCapSize / 2);
          ctx.moveTo(upWhiskerCoord, slotCenter - whiskerCapSize / 2);
          ctx.lineTo(upWhiskerCoord, slotCenter + whiskerCapSize / 2);
        }
        ctx.stroke();

        // Draw Box (with optional notches)
        ctx.fillStyle = boxAdjustColorOpacity(color, 0.4);
        ctx.strokeStyle = color;
        ctx.lineWidth = 2;

        if (boxState.showNotches && s.notchLower < s.notchUpper) {
          // Notched polygon
          const nLowCoord = valToCoord(s.notchLower);
          const nUpCoord = valToCoord(s.notchUpper);
          const halfW = boxThickness / 2;
          const notchInset = boxThickness * 0.28;

          ctx.beginPath();
          if (isVertical) {
            ctx.moveTo(slotCenter - halfW, q1Coord);
            ctx.lineTo(slotCenter - halfW, nLowCoord);
            ctx.lineTo(slotCenter - halfW + notchInset, medCoord);
            ctx.lineTo(slotCenter - halfW, nUpCoord);
            ctx.lineTo(slotCenter - halfW, q3Coord);
            ctx.lineTo(slotCenter + halfW, q3Coord);
            ctx.lineTo(slotCenter + halfW, nUpCoord);
            ctx.lineTo(slotCenter + halfW - notchInset, medCoord);
            ctx.lineTo(slotCenter + halfW, nLowCoord);
            ctx.lineTo(slotCenter + halfW, q1Coord);
          } else {
            ctx.moveTo(q1Coord, slotCenter - halfW);
            ctx.lineTo(nLowCoord, slotCenter - halfW);
            ctx.lineTo(medCoord, slotCenter - halfW + notchInset);
            ctx.lineTo(nUpCoord, slotCenter - halfW);
            ctx.lineTo(q3Coord, slotCenter - halfW);
            ctx.lineTo(q3Coord, slotCenter + halfW);
            ctx.lineTo(nUpCoord, slotCenter + halfW);
            ctx.lineTo(medCoord, slotCenter + halfW - notchInset);
            ctx.lineTo(nLowCoord, slotCenter + halfW);
            ctx.lineTo(q1Coord, slotCenter + halfW);
          }
          ctx.closePath();
          ctx.fill();
          ctx.stroke();
        } else {
          // Standard box rectangle
          if (isVertical) {
            const bY = Math.min(q1Coord, q3Coord);
            const bH = Math.abs(q1Coord - q3Coord);
            ctx.fillRect(slotCenter - boxThickness / 2, bY, boxThickness, bH);
            ctx.strokeRect(slotCenter - boxThickness / 2, bY, boxThickness, bH);
          } else {
            const bX = Math.min(q1Coord, q3Coord);
            const bW = Math.abs(q1Coord - q3Coord);
            ctx.fillRect(bX, slotCenter - boxThickness / 2, bW, boxThickness);
            ctx.strokeRect(bX, slotCenter - boxThickness / 2, bW, boxThickness);
          }
        }

        // Draw Median Line
        ctx.strokeStyle = boxState.medianColor;
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        if (isVertical) {
          const notchInset = boxState.showNotches ? boxThickness * 0.28 : 0;
          ctx.moveTo(slotCenter - boxThickness / 2 + notchInset, medCoord);
          ctx.lineTo(slotCenter + boxThickness / 2 - notchInset, medCoord);
        } else {
          const notchInset = boxState.showNotches ? boxThickness * 0.28 : 0;
          ctx.moveTo(medCoord, slotCenter - boxThickness / 2 + notchInset);
          ctx.lineTo(medCoord, slotCenter + boxThickness / 2 - notchInset);
        }
        ctx.stroke();

        // Draw Mean Marker (Diamond ◆)
        if (boxState.showMean) {
          const meanCoord = valToCoord(s.mean);
          const dSize = 5;
          ctx.fillStyle = '#ffd93d';
          ctx.strokeStyle = '#111920';
          ctx.lineWidth = 1;
          ctx.beginPath();
          if (isVertical) {
            ctx.moveTo(slotCenter, meanCoord - dSize);
            ctx.lineTo(slotCenter + dSize, meanCoord);
            ctx.lineTo(slotCenter, meanCoord + dSize);
            ctx.lineTo(slotCenter - dSize, meanCoord);
          } else {
            ctx.moveTo(meanCoord, slotCenter - dSize);
            ctx.lineTo(meanCoord + dSize, slotCenter);
            ctx.lineTo(meanCoord, slotCenter + dSize);
            ctx.lineTo(meanCoord - dSize, slotCenter);
          }
          ctx.closePath();
          ctx.fill();
          ctx.stroke();
        }

        // Draw Jittered Raw Data Points (Strip Plot Overlay)
        if (boxState.showJitter) {
          ctx.fillStyle = 'rgba(255, 255, 255, 0.4)';
          s.rawSorted.forEach((v, vIdx) => {
            const valCoord = valToCoord(v);
            // Pseudo-random deterministic jitter
            const pseudoRand = ((Math.sin(vIdx * 997 + idx * 31) + 1) / 2 - 0.5) * (boxThickness * 0.65);
            ctx.beginPath();
            if (isVertical) {
              ctx.arc(slotCenter + pseudoRand, valCoord, 2.5, 0, Math.PI * 2);
            } else {
              ctx.arc(valCoord, slotCenter + pseudoRand, 2.5, 0, Math.PI * 2);
            }
            ctx.fill();
          });
        }

        // Draw Outliers
        if (s.outliers.length > 0) {
          ctx.fillStyle = boxState.outlierColor;
          ctx.strokeStyle = '#ffffff';
          ctx.lineWidth = 1.2;
          s.outliers.forEach(outVal => {
            const outCoord = valToCoord(outVal);
            ctx.beginPath();
            if (isVertical) {
              ctx.arc(slotCenter, outCoord, 4.5, 0, Math.PI * 2);
            } else {
              ctx.arc(outCoord, slotCenter, 4.5, 0, Math.PI * 2);
            }
            ctx.fill();
            ctx.stroke();
          });
        }

        // Record shape for interactive hover tooltip
        boxState.renderedShapes.push({
          slotCenter,
          boxThickness,
          stats: s,
          isVertical,
          q1Coord,
          q3Coord
        });
      });

      // Title & Axis Labels
      ctx.fillStyle = '#e8eef4';
      ctx.font = 'bold 15px "Space Grotesk", sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(boxState.title, w / 2, 28);

      // X Label
      ctx.font = '12px "Space Grotesk", sans-serif';
      ctx.fillStyle = '#a0a0b8';
      ctx.textAlign = 'center';
      ctx.fillText(isVertical ? boxState.xLabel : boxState.yLabel, padding.left + plotWidth / 2, h - 16);

      // Y Label
      ctx.save();
      ctx.translate(18, padding.top + plotHeight / 2);
      ctx.rotate(-Math.PI / 2);
      ctx.textAlign = 'center';
      ctx.fillText(isVertical ? boxState.yLabel : boxState.xLabel, 0, 0);
      ctx.restore();
    };

    function boxAdjustColorOpacity(hex, opacity) {
      hex = hex.replace('#', '');
      if (hex.length === 3) hex = hex.split('').map(c => c + c).join('');
      const r = parseInt(hex.substring(0, 2), 16) || 0;
      const g = parseInt(hex.substring(2, 4), 16) || 0;
      const b = parseInt(hex.substring(4, 6), 16) || 0;
      return `rgba(${r}, ${g}, ${b}, ${opacity})`;
    }

    // Hover Tooltips
    function boxHandleMouseMove(e) {
      if (!canvas || !tooltip) return;
      const rect = canvas.getBoundingClientRect();
      const mouseX = e.clientX - rect.left;
      const mouseY = e.clientY - rect.top;

      let found = null;
      for (let shape of boxState.renderedShapes) {
        if (shape.isVertical) {
          if (Math.abs(mouseX - shape.slotCenter) <= shape.boxThickness / 2 + 10) {
            found = shape.stats;
            break;
          }
        } else {
          if (Math.abs(mouseY - shape.slotCenter) <= shape.boxThickness / 2 + 10) {
            found = shape.stats;
            break;
          }
        }
      }

      if (found) {
        tooltip.innerHTML = `
          <div style="font-weight: 700; color: var(--accent); margin-bottom: 3px;">${found.name} (N=${found.n})</div>
          <div style="color: #e8eef4;">Max: <strong>${found.max.toFixed(2)}</strong></div>
          <div style="color: #a0a0b8;">Q3: <strong>${found.q3.toFixed(2)}</strong></div>
          <div style="color: #ffd93d;">Median: <strong>${found.median.toFixed(2)}</strong></div>
          <div style="color: #a0a0b8;">Q1: <strong>${found.q1.toFixed(2)}</strong></div>
          <div style="color: #e8eef4;">Min: <strong>${found.min.toFixed(2)}</strong></div>
          <div style="color: var(--accent); margin-top: 3px;">IQR: <strong>${found.iqr.toFixed(2)}</strong></div>
          ${found.outliers.length > 0 ? `<div style="color: var(--danger); margin-top: 2px;">Outliers (${found.outliers.length}): ${found.outliers.join(', ')}</div>` : ''}
        `;
        let left = mouseX + 15;
        let top = mouseY - 15;
        if (left + 180 > rect.width) left = mouseX - 180;
        if (top < 10) top = 10;
        tooltip.style.left = left + 'px';
        tooltip.style.top = top + 'px';
        tooltip.classList.add('visible');
      } else {
        tooltip.classList.remove('visible');
      }
    }

    if (canvas) {
      canvas.addEventListener('mousemove', boxHandleMouseMove);
      canvas.addEventListener('mouseleave', () => {
        if (tooltip) tooltip.classList.remove('visible');
      });
    }

    // EXPORTS
    window.boxExportPNG = function() {
      if (!canvas) return;
      const link = document.createElement('a');
      link.download = 'box-plot.png';
      link.href = canvas.toDataURL('image/png');
      link.click();
      boxShowToast('Downloaded PNG chart');
    };

    window.boxExportSVG = function() {
      if (!canvas) return;
      const rect = canvas.getBoundingClientRect();
      const w = Math.round(rect.width);
      const h = Math.round(rect.height || 500);
      const stats = boxState.calculatedStats;
      if (!stats || stats.length === 0) return;

      let svgContent = `<?xml version="1.0" encoding="UTF-8"?>\n`;
      svgContent += `<svg xmlns="http://www.w3.org/2000/svg" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">\n`;
      svgContent += `  <style>\n    text { font-family: 'Space Grotesk', system-ui, sans-serif; }\n    .mono { font-family: 'IBM Plex Mono', monospace; }\n  </style>\n`;
      svgContent += `  <rect width="${w}" height="${h}" fill="#111920"/>\n`;
      svgContent += `  <text x="${w / 2}" y="28" fill="#e8eef4" font-size="16" font-weight="bold" text-anchor="middle">${boxEscapeXML(boxState.title)}</text>\n`;

      // Embed canvas raster image fallback inside SVG for vector compliance
      const dataUrl = canvas.toDataURL('image/png');
      svgContent += `  <image href="${dataUrl}" width="${w}" height="${h}"/>\n`;
      svgContent += `</svg>`;

      const blob = new Blob([svgContent], { type: 'image/svg+xml;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'box-plot.svg';
      link.click();
      URL.revokeObjectURL(url);
      boxShowToast('Downloaded SVG vector chart');
    };

    function boxEscapeXML(str) {
      return (str || '').replace(/[<>&'"]/g, c => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', "'": '&apos;', '"': '&quot;' })[c]);
    }

    window.boxExportPDF = function() {
      if (!canvas) return;
      const dataUrl = canvas.toDataURL('image/jpeg', 0.95);
      const printWin = window.open('', '_blank');
      if (printWin) {
        printWin.document.write(`
          <!DOCTYPE html>
          <html>
            <head>
              <title>${boxEscapeXML(boxState.title)} - DotPlotMaker.com</title>
              <style>
                @page { size: landscape; margin: 1cm; }
                body { font-family: system-ui, sans-serif; background: #fff; color: #111; margin: 0; padding: 20px; }
                h1 { font-size: 20px; margin-bottom: 4px; }
                p.caption { color: #555; font-size: 13px; margin-top: 0; margin-bottom: 16px; font-family: monospace; }
                img { max-width: 100%; border: 1px solid #ccc; border-radius: 6px; }
                .footer { margin-top: 16px; font-size: 11px; color: #777; border-top: 1px solid #eee; padding-top: 8px; }
              </style>
            </head>
            <body>
              <div style="font-size: 22px; font-weight: 700; margin-bottom: 6px;">${boxEscapeXML(boxState.title)}</div>
              <p class="caption">${document.getElementById('box-chart-caption').textContent}</p>
              <img src="${dataUrl}" alt="Box Plot Chart" />
              <div class="footer">Generated free at DotPlotMaker.com/box-plot-maker/ · Client-side privacy guaranteed</div>
              <script>
                window.onload = function() { window.print(); };
              <\/script>
            </body>
          </html>
        `);
        printWin.document.close();
        boxShowToast('Opened PDF print dialog');
      } else {
        boxExportPNG();
      }
    };

    window.boxCopyImageToClipboard = async function() {
      if (!canvas) return;
      try {
        canvas.toBlob(async function(blob) {
          if (!blob) return;
          if (navigator.clipboard && window.ClipboardItem) {
            await navigator.clipboard.write([
              new ClipboardItem({ 'image/png': blob })
            ]);
            boxShowToast('Copied chart image to clipboard!');
          } else {
            boxExportPNG();
          }
        }, 'image/png');
      } catch (err) {
        boxExportPNG();
      }
    };

    function boxShowToast(msg) {
      const toast = document.getElementById('box-toast');
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 2400);
    }

    function boxDebounce(fn, delay) {
      let t;
      return function(...args) {
        clearTimeout(t);
        t = setTimeout(() => fn(...args), delay);
      };
    }

    window.addEventListener('resize', boxDebounce(() => {
      boxUpdatePlot();
    }, 150));

    function boxInit() {
      boxSyncInputsFromState();
      boxRecalculateAll();
      boxUpdatePlot();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boxInit);
    } else {
      setTimeout(boxInit, 50);
    }
  </script>
</section>
