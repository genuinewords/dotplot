---
import { type Locale, defaultLocale } from "@src/i18n/config";
import "@fontsource-variable/space-grotesk";
import ibmPlexMono400Url from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url";
import ibmPlexMono500Url from "@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff2?url";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
---

<section id="histogram-tool" class="dotplot-wrapper hist-wrapper">
  <span id="ibm-plex-mono-urls-hist" data-w400={ibmPlexMono400Url} data-w500={ibmPlexMono500Url} style="display:none" aria-hidden="true"></span>
  
  <style is:inline>
    .hist-wrapper {
      --bg: #0a0f14;
      --bg-elevated: #111920;
      --fg: #e8eef4;
      --muted: #6b7d8f;
      --accent: #00d4aa;
      --accent-dim: rgba(0, 212, 170, 0.15);
      --card: #151d26;
      --border: #243040;
      --danger: #ff6b6b;
      
      font-family: 'Space Grotesk', sans-serif;
      background: var(--bg);
      color: var(--fg);
      position: relative;
      overflow: hidden;
      border-radius: 16px;
      margin: 0 auto;
      max-width: 1200px;
      padding: 2.5rem;
      box-shadow: 0 30px 60px -12px rgba(0, 212, 170, 0.15), 0 0 0 1px rgba(255,255,255,0.1);
    }

    .hist-wrapper * {
      box-sizing: border-box;
    }

    .hist-wrapper .font-mono {
      font-family: 'IBM Plex Mono', monospace;
    }

    /* Background atmosphere */
    .hist-wrapper .bg-atmosphere {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background: 
        radial-gradient(ellipse 80% 50% at 20% 10%, rgba(0, 212, 170, 0.08) 0%, transparent 50%),
        radial-gradient(ellipse 60% 40% at 80% 90%, rgba(139, 92, 246, 0.06) 0%, transparent 50%),
        linear-gradient(180deg, var(--bg) 0%, #0d1318 100%);
    }

    .hist-wrapper .grid-pattern {
      position: absolute;
      inset: 0;
      pointer-events: none;
      z-index: 1;
      opacity: 0.03;
      background-image: 
        linear-gradient(var(--muted) 1px, transparent 1px),
        linear-gradient(90deg, var(--muted) 1px, transparent 1px);
      background-size: 40px 40px;
    }

    /* Custom scrollbar */
    .hist-wrapper ::-webkit-scrollbar { width: 8px; height: 8px; }
    .hist-wrapper ::-webkit-scrollbar-track { background: var(--bg-elevated); }
    .hist-wrapper ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
    .hist-wrapper ::-webkit-scrollbar-thumb:hover { background: var(--muted); }

    /* Focus states */
    .hist-wrapper *:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

    /* Inputs */
    .hist-wrapper .input-field {
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--fg);
      padding: 0.75rem 1rem;
      border-radius: 8px;
      transition: all 0.2s ease;
      width: 100%;
    }
    .hist-wrapper .input-field:hover { border-color: var(--muted); }
    .hist-wrapper .input-field:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-dim);
    }

    /* Buttons */
    .hist-wrapper .btn-primary {
      background: var(--accent);
      color: var(--bg);
      font-weight: 600;
      padding: 0.7rem 1.25rem;
      border-radius: 8px;
      transition: all 0.2s ease;
      border: none;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-size: 0.9rem;
    }
    .hist-wrapper .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(0, 212, 170, 0.3);
    }
    .hist-wrapper .btn-primary:active { transform: translateY(0); }

    .hist-wrapper .btn-secondary {
      background: transparent;
      color: var(--fg);
      font-weight: 500;
      padding: 0.7rem 1.25rem;
      border-radius: 8px;
      transition: all 0.2s ease;
      border: 1px solid var(--border);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      font-size: 0.9rem;
    }
    .hist-wrapper .btn-secondary:hover {
      border-color: var(--muted);
      background: var(--card);
    }

    .hist-wrapper .btn-sm {
      padding: 0.4rem 0.75rem;
      font-size: 0.8rem;
      border-radius: 6px;
    }

    /* Card styles */
    .hist-wrapper .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
    }

    /* Canvas container */
    .hist-wrapper .canvas-container {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      position: relative;
    }

    /* Range slider */
    .hist-wrapper input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      background: var(--border);
      height: 6px;
      border-radius: 3px;
      cursor: pointer;
    }
    .hist-wrapper input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 18px;
      height: 18px;
      background: var(--accent);
      border-radius: 50%;
      cursor: pointer;
      transition: transform 0.2s ease;
    }
    .hist-wrapper input[type="range"]::-webkit-slider-thumb:hover { transform: scale(1.2); }

    /* Color picker wrapper */
    .hist-wrapper .color-picker-wrapper {
      position: relative;
      width: 40px;
      height: 40px;
      border-radius: 8px;
      overflow: hidden;
      border: 2px solid var(--border);
      cursor: pointer;
      transition: border-color 0.2s ease;
      flex-shrink: 0;
    }
    .hist-wrapper .color-picker-wrapper:hover { border-color: var(--muted); }
    .hist-wrapper .color-picker-wrapper input {
      position: absolute;
      inset: -4px;
      width: calc(100% + 8px);
      height: calc(100% + 8px);
      cursor: pointer;
      border: none;
      background: none;
    }

    /* Tabs */
    .hist-wrapper .tab-btn {
      padding: 0.5rem 0.9rem;
      border-radius: 6px;
      font-weight: 500;
      color: var(--muted);
      background: transparent;
      border: none;
      cursor: pointer;
      transition: all 0.2s ease;
      font-size: 0.85rem;
    }
    .hist-wrapper .tab-btn:hover { color: var(--fg); }
    .hist-wrapper .tab-btn.active { background: var(--accent-dim); color: var(--accent); }

    /* Dropdown select */
    .hist-wrapper select.input-field {
      appearance: none;
      background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236b7d8f' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
      background-repeat: no-repeat;
      background-position: right 0.75rem center;
      background-size: 1rem;
      padding-right: 2.25rem;
      cursor: pointer;
    }

    /* Toggle switch */
    .hist-wrapper .toggle-btn {
      width: 44px;
      height: 24px;
      border-radius: 9999px;
      transition: background-color 0.2s ease;
      background: var(--border);
      border: none;
      cursor: pointer;
      position: relative;
      padding: 2px;
      flex-shrink: 0;
    }
    .hist-wrapper .toggle-btn.active {
      background: var(--accent);
    }
    .hist-wrapper .toggle-knob {
      width: 20px;
      height: 20px;
      border-radius: 9999px;
      background: #ffffff;
      transition: transform 0.2s ease;
      transform: translateX(0);
    }
    .hist-wrapper .toggle-btn.active .toggle-knob {
      transform: translateX(20px);
    }

    /* Tooltip */
    .hist-wrapper .tooltip {
      position: absolute;
      background: #19232e;
      border: 1px solid var(--border);
      padding: 0.6rem 0.85rem;
      border-radius: 8px;
      font-size: 0.8rem;
      pointer-events: none;
      opacity: 0;
      transform: translateY(5px);
      transition: opacity 0.15s ease, transform 0.15s ease;
      white-space: nowrap;
      z-index: 100;
      box-shadow: 0 10px 25px rgba(0,0,0,0.4);
    }
    .hist-wrapper .tooltip.visible { opacity: 1; transform: translateY(0); }

    /* Drop area */
    .hist-wrapper .file-dropzone {
      border: 2px dashed var(--border);
      border-radius: 10px;
      padding: 1.5rem 1rem;
      text-align: center;
      cursor: pointer;
      transition: all 0.2s ease;
      background: rgba(255,255,255,0.01);
    }
    .hist-wrapper .file-dropzone:hover,
    .hist-wrapper .file-dropzone.dragover {
      border-color: var(--accent);
      background: var(--accent-dim);
    }

    /* Toast notification */
    .hist-toast {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      background: #111920;
      border: 1px solid var(--accent);
      color: var(--accent);
      padding: 0.75rem 1.25rem;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 500;
      box-shadow: 0 10px 30px rgba(0, 212, 170, 0.2);
      z-index: 9999;
      opacity: 0;
      transform: translateY(10px);
      transition: all 0.25s ease;
      pointer-events: none;
    }
    .hist-toast.show {
      opacity: 1;
      transform: translateY(0);
    }

    @media (max-width: 768px) {
      .hist-wrapper {
        padding: 1.25rem;
      }
    }
  </style>

  <div class="bg-atmosphere"></div>
  <div class="grid-pattern"></div>

  <div class="relative z-10 w-full max-w-7xl mx-auto">
    <!-- Component top bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-4 border-b" style="border-color: var(--border);">
      <div class="flex items-center gap-2">
        <span class="inline-block w-2.5 h-2.5 rounded-full" style="background: var(--accent);"></span>
        <span class="text-xs font-semibold tracking-wider uppercase" style="color: var(--accent);">Interactive Histogram Engine</span>
        <span class="text-xs px-2 py-0.5 rounded" style="background: rgba(255,255,255,0.05); color: var(--muted);">100% Client-Side</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-xs" style="color: var(--muted);">Presets:</span>
        <button type="button" class="btn-secondary btn-sm" onclick="histLoadPreset('exams')">Exam Scores</button>
        <button type="button" class="btn-secondary btn-sm" onclick="histLoadPreset('heights')">Heights</button>
        <button type="button" class="btn-secondary btn-sm" onclick="histLoadPreset('response')">Response Times</button>
      </div>
    </div>

    <!-- Main Grid: Left Controls (1 col) + Right Chart & Data (2 cols) -->
    <div class="grid lg:grid-cols-3 gap-6">
      
      <!-- Left Panel: Data & Bin Controls -->
      <div class="lg:col-span-1 space-y-6">
        
        <!-- Data Input Card -->
        <div class="card text-left">
          <div class="flex items-center justify-between mb-4">
            <h2 class="font-semibold text-base" style="color: var(--fg);">Data Input</h2>
            <div class="flex gap-1">
              <button type="button" class="tab-btn active" data-tab="paste" onclick="switchHistTab('paste')">Paste</button>
              <button type="button" class="tab-btn" data-tab="manual" onclick="switchHistTab('manual')">Grid</button>
              <button type="button" class="tab-btn" data-tab="upload" onclick="switchHistTab('upload')">CSV File</button>
            </div>
          </div>

          <!-- Paste Tab -->
          <div id="hist-tab-paste">
            <label for="hist-paste-input" class="block text-xs mb-2" style="color: var(--muted);">
              Paste numbers (separated by comma, space, or newline):
            </label>
            <textarea 
              id="hist-paste-input"
              class="input-field font-mono text-xs resize-none"
              rows="6"
              placeholder="72, 75, 78, 82, 85, 88, 90, 92..."
            ></textarea>
            <div class="flex gap-2 mt-3">
              <button type="button" onclick="histParseDataFromPaste()" class="btn-primary w-full">
                Render Histogram
              </button>
              <button type="button" onclick="histClearData()" class="btn-secondary" title="Clear data">
                Clear
              </button>
            </div>
          </div>

          <!-- Manual / Grid Tab -->
          <div id="hist-tab-manual" class="hidden">
            <label for="hist-manual-input" class="block text-xs mb-2" style="color: var(--muted);">
              Manual entry / comma-separated values:
            </label>
            <input 
              type="text" 
              id="hist-manual-input" 
              class="input-field font-mono text-xs mb-3" 
              placeholder="e.g. 10, 15, 20, 25, 30"
            />
            <div class="flex items-center justify-between text-xs mb-2" style="color: var(--muted);">
              <span>Sample Points Editor:</span>
              <span id="hist-manual-count">0 items</span>
            </div>
            <div id="hist-manual-tags" class="flex flex-wrap gap-1 max-h-36 overflow-y-auto p-2 rounded mb-3" style="background: var(--bg); border: 1px solid var(--border);">
              <!-- Rendered data points with quick remove -->
            </div>
            <button type="button" onclick="histAddManualValues()" class="btn-primary w-full">
              Update Values
            </button>
          </div>

          <!-- File Upload Tab -->
          <div id="hist-tab-upload" class="hidden">
            <div 
              id="hist-dropzone" 
              class="file-dropzone"
              onclick="document.getElementById('hist-file-input').click()"
            >
              <svg class="mx-auto mb-2" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" style="color: var(--accent);">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="17 8 12 3 7 8"></polyline>
                <line x1="12" y1="3" x2="12" y2="15"></line>
              </svg>
              <p class="text-xs font-medium mb-1" style="color: var(--fg);">Click to upload or drag & drop</p>
              <p class="text-xs" style="color: var(--muted);">CSV, TSV, or spreadsheet data file</p>
            </div>
            <input 
              type="file" 
              id="hist-file-input" 
              accept=".csv,.txt,.tsv,.tsv,.tab" 
              class="hidden" 
              onchange="histHandleFileUpload(event)"
            />
            <div id="hist-upload-status" class="text-xs mt-2 text-center" style="color: var(--accent);"></div>
          </div>
        </div>

        <!-- Bin Controls Card (The core feature) -->
        <div class="card text-left">
          <div class="flex items-center justify-between mb-4">
            <h2 class="font-semibold text-base" style="color: var(--fg);">Bin Controls</h2>
            <span class="text-xs font-mono px-2 py-0.5 rounded" style="background: var(--accent-dim); color: var(--accent);">Key Feature</span>
          </div>

          <!-- Mode Selector -->
          <div class="mb-4">
            <label for="hist-bin-mode" class="block text-xs mb-1.5" style="color: var(--muted);">Calculation Mode</label>
            <select id="hist-bin-mode" class="input-field text-sm" onchange="histChangeBinMode(this.value)">
              <option value="auto">Auto (Statistical Rules)</option>
              <option value="count">Fixed Number of Bins</option>
              <option value="width">Custom Bin Width</option>
            </select>
          </div>

          <!-- Auto Rule Dropdown -->
          <div id="hist-auto-rule-container" class="mb-4">
            <label for="hist-auto-rule" class="block text-xs mb-1.5" style="color: var(--muted);">Auto Rule Algorithm</label>
            <select id="hist-auto-rule" class="input-field text-sm" onchange="histChangeAutoRule(this.value)">
              <option value="sturges">Sturges' Rule (Small-to-medium data)</option>
              <option value="fd">Freedman–Diaconis (Robust to outliers / IQR)</option>
              <option value="scott">Scott's Rule (Variance & smooth data)</option>
              <option value="sqrt">Square-Root Rule (Fast standard)</option>
            </select>
          </div>

          <!-- Interactive Slider for Bin Count -->
          <div class="mb-4">
            <div class="flex items-center justify-between text-xs mb-1.5">
              <label for="hist-bin-slider" style="color: var(--muted);">Number of Bins</label>
              <span id="hist-bin-slider-val" class="font-mono font-semibold" style="color: var(--accent);">10</span>
            </div>
            <input 
              type="range" 
              id="hist-bin-slider" 
              min="2" 
              max="40" 
              value="10" 
              class="w-full"
              oninput="histOnSliderInput(this.value)"
            />
            <div class="flex justify-between text-2xs mt-1 font-mono" style="color: var(--muted); font-size: 0.7rem;">
              <span>2 (Coarse)</span>
              <span>20</span>
              <span>40 (Granular)</span>
            </div>
          </div>

          <!-- Custom Bin Width Input (shown in Width mode) -->
          <div id="hist-bin-width-container" class="mb-4 hidden">
            <label for="hist-bin-width-input" class="block text-xs mb-1.5" style="color: var(--muted);">Bin Width Size</label>
            <div class="flex items-center gap-2">
              <input 
                type="number" 
                id="hist-bin-width-input" 
                step="any" 
                min="0.001" 
                class="input-field font-mono text-sm" 
                placeholder="e.g. 5"
                oninput="histOnWidthInput(this.value)"
              />
              <button type="button" class="btn-secondary btn-sm" onclick="histApplyBinWidth()">Apply</button>
            </div>
          </div>
        </div>

        <!-- Customization Card -->
        <div class="card text-left">
          <h2 class="font-semibold text-base mb-4" style="color: var(--fg);">Chart Customization</h2>
          
          <div class="space-y-4">
            <!-- Colors & Opacity -->
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="hist-bar-color" class="block text-xs mb-1.5" style="color: var(--muted);">Bar Fill</label>
                <div class="flex items-center gap-2">
                  <div class="color-picker-wrapper">
                    <input type="color" id="hist-bar-color" value="#00d4aa" onchange="histUpdatePlot()">
                  </div>
                  <span id="hist-bar-color-hex" class="font-mono text-xs" style="color: var(--muted);">#00d4aa</span>
                </div>
              </div>
              <div>
                <label for="hist-edge-color" class="block text-xs mb-1.5" style="color: var(--muted);">Bar Edge</label>
                <div class="flex items-center gap-2">
                  <div class="color-picker-wrapper">
                    <input type="color" id="hist-edge-color" value="#111920" onchange="histUpdatePlot()">
                  </div>
                  <span id="hist-edge-color-hex" class="font-mono text-xs" style="color: var(--muted);">#111920</span>
                </div>
              </div>
            </div>

            <!-- Opacity -->
            <div>
              <div class="flex items-center justify-between text-xs mb-1.5">
                <label for="hist-opacity" style="color: var(--muted);">Bar Opacity</label>
                <span id="hist-opacity-val" class="font-mono" style="color: var(--accent);">0.85</span>
              </div>
              <input 
                type="range" 
                id="hist-opacity" 
                min="0.1" 
                max="1.0" 
                step="0.05" 
                value="0.85" 
                class="w-full"
                oninput="histOnOpacityInput(this.value)"
              />
            </div>

            <!-- Orientation -->
            <div class="flex items-center justify-between pt-1">
              <span class="text-xs" style="color: var(--muted);">Orientation</span>
              <div class="flex gap-1 p-0.5 rounded" style="background: var(--bg); border: 1px solid var(--border);">
                <button 
                  type="button" 
                  id="hist-orient-vert" 
                  class="tab-btn active text-xs px-2.5 py-1" 
                  onclick="histSetOrientation('vertical')"
                >Vertical</button>
                <button 
                  type="button" 
                  id="hist-orient-horiz" 
                  class="tab-btn text-xs px-2.5 py-1" 
                  onclick="histSetOrientation('horizontal')"
                >Horizontal</button>
              </div>
            </div>

            <!-- Titles & Labels -->
            <div class="space-y-2 pt-1 border-t" style="border-color: var(--border);">
              <div>
                <label for="hist-chart-title" class="block text-xs mb-1" style="color: var(--muted);">Chart Title</label>
                <input type="text" id="hist-chart-title" class="input-field text-xs py-1.5" value="Data Distribution Histogram" oninput="histUpdatePlot()">
              </div>
              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label for="hist-x-label" class="block text-xs mb-1" style="color: var(--muted);">X-Axis Label</label>
                  <input type="text" id="hist-x-label" class="input-field text-xs py-1.5" value="Value Range" oninput="histUpdatePlot()">
                </div>
                <div>
                  <label for="hist-y-label" class="block text-xs mb-1" style="color: var(--muted);">Y-Axis Label</label>
                  <input type="text" id="hist-y-label" class="input-field text-xs py-1.5" value="Frequency" oninput="histUpdatePlot()">
                </div>
              </div>
            </div>

            <!-- Toggles -->
            <div class="space-y-2.5 pt-2 border-t" style="border-color: var(--border);">
              <div class="flex items-center justify-between">
                <span class="text-xs" style="color: var(--muted);">Gridlines</span>
                <button type="button" id="hist-toggle-grid" class="toggle-btn active" onclick="histToggleFeature('grid')" aria-label="Toggle Gridlines">
                  <div class="toggle-knob"></div>
                </button>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs" style="color: var(--muted);">Frequency Labels on Bars</span>
                <button type="button" id="hist-toggle-labels" class="toggle-btn active" onclick="histToggleFeature('labels')" aria-label="Toggle Bar Labels">
                  <div class="toggle-knob"></div>
                </button>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs" style="color: var(--muted);">Normal Curve Overlay</span>
                <button type="button" id="hist-toggle-curve" class="toggle-btn" onclick="histToggleFeature('curve')" aria-label="Toggle Normal Curve">
                  <div class="toggle-knob"></div>
                </button>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-xs" style="color: var(--muted);">Mean & Median Reference Lines</span>
                <button type="button" id="hist-toggle-lines" class="toggle-btn" onclick="histToggleFeature('lines')" aria-label="Toggle Mean & Median Lines">
                  <div class="toggle-knob"></div>
                </button>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Panel: Chart Visualizer & Frequency Table -->
      <div class="lg:col-span-2 space-y-4">
        
        <!-- Header Toolbar Above Canvas -->
        <div class="flex items-center justify-between flex-wrap gap-2.5">
          <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full" style="background: var(--accent);"></span>
            <span class="text-xs font-semibold uppercase tracking-wider font-mono" style="color: var(--muted);">Live Chart Preview</span>
          </div>
          <div class="flex items-center gap-2 flex-wrap">
            <button type="button" onclick="histCopyImageToClipboard()" class="btn-secondary btn-sm" title="Copy high-res image to clipboard">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span>Copy</span>
            </button>
            <button type="button" onclick="histExportPNG()" class="btn-primary btn-sm" title="Download High-Resolution PNG">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
              <span>PNG</span>
            </button>
            <button type="button" onclick="histExportSVG()" class="btn-secondary btn-sm" title="Download Scalable Vector SVG">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                <polyline points="7 10 12 15 17 10"></polyline>
                <line x1="12" y1="15" x2="12" y2="3"></line>
