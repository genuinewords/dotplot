---
import siteConfig from "@src/config/site.json";

const emailAddress = siteConfig.contactEmail || "contact@dotplotmaker.com";
---

<div class="contact-wrapper">
  <!-- Direct Contact Card -->
  <div class="direct-contact-card glass-card">
    <div class="contact-icon-bubble">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="4" width="20" height="16" rx="2"/>
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
      </svg>
    </div>
    <div class="direct-contact-details">
      <h2>Email Us Directly</h2>
      <p>We provide email-only support for student inquiries, educator feedback, bug reports, and partnership requests:</p>
      <div class="email-action-row">
        <a href={`mailto:${emailAddress}`} class="email-display-link" id="email-link">
          {emailAddress}
        </a>
        <button type="button" class="btn-copy-email" id="btn-copy-email" aria-label="Copy email address to clipboard">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <span id="copy-btn-text">Copy Email</span>
        </button>
      </div>
      <p class="direct-note">We typically reply within 24–48 business hours.</p>
    </div>
  </div>

  <!-- Interactive Compose Form -->
  <div class="form-container glass-card">
    <h2>Send a Message</h2>
    <p class="form-intro">
      Fill out the fields below to prepare a message to <strong>{emailAddress}</strong>. Submitting will open your default email application with your details prefilled.
    </p>

    <form id="contact-form" class="contact-form">
      <div class="form-row">
        <div class="form-group">
          <label for="contact-name" class="form-label">Your Name <span class="required">*</span></label>
          <input type="text" id="contact-name" name="name" class="form-input" placeholder="e.g., Alex Morgan" required />
        </div>
        <div class="form-group">
          <label for="contact-email" class="form-label">Your Email <span class="required">*</span></label>
          <input type="email" id="contact-email" name="email" class="form-input" placeholder="e.g., alex@example.com" required />
        </div>
      </div>

      <div class="form-group">
        <label for="contact-subject" class="form-label">Topic / Subject <span class="required">*</span></label>
        <select id="contact-subject" name="subject" class="form-input form-select" required>
          <option value="General Inquiry">General Inquiry</option>
          <option value="Bug Report / Issue with Chart Tool">Bug Report / Chart Tool Issue</option>
          <option value="Feature Suggestion">Feature Suggestion</option>
          <option value="Classroom / Educational Use">Classroom / Educational Use</option>
          <option value="Privacy / Data Policy Question">Privacy / Data Policy Question</option>
        </select>
      </div>

      <div class="form-group">
        <label for="contact-message" class="form-label">Your Message <span class="required">*</span></label>
        <textarea id="contact-message" name="message" class="form-input" rows="6" placeholder="Please describe your question, bug report, or feedback in detail..." required></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" id="contact-submit" class="btn-primary">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
          <span>Open in Email App</span>
        </button>

        <div class="webmail-shortcuts">
          <span class="webmail-label">Using Webmail?</span>
          <a href={`https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(emailAddress)}`} target="_blank" rel="noopener noreferrer" class="webmail-btn">Gmail</a>
          <a href={`https://outlook.live.com/mail/0/deeplink/compose?to=${encodeURIComponent(emailAddress)}`} target="_blank" rel="noopener noreferrer" class="webmail-btn">Outlook</a>
        </div>
      </div>

      <div id="contact-status" class="contact-status" aria-live="polite"></div>
    </form>
  </div>
</div>

<style>
  .contact-wrapper {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 800px;
  }
  .direct-contact-card {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    padding: 2rem;
    background: rgba(0, 212, 170, 0.04);
    border-color: rgba(0, 212, 170, 0.25);
  }
  .direct-contact-card:hover {
    transform: none;
  }
  .contact-icon-bubble {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: rgba(0, 212, 170, 0.15);
    color: var(--color-primary);
    flex-shrink: 0;
  }
  .direct-contact-details h2 {
    font-size: 1.35rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }
  .direct-contact-details p {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .email-action-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 0.75rem 0;
  }
  .email-display-link {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .email-display-link:hover {
    color: var(--color-primary-light);
  }
  .btn-copy-email {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    padding: 0.4rem 0.85rem;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .btn-copy-email:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .direct-note {
    font-size: 0.85rem !important;
    color: var(--color-text-muted) !important;
    margin-bottom: 0 !important;
  }
  .form-container {
    padding: 2.25rem;
  }
  .form-container:hover {
    transform: none;
  }
  .form-container h2 {
    font-size: 1.4rem;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }
  .form-intro {
    color: var(--color-text-secondary);
    font-size: 0.92rem;
    line-height: 1.65;
    margin-bottom: 1.75rem;
  }
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 600px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .form-label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-secondary);
  }
  .required {
    color: var(--color-primary);
  }
  .form-select {
    cursor: pointer;
    background-color: var(--color-bg-secondary);
  }
  .form-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }
  .webmail-shortcuts {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
  .webmail-label {
    font-size: 0.82rem;
  }
  .webmail-btn {
    display: inline-block;
    padding: 0.35rem 0.75rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    font-size: 0.82rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .webmail-btn:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    background: rgba(0, 212, 170, 0.08);
  }
  .contact-status {
    font-size: 0.9rem;
    line-height: 1.6;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    display: none;
  }
  .contact-status.info {
    display: block;
    background: rgba(0, 212, 170, 0.1);
    border: 1px solid rgba(0, 212, 170, 0.3);
    color: var(--color-primary-light);
  }
  @media (max-width: 600px) {
    .direct-contact-card {
      flex-direction: column;
      padding: 1.5rem;
    }
    .form-container {
      padding: 1.5rem;
    }
    .form-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .webmail-shortcuts {
      justify-content: center;
    }
  }
</style>

<script define:vars={{ targetEmail: emailAddress }}>
  // Copy Email button logic
  const copyBtn = document.getElementById("btn-copy-email");
  const copyBtnText = document.getElementById("copy-btn-text");

  copyBtn?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(targetEmail);
      if (copyBtnText) copyBtnText.textContent = "Copied!";
      setTimeout(() => {
        if (copyBtnText) copyBtnText.textContent = "Copy Email";
      }, 3000);
    } catch {
      // Fallback
      const tempInput = document.createElement("input");
      tempInput.value = targetEmail;
      document.body.appendChild(tempInput);
      tempInput.select();
      document.execCommand("copy");
      document.body.removeChild(tempInput);
      if (copyBtnText) copyBtnText.textContent = "Copied!";
      setTimeout(() => {
        if (copyBtnText) copyBtnText.textContent = "Copy Email";
      }, 3000);
    }
  });

  // Mailto formulation on form submit
  const form = document.getElementById("contact-form");
  const statusEl = document.getElementById("contact-status");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    const name = document.getElementById("contact-name")?.value.trim() || "";
    const email = document.getElementById("contact-email")?.value.trim() || "";
    const topic = document.getElementById("contact-subject")?.value || "Inquiry";
    const message = document.getElementById("contact-message")?.value.trim() || "";

    const emailSubject = `[Dot Plot Maker] ${topic} - from ${name}`;
    const emailBody = `Sender Name: ${name}\nSender Email: ${email}\nTopic: ${topic}\n\nMessage:\n${message}\n\n---\nSent via DotPlotMaker.com contact form`;

    const mailtoUrl = `mailto:${encodeURIComponent(targetEmail)}?subject=${encodeURIComponent(emailSubject)}&body=${encodeURIComponent(emailBody)}`;

    if (statusEl) {
      statusEl.className = "contact-status info";
      statusEl.textContent = `Opening your email application to send to ${targetEmail}... If your email client does not open, please write to ${targetEmail} directly.`;
    }

    window.location.href = mailtoUrl;
  });
</script>
