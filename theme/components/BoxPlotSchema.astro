---
import siteConfig from "@src/config/site.json";

interface Props {
  faqs: { question: string; answer: string }[];
}

const { faqs } = Astro.props;

const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Free Box Plot Maker",
  applicationCategory: "WebApplication",
  operatingSystem: "Web",
  url: `${siteConfig.siteUrl}/box-plot-maker/`,
  description: "Free online box plot (box and whisker plot) maker with multi-group comparison, automated 1.5x IQR outlier detection, five-number summaries, and instant PNG, SVG, and PDF exports.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    description: "100% free to use — no signup required",
  },
  featureList: [
    "Interactive side-by-side multi-group box and whisker plots",
    "Two-column group, value paste straight from Excel and CSV uploads",
    "Automated five-number summary: min, Q1, median, Q3, max, and IQR",
    "Tukey outlier detection with Standard (1.5x IQR), Extreme (3x IQR), and Off modes",
    "Quartile calculation via linear interpolation (Type 7 — matching Excel QUARTILE.INC and R)",
    "Customizable box colors, median lines, mean diamonds, confidence notches, and jittered points",
    "High-resolution PNG, lossless scalable SVG, and printable PDF exports",
    "One-click copy statistics table as plain text to clipboard",
    "100% client-side data privacy — zero server tracking or storage",
  ].join("\n"),
  screenshot: `${siteConfig.siteUrl}${siteConfig.metaImage}`,
  author: {
    "@type": "Organization",
    name: siteConfig.legalName,
    url: siteConfig.siteUrl,
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "How to Make a Box Plot Online in 3 Steps",
  description: "Create a publication-ready box and whisker plot online in three simple steps: enter your data, compare groups with outlier detection, and customize your chart for export.",
  step: [
    {
      "@type": "HowToStep",
      name: "Step 1: Enter or Upload Your Data",
      text: "Paste single or multi-group numbers separated by commas, spaces, or lines. You can also paste two-column Excel data (group, value) or upload a CSV file directly.",
      url: `${siteConfig.siteUrl}/box-plot-maker/#step-1`,
    },
    {
      "@type": "HowToStep",
      name: "Step 2: Compare Groups & Detect Outliers",
      text: "Inspect side-by-side box plots for multiple groups and adjust the Tukey outlier threshold between Standard (1.5x IQR), Extreme (3x IQR), or Off.",
      url: `${siteConfig.siteUrl}/box-plot-maker/#step-2`,
    },
    {
      "@type": "HowToStep",
      name: "Step 3: Customize Styling and Export",
      text: "Personalize box and median colors, toggle mean diamonds, confidence notches, and jittered data points, then export high-DPI PNG, vector SVG, or PDF graphics.",
      url: `${siteConfig.siteUrl}/box-plot-maker/#step-3`,
    },
  ],
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
