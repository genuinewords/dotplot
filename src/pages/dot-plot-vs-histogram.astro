---
import BaseLayout from "@theme/layouts/BaseLayout.astro";
import { defaultLocale } from "@src/i18n/config";
import siteConfig from "@src/config/site.json";

const locale = defaultLocale;

const pageTitle = "Dot Plot vs Histogram: Differences & When to Use Each";
const pageDescription = "Dot plot vs histogram — learn the key differences, see the same data in both charts, and pick the right one in 30 seconds. Try both free tools.";

const canonicalUrl = `${siteConfig.siteUrl}/dot-plot-vs-histogram/`;

const faqs = [
  {
    question: "What is the main difference between a dot plot and a histogram?",
    answer: "A dot plot displays each individual observation as a distinct dot on a number line, preserving all original values. A histogram groups data into adjacent, non-overlapping intervals (bins) and shows frequency through bar height, sacrificing individual values for scalability."
  },
  {
    question: "When should I choose a dot plot over a histogram?",
    answer: "Choose a dot plot for small datasets (typically under 100 observations) where you need to see every data point, identify exact duplicates, spot subtle gaps, or teach basic distribution concepts."
  },
  {
    question: "When is a histogram better than a dot plot?",
    answer: "A histogram is better when analyzing large datasets with hundreds or thousands of observations. At that scale, a dot plot becomes an unreadable cloud of overlapping marks, whereas a histogram provides a clean summary of distribution shape, center, and spread."
  },
  {
    question: "Can you determine exact values from a histogram?",
    answer: "No. A histogram only tells you how many observations fall within each interval, not what the specific numbers are. If a bin spanning 70–80 has a count of 12, you cannot tell whether those values are all 71 or evenly distributed."
  },
  {
    question: "What sample size is best for a dot plot?",
    answer: "Dot plots work best with sample sizes between 15 and 80 observations. Datasets with fewer than 10 points show little pattern, while datasets exceeding 150 points cause excessive vertical stacking and visual crowding."
  },
  {
    question: "How does bin width affect a histogram?",
    answer: "Bin width dramatically influences the perceived shape of a histogram. Choosing too few bins over-smoothes the data and hides underlying features, while too many bins fragments the distribution into jagged, noisy spikes. Statistical formulas like Sturges or Freedman–Diaconis help select optimal bin widths."
  },
  {
    question: "Can both charts show outliers?",
    answer: "Yes, but they display them differently. On a dot plot, an outlier appears as a solitary dot separated by wide empty space. On a histogram, an outlier appears as an isolated bar separated from the main distribution by empty bins."
  },
  {
    question: "How do dot plots and histograms show distribution shape?",
    answer: "Both charts show shape through vertical height along a horizontal axis. Taller stacks of dots and higher bars indicate peaks (modes), while asymmetric tails trailing left or right reveal skewness."
  },
  {
    question: "What is the difference between a histogram and a bar chart?",
    answer: "Histograms display continuous numerical data with touching bars representing intervals. Bar charts display discrete categorical variables (like countries or colors) with visible gaps between bars to emphasize separate categories."
  },
  {
    question: "How do I compare multiple groups using these charts?",
    answer: "For two small groups, back-to-back stem-and-leaf plots or multi-row dot plots work well. For three or more groups, parallel side-by-side box plots are the standard choice because overlaid histograms quickly become cluttered and difficult to read."
  },
  {
    question: "Are there free online tools to create both charts?",
    answer: "Yes. DotPlotMaker.com provides 100% free, client-side tools to create publication-ready dot plots, histograms, box plots, and stem-and-leaf plots with zero signups or watermarks."
  }
];

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "Dot Plot vs Histogram: What's the Difference?",
  description: pageDescription,
  url: canonicalUrl,
  datePublished: "2025-04-10T08:00:00Z",
  dateModified: "2026-10-12T16:00:00Z",
  author: {
    "@type": "Organization",
    name: siteConfig.author,
    url: siteConfig.siteUrl
  },
  publisher: {
    "@type": "Organization",
    name: siteConfig.siteName,
    logo: {
      "@type": "ImageObject",
      url: `${siteConfig.siteUrl}/favicon.svg`
    }
  },
  mainEntityOfPage: canonicalUrl
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(faq => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer
    }
  }))
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: `${siteConfig.siteUrl}/`
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Dot Plot vs Histogram",
      item: canonicalUrl
    }
  ]
};
---

<BaseLayout locale={locale} title={pageTitle} description={pageDescription} canonicalUrl={canonicalUrl} ogType="article">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <article class="page-content article-container">
    
    <!-- Hero / Header -->
    <header class="article-hero animate-fade-in-up" style="opacity: 0;">
      <div style="display: flex; align-items: center; justify-content: center; gap: 0.75rem; margin-bottom: 1.25rem;">
        <span class="badge">Data Visualization Guide</span>
        <span style="color: var(--color-text-muted); font-size: 0.88rem;">Updated October 2026</span>
      </div>
      <h1 class="article-title">Dot Plot vs Histogram: What's the Difference?</h1>
      <p class="article-subtitle">
        Choosing between a dot plot and a histogram comes down to a fundamental trade-off: do you need to inspect every individual value, or do you need a scalable summary of your entire distribution? Here is everything you need to pick the right chart in seconds.
      </p>
    </header>

    <!-- ══════════════════════════════════════════════════════════════
         SECTION 1: THE 30-SECOND ANSWER (HIGHLIGHTED SNIPPET BOX)
         ══════════════════════════════════════════════════════════════ -->
    <section class="snippet-box" aria-label="Quick Summary">
      <div class="snippet-header">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>The 30-Second Answer</span>
      </div>
      <p class="snippet-content">
        Use a <strong>dot plot</strong> for small datasets (under 100 points) where every exact value, duplicate count, and individual observation matters. Use a <strong>histogram</strong> for larger continuous datasets where interval bins group numbers to keep the overall distribution shape readable. The fundamental trade-off is precision versus scalability: dot plots preserve every data point, while histograms summarize large volumes of data cleanly.
      </p>
    </section>

    <!-- Main Prose Body -->
    <div class="article-body">

      <!-- ══════════════════════════════════════════════════════════════
           SECTION 2: SIDE-BY-SIDE COMPARISON TABLE
           ══════════════════════════════════════════════════════════════ -->
      <section id="comparison-table" style="margin-top: 3.5rem;">
        <h2 class="content-h2">Side-by-Side Comparison</h2>
        <p style="color: var(--color-text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
          While both charts illustrate how numerical observations distribute along a continuous number line, their internal mechanics, data capacity, and display formats differ significantly:
        </p>

        <div class="table-wrapper">
          <table class="comparison-table">
            <thead>
              <tr>
                <th style="width: 25%;">Feature</th>
                <th style="width: 37.5%; color: var(--color-primary);">
                  <a href="/" style="color: var(--color-primary); text-decoration: underline;">Dot Plot</a>
                </th>
                <th style="width: 37.5%; color: #4d96ff;">
                  <a href="/histogram-maker/" style="color: #4d96ff; text-decoration: underline;">Histogram</a>
                </th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>What each mark represents</strong></td>
                <td>A single individual data point or observation.</td>
                <td>The total frequency count of values falling inside an interval bin.</td>
              </tr>
              <tr>
                <td><strong>Recommended dataset size</strong></td>
                <td>Small to moderate ($N &lt; 50$ to $100$ observations).</td>
                <td>Moderate to large ($N = 100$ to $10,000+$ observations).</td>
              </tr>
              <tr>
                <td><strong>Exact values visible?</strong></td>
                <td><strong>Yes</strong> — every original number can be read and counted directly.</td>
                <td><strong>No</strong> — individual numbers are grouped into anonymous ranges.</td>
              </tr>
              <tr>
                <td><strong>Binning required?</strong></td>
                <td>No — dots sit directly on the exact continuous axis scale.</td>
                <td><strong>Yes</strong> — user or algorithm must define bin widths and counts.</td>
              </tr>
              <tr>
                <td><strong>Best for</strong></td>
                <td>Classroom teaching, inspecting ties, clinical trials, small quality checks.</td>
                <td>Evaluating sample normality, large survey distributions, big data modeling.</td>
              </tr>
              <tr>
                <td><strong>Main weakness</strong></td>
                <td>Clutters quickly; severe overplotting with hundreds of points.</td>
                <td>Visual shape is sensitive to bin width choices; individual data is lost.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ══════════════════════════════════════════════════════════════
           SECTION 3: DECISION GUIDE (FLOWCHART-STYLE LIST)
           ══════════════════════════════════════════════════════════════ -->
      <section id="decision-guide" style="margin-top: 4rem;">
        <h2 class="content-h2">Which Should I Use? (Quick Decision Guide)</h2>
        <p style="color: var(--color-text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
          To determine the right visualization for your dataset immediately, find your scenario below:
        </p>

        <div class="decision-grid">
          <div class="decision-card">
            <div class="decision-tag" style="background: rgba(0, 212, 170, 0.1); color: var(--color-primary);">Small Data (&lt; 100 Values)</div>
            <h3 class="decision-title">You have fewer than 100 observations</h3>
            <p class="decision-desc">
              When working with classroom exam scores, small survey samples, or pilot laboratory measurements, you want readers to inspect every data point.
            </p>
            <div class="decision-action">
              <span>Recommended Tool:</span>
              <a href="/" class="decision-link">Use the Free Dot Plot Maker →</a>
            </div>
          </div>

          <div class="decision-card">
            <div class="decision-tag" style="background: rgba(77, 150, 255, 0.1); color: #4d96ff;">Large Data (100s to 1,000s)</div>
            <h3 class="decision-title">You have hundreds or thousands of observations</h3>
            <p class="decision-desc">
              Plotting 500 dots on a number line creates an unreadable blob. A histogram groups these observations into neat bins so you can instantly evaluate skewness and modality.
            </p>
            <div class="decision-action">
              <span>Recommended Tool:</span>
              <a href="/histogram-maker/" class="decision-link" style="color: #4d96ff;">Use the Free Histogram Maker →</a>
            </div>
          </div>

          <div class="decision-card">
            <div class="decision-tag" style="background: rgba(139, 92, 246, 0.1); color: var(--color-accent);">Comparing Multiple Groups</div>
            <h3 class="decision-title">You need to compare 3 or more groups</h3>
            <p class="decision-desc">
              Overlapping three histograms creates visual chaos. Parallel box plots communicate five-number summaries (median, quartiles, and Tukey outliers) cleanly in compact rows.
            </p>
            <div class="decision-action">
              <span>Recommended Tool:</span>
              <a href="/box-plot-maker/" class="decision-link" style="color: var(--color-accent);">Use the Free Box Plot Maker →</a>
            </div>
          </div>

          <div class="decision-card">
            <div class="decision-tag" style="background: rgba(245, 158, 11, 0.1); color: var(--color-warning);">Worksheets & Exact Digits</div>
            <h3 class="decision-title">You need exact digits organized in a table</h3>
            <p class="decision-desc">
              When creating classroom handouts, worksheets, or tests where students need to calculate medians from ordered digits, a stem-and-leaf plot is the classic choice.
            </p>
            <div class="decision-action">
              <span>Recommended Tool:</span>
              <a href="/stem-and-leaf-plot-maker/" class="decision-link" style="color: var(--color-warning);">Use the Stem-and-Leaf Maker →</a>
            </div>
          </div>
        </div>
      </section>

      <!-- ══════════════════════════════════════════════════════════════
           MONETIZATION UNIT 1: MID-ARTICLE AD
           ══════════════════════════════════════════════════════════════ -->
      <div class="ad-unit" aria-label="Advertisement">
        <span class="ad-label">Advertisement</span>
        <div class="ad-box">
          <span style="font-size: 0.85rem; color: var(--color-text-muted);">Interactive Data Tools & Statistical Solutions</span>
        </div>
      </div>

      <!-- ══════════════════════════════════════════════════════════════
           SECTION 4: THE SAME DATA, BOTH WAYS (SIDE-BY-SIDE VISUAL)
           ══════════════════════════════════════════════════════════════ -->
      <section id="the-same-data" style="margin-top: 4rem;">
        <h2 class="content-h2">The Same Data, Both Ways: A Side-by-Side Experiment</h2>
        <p style="color: var(--color-text-secondary); line-height: 1.7; margin-bottom: 1.5rem;">
          To understand how these two chart types transform your perception, consider a single real-world dataset: <strong>40 student exam scores</strong> ranging from 54 to 100:
        </p>

        <div style="background: var(--color-bg-elevated); border: 1px solid var(--color-border); border-radius: 8px; padding: 1rem; font-family: 'IBM Plex Mono', monospace; font-size: 0.82rem; color: var(--color-text-muted); margin-bottom: 2rem; overflow-x: auto;">
          54, 58, 62, 65, 65, 68, 70, 70, 72, 72, 72, 74, 75, 75, 78, 78, 80, 80, 80, 80, 82, 82, 84, 85, 85, 85, 88, 88, 90, 90, 92, 92, 94, 95, 95, 96, 98, 98, 100, 100
        </div>

        <!-- Visual Side-by-Side Graphic (SVG) -->
        <div class="chart-comparison-graphic">
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
            
            <!-- Graphic 1: Dot Plot -->
            <div style="background: #0d141d; border: 1px solid var(--color-border); border-radius: 12px; padding: 1.25rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span style="font-weight: 700; color: var(--color-primary); font-size: 0.95rem;">Dot Plot View (N=40)</span>
                <span style="font-size: 0.75rem; color: var(--color-text-muted); font-family: 'IBM Plex Mono', monospace;">Individual Dots</span>
              </div>
              <svg class="dotplot-svg" viewBox="0 0 400 200" width="100%" height="auto" role="img" aria-label="Dot plot of 40 exam scores showing stacked circles for repeated values.">
                <rect width="400" height="200" fill="#0d141d" rx="8"/>
                <!-- Axis -->
                <line x1="30" y1="160" x2="370" y2="160" stroke="#243040" stroke-width="2"/>
                <!-- Axis labels -->
                <text x="30" y="178" fill="#6b7d8f" font-size="10" text-anchor="middle">50</text>
                <text x="98" y="178" fill="#6b7d8f" font-size="10" text-anchor="middle">60</text>
                <text x="166" y="178" fill="#6b7d8f" font-size="10" text-anchor="middle">70</text>
                <text x="234" y="178" fill="#6b7d8f" font-size="10" text-anchor="middle">80</text>
                <text x="302" y="178" fill="#6b7d8f" font-size="10" text-anchor="middle">90</text>
                <text x="370" y="178" fill="#6b7d8f" font-size="10" text-anchor="middle">100</text>
                <!-- Dots (Scale: x = 30 + (val-50)/50 * 340) -->
                <!-- 54 --> <circle cx="57" cy="148" r="4.5" fill="#00d4aa"/>
                <!-- 58 --> <circle cx="84" cy="148" r="4.5" fill="#00d4aa"/>
                <!-- 62 --> <circle cx="111" cy="148" r="4.5" fill="#00d4aa"/>
                <!-- 65 (2) --> <circle cx="132" cy="148" r="4.5" fill="#00d4aa"/><circle cx="132" cy="136" r="4.5" fill="#00d4aa"/>
                <!-- 68 --> <circle cx="152" cy="148" r="4.5" fill="#00d4aa"/>
                <!-- 70 (2) --> <circle cx="166" cy="148" r="4.5" fill="#00d4aa"/><circle cx="166" cy="136" r="4.5" fill="#00d4aa"/>
                <!-- 72 (3) --> <circle cx="179" cy="148" r="4.5" fill="#00d4aa"/><circle cx="179" cy="136" r="4.5" fill="#00d4aa"/><circle cx="179" cy="124" r="4.5" fill="#00d4aa"/>
                <!-- 74 --> <circle cx="193" cy="148" r="4.5" fill="#00d4aa"/>
                <!-- 75 (2) --> <circle cx="200" cy="148" r="4.5" fill="#00d4aa"/><circle cx="200" cy="136" r="4.5" fill="#00d4aa"/>
                <!-- 78 (2) --> <circle cx="220" cy="148" r="4.5" fill="#00d4aa"/><circle cx="220" cy="136" r="4.5" fill="#00d4aa"/>
                <!-- 80 (4) --> <circle cx="234" cy="148" r="4.5" fill="#ffd166"/><circle cx="234" cy="136" r="4.5" fill="#ffd166"/><circle cx="234" cy="124" r="4.5" fill="#ffd166"/><circle cx="234" cy="112" r="4.5" fill="#ffd166"/>
                <!-- 82 (2) --> <circle cx="247" cy="148" r="4.5" fill="#00d4aa"/><circle cx="247" cy="136" r="4.5" fill="#00d4aa"/>
                <!-- 84 --> <circle cx="261" cy="148" r="4.5" fill="#00d4aa"/>
                <!-- 85 (3) --> <circle cx="268" cy="148" r="4.5" fill="#00d4aa"/><circle cx="268" cy="136" r="4.5" fill="#00d4aa"/><circle cx="268" cy="124" r="4.5" fill="#00d4aa"/>
                <!-- 88 (2) --> <circle cx="288" cy="148" r="4.5" fill="#00d4aa"/><circle cx="288" cy="136" r="4.5" fill="#00d4aa"/>
                <!-- 90 (2) --> <circle cx="302" cy="148" r="4.5" fill="#00d4aa"/><circle cx="302" cy="136" r="4.5" fill="#00d4aa"/>
                <!-- 92 (2) --> <circle cx="315" cy="148" r="4.5" fill="#00d4aa"/><circle cx="315" cy="136" r="4.5" fill="#00d4aa"/>
                <!-- 94 --> <circle cx="329" cy="148" r="4.5" fill="#00d4aa"/>
                <!-- 95 (2) --> <circle cx="336" cy="148" r="4.5" fill="#00d4aa"/><circle cx="336" cy="136" r="4.5" fill="#00d4aa"/>
                <!-- 96 --> <circle cx="343" cy="148" r="4.5" fill="#00d4aa"/>
                <!-- 98 (2) --> <circle cx="356" cy="148" r="4.5" fill="#00d4aa"/><circle cx="356" cy="136" r="4.5" fill="#00d4aa"/>
                <!-- 100 (2) --> <circle cx="370" cy="148" r="4.5" fill="#00d4aa"/><circle cx="370" cy="136" r="4.5" fill="#00d4aa"/>
              </svg>
            </div>

            <!-- Graphic 2: Histogram -->
            <div style="background: #0d141d; border: 1px solid var(--color-border); border-radius: 12px; padding: 1.25rem;">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <span style="font-weight: 700; color: #4d96ff; font-size: 0.95rem;">Histogram View (5 Bins)</span>
                <span style="font-size: 0.75rem; color: var(--color-text-muted); font-family: 'IBM Plex Mono', monospace;">Bin Width = 10</span>
              </div>
              <svg class="histogram-svg" viewBox="0 0 400 200" width="100%" height="auto" role="img" aria-label="Histogram of 40 exam scores showing binned bars from 50 to 100.">
                <rect width="400" height="200" fill="#0d141d" rx="8"/>
                <!-- Axis -->
                <line x1="30" y1="160" x2="370" y2="160" stroke="#243040" stroke-width="2"/>
                <!-- Axis labels -->
                <text x="30" y="178" fill="#6b7d8f" font-size="10" text-anchor="middle">50</text>
                <text x="98" y="178" fill="#6b7d8f" font-size="10" text-anchor="middle">60</text>
                <text x="166" y="178" fill="#6b7d8f" font-size="10" text-anchor="middle">70</text>
                <text x="234" y="178" fill="#6b7d8f" font-size="10" text-anchor="middle">80</text>
                <text x="302" y="178" fill="#6b7d8f" font-size="10" text-anchor="middle">90</text>
                <text x="370" y="178" fill="#6b7d8f" font-size="10" text-anchor="middle">100</text>
                <!-- Bars (Scale: max count 12 = height 110px, y = 160 - (count/12)*110) -->
                <!-- 50-60: count 2 (height 18px) -->
                <rect x="30" y="142" width="68" height="18" fill="rgba(77, 150, 255, 0.4)" stroke="#4d96ff" stroke-width="1.5"/>
                <text x="64" y="136" fill="#4d96ff" font-size="10" font-weight="700" text-anchor="middle">2</text>
                <!-- 60-70: count 4 (height 37px) -->
                <rect x="98" y="123" width="68" height="37" fill="rgba(77, 150, 255, 0.4)" stroke="#4d96ff" stroke-width="1.5"/>
                <text x="132" y="117" fill="#4d96ff" font-size="10" font-weight="700" text-anchor="middle">4</text>
                <!-- 70-80: count 10 (height 92px) -->
                <rect x="166" y="68" width="68" height="92" fill="rgba(77, 150, 255, 0.4)" stroke="#4d96ff" stroke-width="1.5"/>
                <text x="200" y="62" fill="#4d96ff" font-size="10" font-weight="700" text-anchor="middle">10</text>
                <!-- 80-90: count 12 (height 110px) -->
                <rect x="234" y="50" width="68" height="110" fill="rgba(77, 150, 255, 0.6)" stroke="#4d96ff" stroke-width="1.5"/>
                <text x="268" y="44" fill="#ffd166" font-size="10" font-weight="700" text-anchor="middle">12</text>
                <!-- 90-100: count 12 (height 110px) -->
                <rect x="302" y="50" width="68" height="110" fill="rgba(77, 150, 255, 0.6)" stroke="#4d96ff" stroke-width="1.5"/>
                <text x="336" y="44" fill="#ffd166" font-size="10" font-weight="700" text-anchor="middle">12</text>
              </svg>
            </div>
          </div>
        </div>

        <div style="background: var(--color-bg-card); border-left: 4px solid var(--color-primary); padding: 1.25rem 1.5rem; border-radius: 8px; margin-top: 1.5rem;">
          <p style="margin: 0; color: var(--color-text-secondary); font-size: 0.95rem; line-height: 1.7;">
            <strong>What Each View Reveals That the Other Hides:</strong> The <strong>dot plot</strong> reveals that exactly four students scored a modal 80, two students earned a perfect 100, and a noticeable gap separates 58 from 62. In contrast, the <strong>histogram</strong> conceals those exact numbers, but immediately clarifies that the upper half (80–100) contains the vast bulk of the class (24 of 40 students), delivering an instant visual summary of high overall achievement.
          </p>
        </div>
      </section>

      <!-- ══════════════════════════════════════════════════════════════
           SECTION 5: STRENGTHS & WEAKNESSES
           ══════════════════════════════════════════════════════════════ -->
      <section id="strengths-and-weaknesses" style="margin-top: 4rem;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
          
          <!-- Dot Plot Card -->
          <div style="background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 12px; padding: 2rem;">
            <h3 style="color: var(--color-primary); font-size: 1.3rem; margin-top: 0; margin-bottom: 1rem;">Dot Plot: Pros & Cons</h3>
            <div style="margin-bottom: 1.25rem;">
              <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: var(--color-primary);">Strengths</span>
              <ul style="margin-top: 0.5rem; color: var(--color-text-secondary); line-height: 1.6; padding-left: 1.25rem;">
                <li>Retains every raw data point without loss.</li>
                <li>Zero arbitrary binning or grouping decisions required.</li>
                <li>Makes ties, exact repeated values, and micro-gaps obvious.</li>
                <li>Intuitive for non-technical and middle school audiences.</li>
              </ul>
            </div>
            <div>
              <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: #ff6b6b;">Weaknesses</span>
              <ul style="margin-top: 0.5rem; color: var(--color-text-secondary); line-height: 1.6; padding-left: 1.25rem;">
                <li>Severe overplotting and clutter on datasets over 100 points.</li>
                <li>Cannot scale to large Big Data applications.</li>
                <li>Inefficient for multi-thousand point distributions.</li>
              </ul>
            </div>
          </div>

          <!-- Histogram Card -->
          <div style="background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 12px; padding: 2rem;">
            <h3 style="color: #4d96ff; font-size: 1.3rem; margin-top: 0; margin-bottom: 1rem;">Histogram: Pros & Cons</h3>
            <div style="margin-bottom: 1.25rem;">
              <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: #4d96ff;">Strengths</span>
              <ul style="margin-top: 0.5rem; color: var(--color-text-secondary); line-height: 1.6; padding-left: 1.25rem;">
                <li>Scales gracefully to tens of thousands of data points.</li>
                <li>Reveals continuous distributional shape, skew, and modality.</li>
                <li>Enables theoretical normal distribution curve fitting.</li>
                <li>Standard requirement in engineering and econometric modeling.</li>
              </ul>
            </div>
            <div>
              <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: #ff6b6b;">Weaknesses</span>
              <ul style="margin-top: 0.5rem; color: var(--color-text-secondary); line-height: 1.6; padding-left: 1.25rem;">
                <li>Individual observations and exact values are permanently lost.</li>
                <li>Different bin counts can produce misleadingly different shapes.</li>
                <li>Ineffective and fragmented on tiny sample sizes ($N &lt; 20$).</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- ══════════════════════════════════════════════════════════════
           SECTION 6: COMMON MISTAKES
           ══════════════════════════════════════════════════════════════ -->
      <section id="common-mistakes" style="margin-top: 4rem;">
        <h2 class="content-h2">3 Common Mistakes to Avoid</h2>
        <div style="display: grid; gap: 1.25rem; margin-top: 1.5rem;">
          
          <div style="background: var(--color-bg-card); border: 1px solid var(--color-border); border-left: 4px solid #ff6b6b; padding: 1.5rem; border-radius: 8px;">
            <h3 style="margin: 0 0 0.5rem; font-size: 1.15rem; color: var(--color-text-primary);">1. Using a Dot Plot for 5,000 Data Points</h3>
            <p style="margin: 0; color: var(--color-text-secondary); font-size: 0.95rem; line-height: 1.6;">
              When sample size grows past a few hundred observations, dot plots collapse into a solid, unreadable wall of ink. Dots stack off the top edge of the screen, obscuring relative frequency. For large samples, always aggregate with a histogram.
            </p>
          </div>

          <div style="background: var(--color-bg-card); border: 1px solid var(--color-border); border-left: 4px solid #ff6b6b; padding: 1.5rem; border-radius: 8px;">
            <h3 style="margin: 0 0 0.5rem; font-size: 1.15rem; color: var(--color-text-primary);">2. Building a Histogram for 12 Observations</h3>
            <p style="margin: 0; color: var(--color-text-secondary); font-size: 0.95rem; line-height: 1.6;">
              Attempting to bin a dozen points produces an erratic, spiky chart with solitary bars of height 1 separated by empty intervals. A histogram requires sufficient sample density to represent frequency intervals meaningfully. For small samples, use a dot plot or stemplot.
            </p>
          </div>

          <div style="background: var(--color-bg-card); border: 1px solid var(--color-border); border-left: 4px solid #ff6b6b; padding: 1.5rem; border-radius: 8px;">
            <h3 style="margin: 0 0 0.5rem; font-size: 1.15rem; color: var(--color-text-primary);">3. Confusing Histograms with Bar Charts</h3>
            <p style="margin: 0; color: var(--color-text-secondary); font-size: 0.95rem; line-height: 1.6;">
              While visually similar, they represent different data types. Histograms display continuous numeric variables with touching bars along an unbroken scale. Bar charts display discrete categorical variables (e.g. fruit types, departments) separated by visible gaps.
            </p>
          </div>
        </div>
      </section>

