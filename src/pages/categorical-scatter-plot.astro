---
import BaseLayout from "@theme/layouts/BaseLayout.astro";
import CategoricalScatterPlot from "@theme/components/CategoricalScatterPlot.astro";
import { defaultLocale, type Locale } from "@src/i18n/config";

const locale = (defaultLocale || "en") as Locale;

const pageTitle = "Categorical Scatter Plot Maker — Free Online Strip & Jitter Plot Generator";
const pageDescription = "Create interactive categorical scatter plots (strip plots) online with custom horizontal jitter, color-coded experimental groups, mean indicators, and SVG/PNG export — 100% free with no signup.";

const faqs = [
  {
    question: "What is a categorical scatter plot?",
    answer: "A categorical scatter plot (often termed a strip plot or categorical dot plot) is a bivariate visualization displaying discrete categorical factors along one axis and continuous numerical observations along the other. Unlike aggregate charts that compress distribution details into single summary numbers, a categorical scatter plot renders every individual data point, illuminating sample size, clustering, multimodal subgroups, and potential outliers."
  },
  {
    question: "Why is horizontal jitter added to categorical scatter plots?",
    answer: "When multiple observations within a category share identical or nearly identical numerical values, markers plot directly on top of each other — a distortion known as overplotting. Horizontal jitter introduces a controlled, pseudo-random horizontal offset to separate coincident points visually while preserving their true vertical coordinate values."
  },
  {
    question: "How does a categorical scatter plot differ from a box plot?",
    answer: "A box plot summarizes distributions using a non-parametric five-number summary (minimum, Q1, median, Q3, and maximum) and Tukey fences, which hides the exact sample size and internal distribution shape. A categorical scatter plot displays every raw observation. For small to moderate sample sizes (n < 100 per group), categorical scatter plots are often preferred because they reveal bimodality and sample size directly."
  },
  {
    question: "How does a categorical scatter plot differ from a standard dot plot?",
    answer: "A traditional univariate dot plot stacks data points in discrete vertical columns along a single continuous number line to represent frequencies (similar to a granular histogram). A categorical scatter plot displays two variables: one axis is partitioned into distinct discrete categories or experimental treatments, and points are positioned along a continuous measurement axis within each category band."
  },
  {
    question: "Can I plot multiple experimental groups across categories?",
    answer: "Yes. Our tool allows you to add multiple color-coded groups (e.g., Control vs. Treatment, Pre-test vs. Post-test, or Cohort 1 vs. Cohort 2). Each group is assigned a distinct hue from a high-contrast palette, and you can compare their spreads, group medians, and means across categories on a shared coordinate scale."
  },
  {
    question: "What data formats can I import into the maker?",
    answer: "The tool supports three input modes: (1) Manual Entry, where you specify category labels and newline-separated values; (2) Paste Mode, where you paste two-column comma-separated lines (e.g., Category, Value); and (3) CSV/TSV File Upload, which automatically parses header rows and populates multi-category datasets."
  },
  {
    question: "Can I export publication-quality vector charts?",
    answer: "Yes. You can export your chart as a clean, lossless Scalable Vector Graphic (SVG) for inclusion in academic manuscripts, LaTeX documents, and vector illustrators, or download a high-resolution PNG image for slides and web reports with a single click."
  },
  {
    question: "Is my research data stored or sent to a server?",
    answer: "No. All statistical computations (means, medians, standard deviations, ranges) and graphic renderings occur entirely client-side inside your web browser. No dataset, category name, or numerical value is ever transmitted across the network or stored on any external server."
  }
];

const structuredFaqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: f.answer,
    },
  })),
};

const softwareAppSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Categorical Scatter Plot Maker",
  applicationCategory: "WebApplication",
  operatingSystem: "Web",
  url: "https://www.dotplotmaker.com/categorical-scatter-plot/",
  description: "Free online categorical scatter plot maker. Create strip and jitter plots across discrete categories with custom point sizing, multi-group overlays, and instant SVG/PNG exports.",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  featureList: [
    "Interactive categorical strip plot rendering with HTML5 Canvas",
    "Dynamic horizontal jitter control to eliminate overplotting",
    "Multi-group overlay support with automated high-contrast color assignment",
    "Real-time descriptive statistics: sample size (N), mean, median, standard deviation, and range",
    "Toggleable category mean reference lines and coordinate grids",
    "One-click SVG vector graphic and PNG image export",
    "100% client-side execution guaranteeing privacy for sensitive research data"
  ].join("\n"),
  author: {
    "@type": "Organization",
    name: "Dot Plot Maker",
    url: "https://www.dotplotmaker.com/",
  },
};
---

<BaseLayout locale={locale} title={pageTitle} description={pageDescription} canonicalUrl="https://www.dotplotmaker.com/categorical-scatter-plot/">
  <Fragment slot="head">
    <meta name="keywords" content="categorical scatter plot, strip plot maker, jitter plot online, categorical dot plot, scatter plot categorical x axis, strip chart generator, beeswarm plot" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredFaqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(softwareAppSchema)} />
  </Fragment>

  <div class="page-content" style="padding: 2rem 1rem; max-width: 1200px; margin: 0 auto; min-height: 80vh;">
    
    <!-- Hero / Header -->
    <header class="cs-hero" style="text-align: center; margin-bottom: 2.5rem; margin-top: 1.5rem;">
      <span class="badge" style="margin-bottom: 1rem;">Free Online Visualization Tool</span>
      <h1 class="cs-hero-title">
        Categorical Scatter Plot Maker
      </h1>
      <p class="cs-hero-subtitle">
        Visualize numerical distributions across discrete categories with precision. Compare experimental groups, fine-tune horizontal jitter to resolve point collisions, toggle group mean lines, and export publication-ready SVG or PNG figures — 100% free with zero signup.
      </p>
      <div class="cs-hero-quicklinks">
        <a href="#tool-container" class="btn-primary" style="padding: 0.75rem 1.75rem; text-decoration: none;"><span>Open Generator</span></a>
        <a href="#worked-example" class="btn-secondary" style="padding: 0.75rem 1.75rem; text-decoration: none;"><span>Worked Example</span></a>
        <a href="#comparison-guide" class="btn-secondary" style="padding: 0.75rem 1.75rem; text-decoration: none;"><span>Strip Plot vs Box Plot</span></a>
      </div>
    </header>

    <!-- Embedded Interactive Tool -->
    <div id="tool-container" class="cs-tool-container" style="background: var(--color-bg-card); border: 1px solid var(--color-border); border-radius: 16px; overflow: hidden; margin-bottom: 4rem; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.35);">
      <CategoricalScatterPlot locale={locale} />
    </div>

    <!-- How-To Guide / Workflow -->
    <section class="cs-section" id="how-to-create">
      <div class="section-header">
        <span class="cs-kicker">Interactive Workflow</span>
        <h2 class="section-title">How to Create a Categorical Scatter Plot in 4 Steps</h2>
        <p class="section-subtitle">
          Follow this quick workflow to convert raw group observations into publication-quality strip charts.
        </p>
      </div>

      <div class="cs-steps-grid">
        <div class="cs-step-card">
          <div class="cs-step-badge">1</div>
          <div class="cs-step-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
          </div>
          <h3>Select Input Method</h3>
          <p>Choose <strong>Manual</strong> to enter comma-separated categories and row-separated values, <strong>Paste</strong> to import two-column rows (Category, Value), or <strong>CSV</strong> to drag and drop spreadsheet files.</p>
        </div>

        <div class="cs-step-card">
          <div class="cs-step-badge">2</div>
          <div class="cs-step-icon accent">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </div>
          <h3>Add Groups & Conditions</h3>
          <p>Assign group identifiers (such as <em>Experiment 1</em>, <em>Pre-test</em>, or <em>Cohort B</em>). Click <strong>Add Group</strong> to overlay multiple experimental conditions with coordinated palette colors.</p>
        </div>

        <div class="cs-step-card">
          <div class="cs-step-badge">3</div>
          <div class="cs-step-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="12" r="3"/><circle cx="12" cy="8" r="3"/><circle cx="18" cy="14" r="3"/></svg>
          </div>
          <h3>Calibrate Jitter & Appearance</h3>
          <p>Adjust the <strong>Jitter Amount</strong> slider between 0 (strictly collinear) and 1 (maximum horizontal spread). Tune dot diameter, transparency, category mean dashed bars, and background gridlines.</p>
        </div>

        <div class="cs-step-card">
          <div class="cs-step-badge">4</div>
          <div class="cs-step-icon accent">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          </div>
          <h3>Inspect Stats & Export</h3>
          <p>Review the automated Category Summary table (sample size $N$, mean, median, standard deviation, and range). Export clean vector <strong>SVG</strong> for papers or <strong>PNG</strong> for slides.</p>
        </div>
      </div>
    </section>

    <!-- SECTION A: WHAT IS A CATEGORICAL SCATTER PLOT -->
    <section class="cs-section" id="what-is-it">
      <div class="cs-prose-card">
        <span class="cs-kicker">Core Statistical Concepts</span>
        <h2 class="cs-card-heading">What is a Categorical Scatter Plot?</h2>
        
        <p>
          A <strong>categorical scatter plot</strong> is a bivariate data visualization that maps one qualitative categorical variable (plotted along the horizontal X-axis) against one continuous quantitative variable (plotted along the vertical Y-axis). While standard Cartesian scatter plots correlate two continuous numerical metrics (such as height versus weight), a categorical scatter plot partitions observations into discrete factor levels—such as drug dosage regimens, classroom instructional models, machine operating temperatures, or geographic territories.
        </p>

        <p>
          In modern statistical practice and scientific literature, categorical scatter plots are prized because they <strong>preserve every single raw data point</strong>. Unlike summary graphics such as bar charts with standard error flags (often criticized in open science initiatives as "dynamite plots") or box plots, a categorical scatter plot never collapses observations into synthetic aggregates. Viewers can directly observe the exact sample size ($n$), inspect localized clustering, evaluate variance homogeneity across groups, and spot solitary outliers without relying on opaque statistical assumptions.
        </p>

        <div class="cs-callout cs-callout-info">
          <div class="cs-callout-title">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            Key Principle: Continuous Data Requires Granular Inspection
          </div>
          <p>
            When two experimental groups yield identical sample means (e.g., mean = 50.0) and equal standard deviations (s = 10.0), a conventional bar chart renders identical columns. Yet one group might be normally distributed while the other is distinctly bimodal or contains a rogue outlier balancing a tight cluster. Categorical scatter plots expose these critical distributional nuances immediately. Learn more about single-variable distributions in our educational guide on <a href="/blog/what-is-a-dot-plot/" class="cs-link">what is a dot plot</a>.
          </p>
        </div>

        <h3 class="cs-subheading">Overcoming Overplotting with Controlled Jitter</h3>
        <p>
          The primary visualization challenge with discrete categorical axes is <strong>overplotting</strong>: when multiple participants or sensors register identical or tightly clustered values within the same category, their plotted circles overlap directly on top of each other. A column of ten coincident points appears indistinguishable from a solitary point, severely misleading the reader regarding data density.
        </p>
        <p>
          To eliminate this visual artifact, categorical scatter plots utilize <strong>jittering</strong>—the addition of small, pseudo-random horizontal displacements within each category's vertical band. The vertical Y-coordinate remains 100% mathematically faithful to the measured observation, while the horizontal X-offset provides visual separation so every dot remains distinctly legible.
        </p>
      </div>
    </section>

    <!-- SECTION C & D: COMPARISONS (STRIP / JITTER / BEESWARM / BOX PLOT) -->
    <section class="cs-section" id="comparison-guide">
      <div class="section-header">
        <span class="cs-kicker">Comparative Data Visualization</span>
        <h2 class="section-title">Nomenclature & Software Terminology</h2>
        <p class="section-subtitle">
          Different statistical ecosystems use varying names for categorical scatter plots. Understanding these distinctions clarifies software documentation and academic guidelines.
        </p>
      </div>

      <div class="cs-grid-3">
        <div class="cs-info-card">
          <div class="cs-card-tag">Python & R Ecosystems</div>
          <h3>Strip Plot (Stripplot)</h3>
          <p>
            In Python's <strong>Seaborn</strong> library (<code>sns.stripplot</code>) and R base graphics, this chart is termed a <em>strip plot</em>. By default, points align along a central vertical axis; setting <code>jitter=True</code> introduces random horizontal dispersion to resolve point collisions.
          </p>
        </div>

        <div class="cs-info-card">
          <div class="cs-card-tag">ggplot2 & Data Science</div>
          <h3>Jitter Plot (geom_jitter)</h3>
          <p>
            In R's <strong>ggplot2</strong> package, calling <code>geom_jitter(width=0.2)</code> creates a categorical jitter plot. The user controls the exact horizontal width boundary, ensuring points never bleed into adjacent category lanes.
          </p>
        </div>

        <div class="cs-info-card">
          <div class="cs-card-tag">Bioinformatics & GraphPad</div>
          <h3>Beeswarm Plot / Swarmplot</h3>
          <p>
            Unlike pseudo-random jitter, a <em>beeswarm plot</em> (<code>sns.swarmplot</code> or R's <code>ggbeeswarm</code>) uses a deterministic packing algorithm that shifts points horizontally just enough to prevent overlap, producing symmetrical, organic violin-like clusters.
          </p>
        </div>
      </div>

      <!-- Comparison Matrix: Categorical Scatter Plot vs Box Plot vs Histogram -->
      <div class="cs-prose-card" style="margin-top: 2rem;">
        <h3 class="cs-subheading" style="margin-top: 0;">Categorical Scatter Plot vs. Box Plot vs. Histogram</h3>
        <p>
          Selecting the appropriate statistical graphic depends on your sample size ($n$), the number of comparison groups, and whether your analytical objective is communicating high-level summary statistics or exposing raw data topologies.
        </p>

        <div class="cs-table-wrapper">
          <table class="cs-comparison-table">
            <thead>
              <tr>
                <th>Feature / Dimension</th>
                <th>Categorical Scatter Plot</th>
                <th>Box & Whisker Plot</th>
                <th>Histogram / Frequency Plot</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Primary Data Type</strong></td>
                <td>1 Categorical X + 1 Continuous Y</td>
                <td>1 Continuous Y (optional Cat X)</td>
                <td>1 Continuous variable partitioned into bins</td>
              </tr>
              <tr>
                <td><strong>Individual Data Points</strong></td>
                <td><span class="cs-tag-yes">Visible (Every Point)</span></td>
                <td><span class="cs-tag-no">Hidden (Except Outliers)</span></td>
                <td><span class="cs-tag-no">Aggregated into Bins</span></td>
              </tr>
              <tr>
                <td><strong>Best Sample Size Range</strong></td>
                <td>Small to Moderate ($n = 5$ to $150$ per group)</td>
                <td>Moderate to Large ($n > 20$ to $10,000+$)</td>
                <td>Moderate to Massive ($n > 50$ to millions)</td>
              </tr>
              <tr>
                <td><strong>Shows Multimodality & Gaps?</strong></td>
                <td><span class="cs-tag-yes">Yes — Direct Visual Clusters</span></td>
                <td><span class="cs-tag-no">No — Masks Bimodal Distributions</span></td>
                <td><span class="cs-tag-yes">Yes — Dual Peaks in Bin Frequencies</span></td>
              </tr>
              <tr>
                <td><strong>Outlier Representation</strong></td>
                <td>Direct observation in scale context</td>
                <td>Mathematical Tukey fences (1.5 × IQR)</td>
                <td>Isolated peripheral low-frequency bins</td>
              </tr>
              <tr>
                <td><strong>Ideal Companion Tool</strong></td>
                <td><a href="/box-plot-maker/" class="cs-link">Box Plot Maker</a> (for hybrid plots)</td>
                <td><a href="/blog/dot-plot-vs-histogram/" class="cs-link">Dot Plot vs Histogram Guide</a></td>
                <td><a href="/histogram-maker/" class="cs-link">Free Histogram Maker</a></td>
              </tr>
            </tbody>
          </table>
        </div>

        <h4 style="font-size: 1.15rem; color: var(--color-text-primary); margin-top: 1.75rem; margin-bottom: 0.5rem;">When to Combine Strip Plots with Box Plots</h4>
        <p>
          In biomedical and behavioral research, leading journals (such as <em>Nature</em> and <em>PLOS Biology</em>) strongly discourage lone bar charts and recommend <strong>overlaying jittered categorical scatter plots on top of semi-transparent box plots</strong>. This hybrid presentation delivers the best of both worlds: the box and whisker geometry communicates the formal non-parametric five-number summary (median, first and third quartiles, whiskers), while the jittered scatter overlay provides total transparency regarding raw sample distribution and individual observation density.
        </p>
      </div>
    </section>

    <!-- SECTION E: WORKED REAL-WORLD EXAMPLE WITH NUMERICAL CALCULATIONS -->
    <section class="cs-section" id="worked-example">
      <div class="cs-prose-card">
        <span class="cs-kicker">Empirical Case Study</span>
        <h2 class="cs-card-heading">Worked Real-World Example: University STEM Exam Performance</h2>
        
        <p>
          To understand how a categorical scatter plot uncovers instructional insights that summary statistics conceal, let us examine an empirical dataset tracking exam scores across three pedagogical modalities in an introductory statistics course (N = 36 students total, n = 12 per instructional group):
        </p>

        <div class="cs-grid-3" style="margin: 1.5rem 0;">
          <div class="cs-data-box">
            <div class="cs-data-header" style="color: #00d4aa;">Group 1: Traditional Lecture (n = 12)</div>
            <div class="cs-data-values">61, 64, 68, 70, 72, 73, 75, 76, 78, 80, 83, 87</div>
            <div class="cs-data-stats">
              <span>Mean (x̄₁): <strong>73.08</strong></span>
              <span>Median (x̃₁): <strong>74.00</strong></span>
              <span>Std Dev (s₁): <strong>7.49</strong></span>
              <span>Range: <strong>61 – 87 (26 pts)</strong></span>
            </div>
          </div>

          <div class="cs-data-box">
            <div class="cs-data-header" style="color: #38bdf8;">Group 2: Flipped Classroom (n = 12)</div>
            <div class="cs-data-values">72, 75, 78, 81, 82, 84, 85, 87, 88, 90, 93, 97</div>
            <div class="cs-data-stats">
              <span>Mean (x̄₂): <strong>84.33</strong></span>
              <span>Median (x̃₂): <strong>84.50</strong></span>
              <span>Std Dev (s₂): <strong>7.01</strong></span>
              <span>Range: <strong>72 – 97 (25 pts)</strong></span>
            </div>
          </div>

          <div class="cs-data-box">
            <div class="cs-data-header" style="color: #ffd93d;">Group 3: Inquiry-Based Learning (n = 12)</div>
            <div class="cs-data-values">58, 62, 63, 65, 88, 89, 91, 93, 94, 96, 98, 99</div>
            <div class="cs-data-stats">
              <span>Mean (x̄₃): <strong>83.00</strong></span>
              <span>Median (x̃₃): <strong>89.50</strong></span>
              <span>Std Dev (s₃): <strong>16.42</strong></span>
              <span>Range: <strong>58 – 99 (41 pts)</strong></span>
            </div>
          </div>
        </div>

        <h3 class="cs-subheading">Step-by-Step Statistical Computation & Analysis</h3>
        
        <div class="cs-calc-step">
          <h4>1. Comparing Central Tendency: Mean vs. Median Divergence</h4>
          <p>
            Notice the relationship between the sample mean and median across the cohorts:
          </p>
          <ul>
            <li><strong>Lecture:</strong> Mean x̄₁ = 73.08, Median x̃₁ = 74.00. The mean and median sit within one point of each other, indicating a reasonably symmetrical, unimodal bell-shaped distribution centered in the low 70s.</li>
            <li><strong>Flipped Classroom:</strong> Mean x̄₂ = 84.33, Median x̃₂ = 84.50. Again, mean and median closely coincide, indicating consistent, uniformly shifted academic gains of approximately +11 points over traditional lecture.</li>
            <li><strong>Inquiry-Based Learning:</strong> Mean x̄₃ = 83.00, but Median x̃₃ = 89.50. The mean lags the median by <strong>6.50 points</strong>!</li>
          </ul>
        </div>

        <div class="cs-calc-step">
          <h4>2. Uncovering the Bimodal Phenomenon in Inquiry Learning</h4>
          <p>
            If an evaluator inspected only the group means (Flipped = 84.33 vs. Inquiry = 83.00), they would conclude both progressive pedagogies yielded virtually indistinguishable academic outcomes (difference of only 1.33 points).
          </p>
          <p>
            However, plotting this dataset in a <strong>categorical scatter plot</strong> reveals a striking reality: Group 3 is distinctly <strong>bimodal</strong>. Two-thirds of the inquiry class (8 students) excelled remarkably, scoring between 88 and 99. But a vulnerable subgroup of four students severely struggled, scoring between 58 and 65, pulling the overall mean down significantly. The standard deviation (s₃ = 16.42) is more than double that of the other two cohorts.
          </p>
          <p>
            A simple bar chart completely conceals this bifurcated dynamic. The categorical scatter plot makes it visually undeniable, alerting instructors that while inquiry learning elevates motivated students, it requires structured scaffolding to prevent struggling learners from falling behind. Learn how to interpret clustered distributions in our step-by-step tutorial on <a href="/blog/how-to-read-dot-plots/" class="cs-link">how to read dot plots</a>.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION F: INTERPRETATION GUIDE -->
    <section class="cs-section" id="interpretation-guide">
      <div class="section-header">
        <span class="cs-kicker">Analytical Framework</span>
        <h2 class="section-title">How to Interpret a Categorical Scatter Plot</h2>
        <p class="section-subtitle">
          Follow these structured criteria to extract valid, rigorous statistical inferences from categorical scatter charts.
        </p>
      </div>

      <div class="cs-grid-2">
        <div class="cs-feature-card">
          <div class="cs-feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          </div>
          <h3>1. Assessing Location & Group Shifts</h3>
          <p>
            Observe the vertical elevation of each category's point cluster and mean line. Are dots shifted uniformly upward or downward relative to control baselines? Wide vertical separation between cluster centers with minimal vertical overlap suggests meaningful differences in treatment efficacy.
          </p>
        </div>

        <div class="cs-feature-card">
          <div class="cs-feature-icon accent">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h20M12 2v20M4.93 4.93l14.14 14.14M4.93 19.07l14.14-14.14"/></svg>
          </div>
          <h3>2. Evaluating Within-Group Dispersion</h3>
          <p>
            Examine the vertical span (range and vertical density) within each category. Does one condition exhibit a tight, compact band of observations while an adjacent group spans widely from top to bottom? Marked differences in spread signal heteroscedasticity (unequal variances).
          </p>
        </div>

        <div class="cs-feature-card">
          <div class="cs-feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 12h8"/></svg>
          </div>
          <h3>3. Detecting Gaps, Clumping & Outliers</h3>
          <p>
            Look for vertical voids within a category column. A gap separating two dense sub-clusters indicates distinct subpopulations (bimodality or multimodality). Solitary data points floating far above or below the primary pack highlight potential measurement anomalies or exceptional performers.
          </p>
        </div>

        <div class="cs-feature-card">
          <div class="cs-feature-icon accent">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </div>
          <h3>4. Visual Differences vs. Formal Significance</h3>
          <p>
            <strong>Caution:</strong> Apparent visual shifts in small samples ($n \le 15$) can occur purely due to random sampling variability. Always corroborate visual patterns with formal inferential statistics (such as two-sample Student's $t$-tests, Mann-Whitney $U$ tests, or One-Way ANOVA with post-hoc Tukey tests).
          </p>
        </div>
