---
import BaseLayout from "@theme/layouts/BaseLayout.astro";
import WorksheetGenerator from "@theme/components/WorksheetGenerator.astro";
import { defaultLocale } from "@src/i18n/config";

const locale = defaultLocale;

const title = "Box Plot Worksheet Generator (Free + Answer Key)";
const description = "Free printable box plot worksheets with answer keys. Generate unlimited practice sets — or check your quartiles with our interactive tool.";

const faqs = [
  {
    q: "Are these box plot worksheets free to print and copy for students?",
    a: "Yes. All box plot worksheets generated on this platform are 100% free with no registration or email gate required for student printouts. You can generate unlimited custom assignments anytime."
  },
  {
    q: "What topics and standards do these box plot worksheets cover?",
    a: "Our generator spans Grade 6 five-number summaries and box-and-whisker construction (CCSS.MATH.CONTENT.6.SP.B.4), Grades 7–8 parallel comparative box plots (CCSS 7.SP.A.3), and High School / AP Statistics modified box plots with Tukey 1.5×IQR outlier fences (CCSS HSS-ID.A.1–3)."
  },
  {
    q: "Do the answer keys draw the full box and whisker plots?",
    a: "Yes! When you reveal the answer key, every question includes the correctly rendered box plot diagram showing the Minimum, Q1 box boundary, Median line, Q3 box boundary, whiskers, and isolated outlier points alongside exact numerical values."
  },
  {
    q: "Can I regenerate the exact same box plot worksheet using the seed?",
    a: "Yes. Every handout includes a 6-digit seed number. If you save that seed and enter it into the 'Worksheet Seed #' box on this page, the generator will reproduce the identical problems, numbers, and answers."
  },
  {
    q: "How do I save the worksheet as a PDF file?",
    a: "Click 'Print / Save as PDF'. In your browser's print preview, choose 'Save as PDF'. Our print stylesheet automatically eliminates screen navigation, web banners, and ads, formatting the worksheet cleanly for US Letter and A4 paper."
  },
  {
    q: "Can students test their five-number summary calculations online?",
    a: "Yes! Students can enter their worksheet numbers into our free online Box Plot Maker to see live interactive box plots, compare Tukey vs extreme fences, and verify their quartiles in real time."
  }
];

const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": title,
      "description": description,
      "image": "https://www.dotplotmaker.com/og-image.png",
      "datePublished": "2026-10-12T00:00:00.000Z",
      "author": {
        "@type": "Person",
        "name": "Dot Plot Maker® Team"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Dot Plot Maker®",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.dotplotmaker.com/favicon.svg"
        }
      },
      "mainEntityOfPage": "https://www.dotplotmaker.com/worksheets/box-plot-worksheet/"
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(item => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<BaseLayout locale={locale} title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaData)} slot="head" />

  <div class="page-content">
    <!-- Breadcrumb & Back Link -->
    <div style="margin-bottom: 1.5rem;">
      <a href="/worksheets/" class="nav-link" style="font-size: 0.9rem; color: var(--color-primary); display: inline-flex; align-items: center; gap: 0.4rem;">
        ← Back to All Statistics Worksheets
      </a>
    </div>

    <!-- Page Hero -->
    <header class="page-header animate-fade-in-up" style="opacity: 0; margin-bottom: 2.5rem;">
      <span class="badge" style="margin-bottom: 0.5rem;">Printable Generator</span>
      <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 0.75rem; background: linear-gradient(135deg, var(--color-text-primary), var(--color-primary)); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
        Box Plot Worksheet Generator
      </h1>
      <p style="max-width: 720px; color: var(--color-text-secondary); font-size: 1.15rem; line-height: 1.6;">
        Create unlimited free <strong>box plot worksheets</strong> (also called <strong>box and whisker plot worksheets</strong>) with live-computed answer keys. Master the five-number summary, quartiles, interquartile range (IQR), and Tukey's 1.5×IQR outlier fences.
      </p>
    </header>

    <!-- Generator Component (Above the fold) -->
    <WorksheetGenerator
      topic="box-plot"
      title="Generate Box & Whisker Plot Practice Handouts"
      toolUrl="/box-plot-maker/"
      toolName="Box Plot Maker"
    />

    <!-- Mid-Page Ad Unit -->
    <div class="ad-unit" aria-label="Advertisement" style="margin: 3.5rem auto; text-align: center;">
      <span class="ad-label" style="font-size: 0.75rem; color: var(--color-text-muted); text-transform: uppercase;">Advertisement</span>
      <div class="ad-box" style="background: rgba(255, 255, 255, 0.02); border: 1px dashed var(--color-border); border-radius: 12px; padding: 1.25rem; margin-top: 0.5rem;">
        <span style="font-size: 0.85rem; color: var(--color-text-muted);">Interactive Statistical Learning Tools</span>
      </div>
    </div>

    <!-- Static SEO Content (Renders without JS) -->
    <div class="static-seo-content prose" style="max-width: 860px; margin: 3rem auto 0;">
      <h2>What This Box Plot Worksheet Covers</h2>
      <p>
        Box plots summarize quantitative data distributions using five critical reference points known as the five-number summary. Our generator adapts calculation depth across educational levels:
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin: 2rem 0;">
        <div class="glass-card" style="padding: 1.5rem; border-radius: 12px;">
          <h3 style="font-size: 1.15rem; margin-top: 0; color: #8b5cf6;">Five-Number Summary</h3>
          <p style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 0.5rem;">
            Aligns with <strong>CCSS.MATH.CONTENT.6.SP.B.4</strong>. Students order numerical datasets to identify the Minimum, First Quartile (Q1 / 25th percentile), Median (Q2 / 50th percentile), Third Quartile (Q3 / 75th percentile), and Maximum.
          </p>
        </div>

        <div class="glass-card" style="padding: 1.5rem; border-radius: 12px;">
          <h3 style="font-size: 1.15rem; margin-top: 0; color: var(--color-primary);">Interquartile Range (IQR) &amp; Spread</h3>
          <p style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 0.5rem;">
            Aligns with <strong>CCSS.MATH.CONTENT.HSS-ID.A.2</strong>. Students calculate the IQR (<code>IQR = Q3 - Q1</code>), representing the spread of the middle 50% of the data, and compare variability between groups.
          </p>
        </div>

        <div class="glass-card" style="padding: 1.5rem; border-radius: 12px;">
          <h3 style="font-size: 1.15rem; margin-top: 0; color: #10b981;">Tukey 1.5×IQR Fences &amp; Outliers</h3>
          <p style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 0.5rem;">
            Aligns with <strong>CCSS.MATH.CONTENT.HSS-ID.A.3</strong> and AP Statistics Unit 1. Students calculate the lower fence (<code>Q1 - 1.5 × IQR</code>) and upper fence (<code>Q3 + 1.5 × IQR</code>) to identify mild and extreme outliers.
          </p>
        </div>
      </div>

      <p>
        Need a comprehensive walkthrough of Tukey's outlier fences? Read our complete <a href="/blog/outlier-dot-plot-maker/">how to find outliers guide</a> for worked formulas and step-by-step spreadsheet rules.
      </p>

      <h2>Example Question &amp; Worked Solution</h2>
      <p>
        Here is a sample problem demonstrating the complete five-number summary calculation and modified box plot construction:
      </p>

      <div class="glass-card" style="padding: 1.75rem; border-radius: 14px; margin: 1.5rem 0; border: 1px solid var(--color-border);">
        <h4 style="font-size: 1.05rem; font-weight: 700; margin-top: 0; color: var(--color-text-primary);">
          Problem Context: Daily Commute Times (Minutes) for 12 Commuters
        </h4>
        <div style="background: rgba(255, 255, 255, 0.05); padding: 0.75rem 1rem; border-radius: 8px; font-family: var(--font-mono); font-size: 0.95rem; margin: 0.75rem 0;">
          Raw Data: 12, 15, 18, 20, 22, 25, 28, 30, 32, 35, 38, 62
        </div>
        <p style="font-size: 0.92rem; line-height: 1.6; margin-bottom: 1rem;">
          <strong>Student Task:</strong> Find the five-number summary, calculate the IQR, determine the 1.5×IQR outlier fences, and construct the modified box plot.
        </p>

        <div style="border-top: 1px dashed var(--color-border); padding-top: 1rem;">
          <h5 style="color: var(--color-primary); margin: 0 0 0.5rem; font-size: 0.95rem; text-transform: uppercase;">Worked Solution:</h5>
          <ul style="font-size: 0.9rem; line-height: 1.7; margin: 0; padding-left: 1.2rem;">
            <li><strong>Sorted Data (N = 12):</strong> 12, 15, 18, 20, 22, 25, 28, 30, 32, 35, 38, 62</li>
            <li><strong>Minimum:</strong> 12 minutes</li>
            <li><strong>Q1 (Lower Half Median: 12, 15, 18, 20, 22, 25):</strong> (18 + 20) / 2 = <strong>19 minutes</strong></li>
            <li><strong>Median (Q2: Middle of 12 numbers):</strong> (25 + 28) / 2 = <strong>26.5 minutes</strong></li>
            <li><strong>Q3 (Upper Half Median: 28, 30, 32, 35, 38, 62):</strong> (32 + 35) / 2 = <strong>33.5 minutes</strong></li>
            <li><strong>Maximum:</strong> 62 minutes</li>
            <li><strong>Interquartile Range:</strong> IQR = 33.5 - 19 = <strong>14.5 minutes</strong></li>
            <li><strong>Lower Fence:</strong> 19 - 1.5(14.5) = 19 - 21.75 = <strong>-2.75 minutes</strong></li>
            <li><strong>Upper Fence:</strong> 33.5 + 1.5(14.5) = 33.5 + 21.75 = <strong>55.25 minutes</strong></li>
            <li><strong>Outlier Identification:</strong> 62 falls above the upper fence (55.25), so <strong>62 is an outlier</strong>. The upper whisker terminates at 38 (the highest non-outlier value), with 62 plotted as an isolated dot.</li>
          </ul>
        </div>
      </div>

      <!-- Check Your Work CTA Card -->
      <h2>Check Your Work Interactively</h2>
      <div class="glass-card" style="padding: 1.75rem; border: 1px solid var(--color-primary); border-radius: 16px; margin: 2rem 0; background: rgba(0, 212, 170, 0.04); display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 260px;">
          <span class="badge" style="margin-bottom: 0.5rem;">Interactive Tool</span>
          <h3 style="margin: 0.25rem 0 0.5rem; font-size: 1.3rem; color: var(--color-text-primary); font-weight: 800;">
            Verify Your Plots in Our Free Box Plot Maker
          </h3>
          <p style="margin: 0; color: var(--color-text-secondary); font-size: 0.92rem; line-height: 1.5;">
            Paste your numbers straight from the worksheet to verify your five-number summary, check outlier toggles, and view dynamic horizontal or vertical box plots.
          </p>
        </div>
        <div>
          <a href="/box-plot-maker/" class="btn-primary" style="white-space: nowrap;">
            <span>Open Box Plot Maker →</span>
          </a>
        </div>
      </div>

      <!-- FAQ Section -->
      <h2>Frequently Asked Questions</h2>
      <div style="display: flex; flex-direction: column; gap: 1rem; margin-top: 1.5rem;">
        {faqs.map(item => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <div class="faq-answer">{item.a}</div>
          </details>
        ))}
      </div>
    </div>

    <!-- Bottom Display Ad -->
    <div class="ad-unit" aria-label="Advertisement" style="margin-top: 4rem; text-align: center;">
      <span class="ad-label" style="font-size: 0.75rem; color: var(--color-text-muted); text-transform: uppercase;">Advertisement</span>
      <div class="ad-box" style="background: rgba(255, 255, 255, 0.02); border: 1px dashed var(--color-border); border-radius: 12px; padding: 1.25rem; margin-top: 0.5rem;">
        <span style="font-size: 0.85rem; color: var(--color-text-muted);">Publication-Grade Statistical Visualizations</span>
      </div>
    </div>
  </div>
</BaseLayout>
