---
import BaseLayout from "@theme/layouts/BaseLayout.astro";
import AdvancedDotPlotTool from "@theme/components/AdvancedDotPlotTool.astro";
import HowItWorks from "@theme/components/HowItWorks.astro";
import ChartSection from "@theme/components/ChartSection.astro";
import FAQ from "@theme/components/FAQ.astro";
import InteractiveIllustrations from "@theme/components/InteractiveIllustrations.astro";
import HomepageSchema from "@theme/components/HomepageSchema.astro";
import { defaultLocale } from "@src/i18n/config";
import { t } from "@src/i18n/utils";

const locale = defaultLocale;
---

<BaseLayout locale={locale} title={t(locale, "home.title")} description={t(locale, "home.description")}>
  <HomepageSchema locale={locale} slot="head" />

  <div class="page-content">
    <!-- Hero -->
    <div class="hero animate-fade-in-up" style="opacity: 0;">
      <span class="badge">{t(locale, "home.badge")}</span>
      <h1 class="hero-title">{t(locale, "home.h1")}</h1>
      <p class="hero-subtitle">{t(locale, "home.heroSubtitle")}</p>
      <div class="hero-cta">
        <a href="#pro-dot-plot-tool" class="btn-primary"><span>Create Dot Plot Below</span></a>
        <a href="#tool-catalog" class="btn-secondary"><span>Browse All 6 Tools</span></a>
        <a href="/worksheets/" class="btn-secondary" style="border-color: rgba(139, 92, 246, 0.4);"><span>Free Classroom Worksheets →</span></a>
      </div>
    </div>

    <!-- Interactive Univariate Dot Plot Tool Component -->
    <section class="tool-section">
      <div class="tool-section-header">
        <div class="tool-section-title-row">
          <div class="tool-section-icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="6" cy="18" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="12" cy="18" r="3"></circle>
              <circle cx="18" cy="18" r="3"></circle>
              <circle cx="18" cy="12" r="3"></circle>
              <circle cx="18" cy="6" r="3"></circle>
            </svg>
          </div>
          <h2 class="tool-section-title">Instant Univariate Dot Plot Maker</h2>
        </div>
        <p class="tool-section-subtitle">
          Type or paste numbers to plot individual observations along a continuous scale with stacked frequencies and automated summary metrics.
        </p>
      </div>

      <AdvancedDotPlotTool locale={locale} />
    </section>

    <!-- ══════════════════════════════════════════════════════════════
         TOOL SELECTOR & SUITE DIRECTORY
         ══════════════════════════════════════════════════════════════ -->
    <section class="suite-directory-section section" id="tool-catalog">
      <div style="text-align: center; max-width: 800px; margin: 0 auto 3rem;">
        <span class="hub-kicker">Interactive Visualization Hub</span>
        <h2 class="section-title">Choose the Right Visualization Tool for Your Data</h2>
        <p class="section-subtitle">
          Different statistical datasets require distinct visualization geometries. Use our interactive suite directory to find the optimal tool for your project.
        </p>
      </div>

      <div class="suite-grid">
        <!-- 1. Professional Dot Plot Tool -->
        <article class="suite-card">
          <div class="suite-card-badge">Multivariate & Spreadsheet</div>
          <div class="suite-card-icon" style="background: rgba(0, 212, 170, 0.12); color: var(--color-primary);">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
          </div>
          <h3>Cleveland & Multi-Series Dot Plot</h3>
          <p>Import CSV/XLSX workbooks with a built-in spreadsheet editor. Map categorical labels to the Y-axis and continuous variables to the X-axis with parallel series points and connector range lines.</p>
          <ul class="suite-features">
            <li>Excel (.xlsx) and CSV drag-and-drop</li>
            <li>Row vs. Column data binding</li>
            <li>ECharts engine with vector SVG export</li>
          </ul>
          <a href="/professional-dot-plot-tool/" class="suite-link">Open Cleveland Studio →</a>
        </article>

        <!-- 2. Categorical Scatter Plot -->
        <article class="suite-card">
          <div class="suite-card-badge">Bivariate Jitter</div>
          <div class="suite-card-icon" style="background: rgba(139, 92, 246, 0.12); color: var(--color-accent);">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="12" r="3"/><circle cx="12" cy="8" r="3"/><circle cx="18" cy="14" r="3"/><line x1="2" y1="20" x2="22" y2="20"/></svg>
          </div>
          <h3>Categorical Scatter Plot (Strip Plot)</h3>
          <p>Plot individual observations across discrete categorical experimental groups with adjustable horizontal jitter, group colorization, mean dashed reference lines, and automated ANOVA-ready metrics.</p>
          <ul class="suite-features">
            <li>Controlled jitter eliminates overplotting</li>
            <li>Multi-group treatment comparisons</li>
            <li>Reveals bimodal clustering and sample sizes</li>
          </ul>
          <a href="/categorical-scatter-plot/" class="suite-link">Open Strip Plot Maker →</a>
        </article>

        <!-- 3. Box Plot Maker -->
        <article class="suite-card">
          <div class="suite-card-badge">Distribution Summary</div>
          <div class="suite-card-icon" style="background: rgba(56, 189, 248, 0.12); color: #38bdf8;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="12" rx="2"></rect><line x1="12" y1="6" x2="12" y2="18"></line><line x1="8" y1="6" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="18"></line></svg>
          </div>
          <h3>Box Plot Maker (Box & Whisker)</h3>
          <p>Generate five-number summaries (min, Q1, median, Q3, max) with automated Tukey 1.5×IQR outlier fences. Compare dozens of groups side-by-side with Excel copy-paste compatibility.</p>
          <ul class="suite-features">
            <li>Type 7 quantile interpolation (matches Excel & R)</li>
            <li>Confidence notches and mean diamond markers</li>
            <li>Automated outlier isolation</li>
          </ul>
          <a href="/box-plot-maker/" class="suite-link">Open Box Plot Maker →</a>
        </article>

        <!-- 4. Histogram Maker -->
        <article class="suite-card">
          <div class="suite-card-badge">Continuous Binned Density</div>
          <div class="suite-card-icon" style="background: rgba(245, 158, 11, 0.12); color: #f59e0b;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="10" width="4" height="10" rx="1"></rect><rect x="10" y="4" width="4" height="16" rx="1"></rect><rect x="17" y="13" width="4" height="7" rx="1"></rect></svg>
          </div>
          <h3>Histogram Maker</h3>
          <p>Partition moderate to large continuous datasets into customizable frequency bins. Select automated binning algorithms (Freedman-Diaconis or Sturges) and overlay normal distribution curves.</p>
          <ul class="suite-features">
            <li>Ideal for large sample sizes (N > 100)</li>
            <li>Custom bin widths and boundary controls</li>
            <li>Cumulative frequency & normal curve overlay</li>
          </ul>
          <a href="/histogram-maker/" class="suite-link">Open Histogram Maker →</a>
        </article>

        <!-- 5. Stem-and-Leaf Plot Maker -->
        <article class="suite-card">
          <div class="suite-card-badge">Numerical Digits</div>
          <div class="suite-card-icon" style="background: rgba(16, 185, 129, 0.12); color: #10b981;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="2" x2="8" y2="22"></line><line x1="2" y1="7" x2="22" y2="7"></line><line x1="2" y1="12" x2="22" y2="12"></line><line x1="2" y1="17" x2="22" y2="17"></line></svg>
          </div>
          <h3>Stem-and-Leaf Plot Maker</h3>
          <p>Display raw numerical data where each observation is divided into a leading 'stem' and a trailing 'leaf'. Preserve exact digits while demonstrating frequency distribution shapes.</p>
          <ul class="suite-features">
            <li>Back-to-back comparison mode</li>
            <li>Configurable stem multiplier scale</li>
            <li>Classroom printable formatting</li>
          </ul>
          <a href="/stem-and-leaf-plot-maker/" class="suite-link">Open Stem-and-Leaf Maker →</a>
        </article>

        <!-- 6. Printable Worksheets & Answer Keys -->
        <article class="suite-card">
          <div class="suite-card-badge">Classroom & Teacher Resources</div>
          <div class="suite-card-icon" style="background: rgba(239, 68, 68, 0.12); color: #ef4444;">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="9" y1="15" x2="15" y2="15"></line></svg>
          </div>
          <h3>Printable Practice Worksheets</h3>
          <p>Generate customizable practice exercises with un-gated full answer keys for dot plots, box plots, histograms, and stem-and-leaf displays designed for Grade 6-12 and AP Statistics classrooms.</p>
          <ul class="suite-features">
            <li>100% free with instant answer key toggle</li>
            <li>Printer-friendly black-and-white layouts</li>
            <li>Randomized dataset generation</li>
          </ul>
          <a href="/worksheets/" class="suite-link">Browse Worksheets Hub →</a>
        </article>
      </div>
    </section>

    <!-- ══════════════════════════════════════════════════════════════
         DECISION MATRIX: HOW TO SELECT THE RIGHT TOOL
         ══════════════════════════════════════════════════════════════ -->
    <section class="section" id="chart-selection-guide">
      <div class="matrix-card">
        <h2 class="section-title" style="text-align: center; margin-bottom: 0.75rem;">Chart Selection Guide: How to Pick the Right Tool</h2>
        <p class="section-subtitle" style="text-align: center; margin-bottom: 2.5rem;">
          Match your dataset characteristics and analytical goals to the correct statistical visualizer:
        </p>

        <div class="matrix-table-wrap">
          <table class="matrix-table">
            <thead>
              <tr>
                <th>Your Data & Scenario</th>
                <th>Recommended Chart</th>
                <th>Why It Fits Best</th>
                <th>Direct Link</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>1 Numerical Variable, Small to Medium Sample (N &le; 100)</strong></td>
                <td>Univariate Dot Plot</td>
                <td>Shows every single observation as a stacked dot along a continuous scale; calculates mean and median without binning artifacts.</td>
                <td><a href="#pro-dot-plot-tool" class="matrix-link">Use Tool Above</a></td>
              </tr>
              <tr>
                <td><strong>Categorical Labels vs. Multiple Numerical Metrics / Years</strong></td>
                <td>Cleveland Dot Plot</td>
                <td>Horizontal layout accommodates long category labels without rotation; compares parallel series with connector range lines.</td>
                <td><a href="/professional-dot-plot-tool/" class="matrix-link">Cleveland Studio</a></td>
              </tr>
              <tr>
                <td><strong>Discrete Treatment Groups vs. Continuous Measurements (n &le; 150/group)</strong></td>
                <td>Categorical Scatter (Strip Plot)</td>
                <td>Controlled horizontal jitter prevents point collisions; exposes bimodal subgroups and outliers without data reduction.</td>
                <td><a href="/categorical-scatter-plot/" class="matrix-link">Strip Plot Maker</a></td>
              </tr>
              <tr>
                <td><strong>Comparing Distributions Across 3+ Groups or Spotting Outliers</strong></td>
                <td>Box & Whisker Plot</td>
                <td>Five-number summary (Q1, median, Q3, whiskers) and Tukey 1.5×IQR fences compactly compare spreads without clutter.</td>
                <td><a href="/box-plot-maker/" class="matrix-link">Box Plot Maker</a></td>
              </tr>
              <tr>
                <td><strong>Large Continuous Datasets (N > 100 to Thousands)</strong></td>
                <td>Frequency Histogram</td>
                <td>Aggregates continuous observations into bins; reveals overall modality, skewness, and normal distribution fit.</td>
                <td><a href="/histogram-maker/" class="matrix-link">Histogram Maker</a></td>
              </tr>
              <tr>
                <td><strong>Introductory Statistics & Keeping Exact Number Digits</strong></td>
                <td>Stem-and-Leaf Display</td>
                <td>Splits values into stems and leaves, preserving original data digits while visualizing distribution shape.</td>
                <td><a href="/stem-and-leaf-plot-maker/" class="matrix-link">Stem-and-Leaf Maker</a></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Visual Showcase Component -->
    <InteractiveIllustrations />

    <!-- How It Works (Univariate workflow) -->
    <HowItWorks locale={locale} />

    <!-- Chart Info Section (When to use & Bar Chart comparison) -->
    <ChartSection locale={locale} />

    <!-- ══════════════════════════════════════════════════════════════
         TOPICAL AUTHORITY & EDUCATIONAL CONTEXT
         ══════════════════════════════════════════════════════════════ -->

    <!-- 1. The Value of Raw Observation Visualizations -->
    <section class="topical-section">
      <div class="topical-container">
        <h2 class="section-title">The Value of Visualizing Individual Observations</h2>
        <p class="topical-intro">
          Standard summary graphics like bar charts frequently conceal critical distribution features. Dot plots preserve raw data transparency, ensuring every recorded measurement contributes visibly to the narrative.
        </p>
        <div class="topical-grid">
          <div class="topical-card topical-card-accent">
            <h3>Preventing Summary Illusions</h3>
            <p>Two groups can share the exact same mean and standard deviation while having completely different distribution shapes—one bell-shaped and the other split into two distinct clusters. Dot plots expose these realities instantly.</p>
          </div>
          <div class="topical-card topical-card-purple">
            <h3>Unmistakable Outlier Detection</h3>
            <p>Unlike summary bars that silently absorb extreme numbers into a skewed mean, dot plots position outliers visibly along the scale, making measurement errors or genuine anomalies immediate to spot.</p>
          </div>
          <div class="topical-card topical-card-orange">
            <h3>Sample Size Transparency</h3>
            <p>A bar chart looks identical whether it was constructed from 5 observations or 5,000. Dot plots convey sample size directly through point density, ensuring viewers grasp statistical confidence intuitively.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. How to Interpret a Dot Plot -->
    <section class="topical-section">
      <div class="topical-container">
        <h2 class="section-title">How to Interpret a Dot Plot</h2>
        <p class="topical-intro">Reading a dot plot is like reading a landscape — the features tell a story about your data. Here are the four key features to look for.</p>
        <div class="topical-grid topical-grid-4">
          <div class="topical-card topical-card-accent">
            <div class="topical-card-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="7" cy="12" r="3"/><circle cx="7" cy="6" r="3"/><circle cx="17" cy="12" r="3"/></svg>
            </div>
            <h3>Clusters</h3>
            <p>Tightly packed groups of dots indicate values that occur frequently. A cluster shows where the "typical" value lives in your dataset. Multiple clusters suggest distinct subgroups — for example, two age groups in a survey.</p>
          </div>
          <div class="topical-card topical-card-purple">
            <div class="topical-card-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="12" r="3"/><circle cx="18" cy="12" r="3"/><line x1="9" y1="12" x2="15" y2="12" stroke-dasharray="2,2"/></svg>
            </div>
            <h3>Gaps</h3>
            <p>Empty spaces between dots are just as informative as clusters. A gap means no data falls in that range — which can reveal natural breaks, missing categories, or a true absence of values in that region.</p>
          </div>
          <div class="topical-card topical-card-orange">
            <div class="topical-card-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="6" cy="18" r="3"/><circle cx="9" cy="14" r="3"/><circle cx="12" cy="10" r="3"/><circle cx="16" cy="8" r="3"/><circle cx="21" cy="6" r="3"/></svg>
            </div>
            <h3>Skewness</h3>
            <p>When dots trail off to one side, the distribution is skewed. Right skew (common in salary data) means a few high values pull the mean above the median. Left skew means a few low values pull it below. The longer tail tells you which direction.</p>
          </div>
          <div class="topical-card topical-card-red">
            <div class="topical-card-icon">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="8" cy="12" r="3"/><circle cx="12" cy="12" r="3"/><circle cx="16" cy="12" r="3"/><circle cx="22" cy="4" r="3" stroke="#ff6b6b"/><circle cx="2" cy="4" r="3" stroke="#ff6b6b"/></svg>
            </div>
            <h3>Outliers</h3>
            <p>Dots far from the main cluster are outliers — values that stand apart from the rest. They may represent errors (a typo entering 1000 instead of 10) or genuine extremes (a record-breaking score). Dot plots make outliers impossible to miss because every point is visible.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 3. When to Use a Dot Plot (and When Not To) -->
    <section class="topical-section">
      <div class="topical-container">
        <h2 class="section-title">When to Use a Dot Plot (and When Not To)</h2>
        <p class="topical-intro">Dot plots are powerful but not universal. Knowing their strengths and limits helps you choose the right chart for every dataset.</p>
        <div class="topical-two-col">
          <div class="topical-col topical-col-good">
            <h3>Best Use Cases</h3>
            <ul class="topical-list">
              <li><strong>Small to medium datasets</strong> (under ~100 points) where individual values matter</li>
              <li><strong>Exploratory data analysis</strong> — first look at a new dataset before formal testing</li>
              <li><strong>Teaching statistics</strong> — students see each data point and its frequency</li>
              <li><strong>Discrete data</strong> — whole numbers, categories, or countable values</li>
              <li><strong>Identifying outliers</strong> — no chart type makes outliers more obvious</li>
              <li><strong>Comparing frequency</strong> — stacked dots let you count occurrences at each value</li>
            </ul>
          </div>
          <div class="topical-col topical-col-limit">
            <h3>Limitations & Better Alternatives</h3>
            <ul class="topical-list">
              <li><strong>Large datasets (N > 200)</strong> — dots blur into indistinguishable stacks; <a href="/histogram-maker/">use a frequency histogram</a> instead</li>
              <li><strong>Multi-group continuous comparisons</strong> — points overlap heavily; <a href="/categorical-scatter-plot/">use a categorical scatter plot with jitter</a></li>
              <li><strong>High-dimensional summary needs</strong> — comparing 5+ groups across quartiles; <a href="/box-plot-maker/">use side-by-side box plots</a></li>
              <li><strong>Multivariate spreadsheet data</strong> — plotting categories against metrics over years; <a href="/professional-dot-plot-tool/">use the Cleveland Dot Plot Studio</a></li>
            </ul>
            <div class="topical-rule">
              <strong>Rule of thumb:</strong> If you can count the dots without losing track, a dot plot is the right choice. If dots overlap into a solid block, switch to a <a href="/histogram-maker/">histogram</a> or <a href="/box-plot-maker/">box plot</a>.
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Educational Articles & Blog Hub -->
    <section class="topical-section" style="border-top: 1px solid var(--color-border); padding-top: 3.5rem;">
      <div class="topical-container">
        <div style="text-align: center; margin-bottom: 2.5rem;">
          <span class="hub-kicker">Curated Educational Guides</span>
          <h2 class="section-title">Learn Data Visualization Fundamentals</h2>
          <p class="section-subtitle">Deepen your statistical intuition with our in-depth guides and comparisons.</p>
        </div>

        <div class="topical-grid topical-grid-3">
          <div class="topical-card">
            <h3>What is a Dot Plot?</h3>
            <p>A comprehensive introduction to univariate dot plots, history, number line scaling, and stacking mechanics.</p>
            <p style="margin-top: 1rem;"><a href="/blog/what-is-a-dot-plot/">Read Guide →</a></p>
          </div>
          <div class="topical-card">
            <h3>How to Read Dot Plots</h3>
            <p>Step-by-step framework for diagnosing skewness, multimodal clusters, outliers, and variance in dot charts.</p>
            <p style="margin-top: 1rem;"><a href="/blog/how-to-read-dot-plots/">Read Tutorial →</a></p>
          </div>
          <div class="topical-card">
            <h3>Dot Plot vs. Histogram</h3>
            <p>Detailed architectural comparison showing when to use discrete dots vs. binned continuous intervals.</p>
            <p style="margin-top: 1rem;"><a href="/blog/dot-plot-vs-histogram/">Compare Charts →</a></p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <FAQ locale={locale} />

    <!-- Final CTA -->
    <div class="final-cta">
      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; flex-direction: column; align-items: center;">
        <h2 style="font-size: 1.8rem; font-weight: 800; color: var(--color-text-primary); margin-bottom: 0.5rem;">Ready to Visualize Your Data?</h2>
        <p style="color: var(--color-text-secondary); max-width: 600px; margin: 0 auto 1.5rem;">Create publication-grade graphics in seconds without account registration or software downloads.</p>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center;">
          <a href="#pro-dot-plot-tool" class="btn-primary cta-btn"><span>Use Free Dot Plot Maker</span></a>
          <a href="/professional-dot-plot-tool/" class="btn-secondary" style="padding: 1rem 2rem; border-radius: 8px;"><span>Open Cleveland Dot Plot Studio</span></a>
        </div>
      </div>
    </div>

  </div>
</BaseLayout>

<style>
  /* ── Tool Section Wrapper ── */
  .tool-section {
    max-width: 1280px;
    margin: 0.5rem auto 4rem;
    padding: 0 1rem;
  }
  .tool-section-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }
  .tool-section-title-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .tool-section-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: linear-gradient(135deg, rgba(0, 212, 170, 0.15), rgba(139, 92, 246, 0.15));
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .tool-section-title {
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    background: linear-gradient(135deg, var(--color-text-primary) 20%, var(--color-primary) 60%, var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin: 0;
  }
  .tool-section-subtitle {
    color: var(--color-text-secondary);
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 600px;
    margin: 0 auto 1.25rem;
  }
  .tool-section :global(.dotplot-wrapper) {
    border-radius: 20px;
    margin: 0;
    box-shadow:
      0 0 0 1px rgba(0, 212, 170, 0.1),
      0 4px 24px rgba(0, 0, 0, 0.12),
      0 24px 80px -12px rgba(0, 212, 170, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .hero {
    text-align: center;
    padding: 2.5rem 0 1rem;
  }
  .hero-title {
    font-size: 3rem;
    font-weight: 900;
    line-height: 1.15;
    margin: 1rem 0;
    background: linear-gradient(135deg, var(--color-text-primary) 30%, var(--color-primary) 70%, var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
  }
  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--color-text-secondary);
    max-width: 760px;
    margin: 0.75rem auto 0;
    line-height: 1.7;
