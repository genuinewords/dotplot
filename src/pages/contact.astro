---
import BaseLayout from "@theme/layouts/BaseLayout.astro";
import ContactForm from "@theme/components/ContactForm.astro";
import { defaultLocale } from "@src/i18n/config";

const locale = defaultLocale;
---

<BaseLayout
  locale={locale}
  title="Contact Us - Dot Plot Maker®"
  description="Get in touch with the Dot Plot Maker® team for questions, feedback, bug reports, and educational inquiries."
  pageType="contact"
>
  <div class="page-content">
    <div class="page-header animate-fade-in-up" style="opacity: 0;">
      <div class="badge" style="margin-bottom: 0.75rem;">Get in Touch</div>
      <h1>Contact Us</h1>
      <p>Have a question about our statistics tools, found a bug, or need help with a classroom worksheet? We'd love to hear from you.</p>
    </div>

    <ContactForm locale={locale} />
  </div>
</BaseLayout>
